{
  "ConnectionStrings":    {
    "DefaultConnection": "DataSource=Data\\app.db;Cache=Shared"
  },
  "Logging":              {
    "LogFile":  {
      "Path":               "/var/log/aaru-server/aaru-server.log",
      "RollingInterval":    "Day",
      "FileSizeLimitBytes": 10485760,
      "MaxRetainedFiles":   7,
      "RetainedDays":       30
    },
    "LogLevel": {
      "Default":              "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts":         "*",
  "DocumentationFolders": {
    "Stable": "Aaru.Documentation"
  }
}
