@page "/admin/usb/vendors/{id:int}"
@attribute [Authorize]
@layout AdminLayout
@rendermode InteractiveServer

@inject Microsoft.EntityFrameworkCore.IDbContextFactory<DbContext> DbContextFactory

<PageTitle>USB Vendor Details</PageTitle>

@if(!_initialized)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
        <div class="text-center">
            <div class="spinner-border text-info" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <h3 class="mt-3 text-light">Loading USB vendor...</h3>
        </div>
    </div>

    return;
}

<div class="container-fluid px-4 py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1 text-light">
                <i class="bi bi-building text-info"></i> USB Vendor Details
            </h1>
            <p class="text-secondary mb-0">
                <span class="badge bg-info text-dark me-2"
                      style="min-width: 60px; display: inline-block;">ID: @Id</span>
                @if(_model?.Vendor != null)
                {
                    <strong class="text-light">@_model.Vendor</strong>
                }
            </p>
        </div>
        <div>
            <a href="/admin/usb/vendors" class="btn btn-secondary">
                <i class="bi bi-arrow-left-circle"></i> Back to List
            </a>
        </div>
    </div>

    <!-- Vendor Information Card -->
    <div class="card bg-dark shadow-sm border-secondary mb-4">
        <div class="card-header bg-info text-dark">
            <h5 class="mb-0">
                <i class="bi bi-info-circle"></i> Vendor Information
            </h5>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-lg-6">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-secondary">
                            <i class="bi bi-building"></i> Vendor Name
                        </dt>
                        <dd class="col-sm-8 text-light">
                            <strong>@(_model?.Vendor ?? "Unknown")</strong>
                        </dd>

                        <dt class="col-sm-4 text-secondary">
                            <i class="bi bi-hash"></i> Vendor ID
                        </dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-secondary text-light"
                                  style="min-width: 120px; display: inline-block;">@_model?.VendorId</span>
                        </dd>
                    </dl>
                </div>
                <div class="col-lg-6">
                    <dl class="row mb-0">
                        <dt class="col-sm-5 text-secondary">
                            <i class="bi bi-box-seam"></i> Total Products
                        </dt>
                        <dd class="col-sm-7">
                            <span class="badge bg-primary fs-6">@_products.Count</span>
                            <span class="text-secondary small ms-2">registered products</span>
                        </dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <!-- Products Table Card -->
    <div class="card bg-dark shadow-sm border-secondary">
        <div class="card-header bg-secondary text-light">
            <h5 class="mb-0">
                <i class="bi bi-box-seam"></i> Products by this Vendor
                <span class="badge bg-info text-dark float-end">@_products.Count</span>
            </h5>
        </div>
        <div class="card-body p-0">
            @if(_products.Any())
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover table-striped mb-0">
                        <thead class="table-secondary">
                        <tr>
                            <th style="width: 150px;">
                                <i class="bi bi-hash"></i> Product ID
                            </th>
                            <th>
                                <i class="bi bi-tag"></i> Product Name
                            </th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach(UsbProductModel item in _products)
                        {
                            <tr>
                                <td class="align-middle">
                                    <span class="badge bg-secondary text-light text-center"
                                          style="min-width: 120px; display: inline-block;">@item.ProductId</span>
                                </td>
                                <td class="align-middle">
                                    <strong class="text-light">@item.ProductName</strong>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox text-secondary" style="font-size: 3rem;"></i>
                    <h5 class="text-secondary mt-3">No Products Found</h5>
                    <p class="text-secondary">This vendor has no registered products in the database.</p>
                </div>
            }
        </div>
    </div>
</div>

