@page "/admin/usb/devices"
@attribute [Authorize]
@layout AdminLayout
@rendermode InteractiveServer

@inject Microsoft.EntityFrameworkCore.IDbContextFactory<DbContext> DbContextFactory

<PageTitle>USB Devices</PageTitle>

@if(!_initialized)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
        <div class="text-center">
            <div class="spinner-border text-info" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <h3 class="mt-3 text-light">Loading USB devices...</h3>
        </div>
    </div>

    return;
}

<div class="container-fluid px-4 py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1 text-light">
                <i class="bi bi-usb-symbol text-info"></i> USB Devices
            </h1>
            <p class="text-secondary mb-0">Manage USB device identification registers</p>
        </div>
    </div>

    <!-- Search and Filter Bar -->
    <div class="card bg-dark shadow-sm mb-4 border-secondary">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-10">
                    <div class="input-group">
                        <span class="input-group-text bg-secondary text-light border-secondary">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               class="form-control bg-dark text-light border-secondary"
                               placeholder="Search by manufacturer, product, vendor ID, or product ID..."
                               @bind="_searchTerm"
                               @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-md-2 text-end">
                    <span class="badge bg-info text-dark fs-6 py-2 px-3 w-100">
                        <i class="bi bi-database"></i> Total: @FilteredItems.Count() / @_items.Count
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Duplicates Warning -->
    @if(_duplicates.Count > 0)
    {
        <div class="alert alert-warning bg-dark border-warning text-light alert-dismissible fade show shadow-sm mb-4"
             role="alert">
            <div class="d-flex align-items-start">
                <i class="bi bi-exclamation-triangle-fill text-warning fs-4 me-3"></i>
                <div class="flex-grow-1">
                    <h5 class="alert-heading mb-2 text-warning">Duplicate USB Devices Detected</h5>
                    <p class="mb-2 text-light">Found <strong class="text-warning">@_duplicates.Count</strong> duplicate
                                               USB device entries:</p>
                    <div class="table-responsive mb-3">
                        <table class="table table-dark table-sm table-bordered mb-0">
                            <thead>
                            <tr>
                                <th><i class="bi bi-building"></i> Manufacturer</th>
                                <th><i class="bi bi-tag"></i> Product</th>
                                <th><i class="bi bi-hash"></i> Vendor ID</th>
                                <th><i class="bi bi-hash"></i> Product ID</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach(UsbModel item in _duplicates)
                            {
                                <tr>
                                    <td class="text-light">@item.Manufacturer</td>
                                    <td class="text-light">@item.Product</td>
                                    <td><code class="text-info">@item.VendorID</code></td>
                                    <td><code class="text-info">@item.ProductID</code></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                    <button type="button"
                            class="btn btn-warning text-dark btn-sm"
                            @onclick="ConsolidateDuplicatesAsync">
                        <i class="bi bi-diagram-3"></i> Consolidate Duplicates
                    </button>
                </div>
            </div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Data Table -->
    <div class="card bg-dark shadow-sm border-secondary">
        <div class="card-header bg-info text-dark">
            <h5 class="mb-0">
                <i class="bi bi-list-ul"></i> USB Device Registers
            </h5>
        </div>
        <div class="card-body p-0">
            @if(FilteredItems.Any())
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover table-striped mb-0">
                        <thead class="table-secondary">
                        <tr>
                            <th style="width: 80px;">
                                <i class="bi bi-hash"></i> ID
                            </th>
                            <th>
                                <i class="bi bi-building"></i> Manufacturer
                            </th>
                            <th>
                                <i class="bi bi-tag"></i> Product
                            </th>
                            <th style="width: 120px;">
                                <i class="bi bi-hash"></i> Vendor ID
                            </th>
                            <th style="width: 120px;">
                                <i class="bi bi-hash"></i> Product ID
                            </th>
                            <th style="width: 120px;" class="text-center">
                                <i class="bi bi-eject"></i> Removable
                            </th>
                            <th style="width: 220px;" class="text-center">
                                <i class="bi bi-gear"></i> Actions
                            </th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach(Usb item in FilteredItems)
                        {
                            <tr>
                                <td class="align-middle">
                                    <span class="badge bg-info text-dark text-center"
                                          style="min-width: 60px; display: inline-block;">@item.Id</span>
                                </td>
                                <td class="align-middle">
                                    <strong class="text-light">@item.Manufacturer</strong>
                                </td>
                                <td class="align-middle">
                                    <strong class="text-light">@item.Product</strong>
                                </td>
                                <td class="align-middle">
                                    <code class="text-info">@item.VendorID</code>
                                </td>
                                <td class="align-middle">
                                    <code class="text-info">@item.ProductID</code>
                                </td>
                                <td class="align-middle text-center">
                                    @if(item.RemovableMedia)
                                    {
                                        <i class="bi bi-check-circle-fill text-success" title="Yes"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle-fill text-danger" title="No"></i>
                                    }
                                </td>
                                <td class="align-middle text-center">
                                    <a href="/admin/usb/devices/@item.Id"
                                       class="btn btn-outline-info btn-sm me-1"
                                       title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <button type="button" class="btn btn-outline-danger btn-sm"
                                            @onclick="async () => await ShowDeleteModal(item.Id)"
                                            title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox text-secondary" style="font-size: 4rem;"></i>
                    <h4 class="text-secondary mt-3">No USB devices found</h4>
                    <p class="text-secondary">@(string.IsNullOrWhiteSpace(_searchTerm) ? "No data available" : "Try adjusting your search criteria")</p>
                </div>
            }
        </div>
    </div>
</div>

<BlazorBootstrap.Modal @ref="_consolidateModal"
                       Title="Consolidate Duplicates"
                       Size="ModalSize.Small"
                       IsVerticallyCentered="true">
    <BodyTemplate>
        <div class="text-warning bg-dark p-3 rounded border border-warning">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            Are you sure you want to delete the duplicate USB device entries?
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <button type="button" class="btn btn-secondary" @onclick="HideConsolidateModalAsync">
            <i class="bi bi-x-circle"></i> Cancel
        </button>
        <button type="button" class="btn btn-danger" @onclick="ConfirmConsolidateAsync">
            <i class="bi bi-trash"></i> Delete Duplicates
        </button>
    </FooterTemplate>
</BlazorBootstrap.Modal>

<BlazorBootstrap.Modal @ref="_deleteModal" Title="Delete USB Device" Size="ModalSize.Small" IsVerticallyCentered="true">
    <BodyTemplate>
        <div class="text-danger bg-dark p-3 rounded border border-danger">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            Are you sure you want to delete this USB device?
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <button type="button" class="btn btn-secondary" @onclick="HideDeleteModal">
            <i class="bi bi-x-circle"></i> Cancel
        </button>
        <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">
            <i class="bi bi-trash"></i> Delete
        </button>
    </FooterTemplate>
</BlazorBootstrap.Modal>

