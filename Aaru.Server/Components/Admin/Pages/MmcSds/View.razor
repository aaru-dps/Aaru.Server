@page "/admin/mmc-sd"
@attribute [Authorize]
@layout AdminLayout
@rendermode InteractiveServer

@inject Microsoft.EntityFrameworkCore.IDbContextFactory<DbContext> DbContextFactory

<PageTitle>MMC / SD Registers</PageTitle>

@if(!_initialized)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
        <div class="text-center">
            <div class="spinner-border text-info" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <h3 class="mt-3 text-light">Loading MMC/SD registers...</h3>
        </div>
    </div>

    return;
}

<div class="container-fluid px-4 py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1 text-light">
                <i class="bi bi-sd-card text-info"></i> MMC / SD Registers
            </h1>
            <p class="text-secondary mb-0">Manage MultiMediaCard and SecureDigital register database</p>
        </div>
    </div>

    <!-- Search and Filter Bar -->
    <div class="card bg-dark shadow-sm mb-4 border-secondary">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-secondary text-light border-secondary">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               class="form-control bg-dark text-light border-secondary"
                               placeholder="Search by ID..."
                               @bind="_searchTerm"
                               @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-md-6 text-end">
                    <span class="badge bg-info text-dark fs-6 py-2 px-3">
                        <i class="bi bi-database"></i> Total: @FilteredItems.Count() / @_items.Count
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Table -->
    <div class="card bg-dark shadow-sm border-secondary">
        <div class="card-header bg-info text-dark">
            <h5 class="mb-0">
                <i class="bi bi-list-ul"></i> MMC / SD Register Database
            </h5>
        </div>
        <div class="card-body p-0">
            @if(FilteredItems.Any())
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover table-striped mb-0">
                        <thead class="table-secondary">
                        <tr>
                            <th style="width: 150px;">
                                <i class="bi bi-hash"></i> ID
                            </th>
                            <th style="width: 220px;" class="text-center">
                                <i class="bi bi-gear"></i> Actions
                            </th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach(MmcSd item in FilteredItems)
                        {
                            <tr>
                                <td class="align-middle">
                                    <span class="badge bg-info text-dark text-center"
                                          style="min-width: 100px; display: inline-block;">@item.Id</span>
                                </td>
                                <td class="align-middle text-center">
                                    <a href="/admin/mmc-sd/@item.Id"
                                       class="btn btn-outline-info btn-sm me-1"
                                       target="_blank"
                                       title="View Details">
                                        <i class="bi bi-eye"></i> Details
                                    </a>
                                    <button type="button" class="btn btn-outline-danger btn-sm"
                                            @onclick="async () => await ShowDeleteModal(item.Id)"
                                            title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox text-secondary" style="font-size: 4rem;"></i>
                    <h4 class="text-secondary mt-3">No MMC/SD registers found</h4>
                    <p class="text-secondary">@(string.IsNullOrWhiteSpace(_searchTerm) ? "No data available" : "Try adjusting your search criteria")</p>
                </div>
            }
        </div>
    </div>
</div>

<BlazorBootstrap.Modal @ref="_deleteModal"
                       Title="Delete MMC / SD Register"
                       Size="ModalSize.Small"
                       IsVerticallyCentered="true">
    <BodyTemplate>
        <div class="text-danger bg-dark p-3 rounded border border-danger">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            Are you sure you want to delete this MMC/SD register?
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <button type="button" class="btn btn-secondary" @onclick="HideDeleteModal">
            <i class="bi bi-x-circle"></i> Cancel
        </button>
        <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">
            <i class="bi bi-trash"></i> Delete
        </button>
    </FooterTemplate>
</BlazorBootstrap.Modal>

