@page "/admin/mmc-sd/{id:int}"
@using Aaru.Decoders.SecureDigital
@attribute [Authorize]
@layout AdminLayout
@rendermode InteractiveServer

@inject Microsoft.EntityFrameworkCore.IDbContextFactory<DbContext> DbContextFactory

<PageTitle>MMC/SD Register Details</PageTitle>

@if(!_initialized)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
        <div class="text-center">
            <div class="spinner-border text-info" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <h3 class="mt-3 text-light">Loading MMC/SD register details...</h3>
        </div>
    </div>

    return;
}

<div class="container-fluid px-4 py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1 text-light">
                <i class="bi bi-sd-card text-info"></i> MMC/SD Register Details
            </h1>
            <p class="text-secondary mb-0">
                <span class="badge bg-info text-dark me-2"
                      style="min-width: 60px; display: inline-block;">ID: @Id</span>
                @if(_model?.SCR != null)
                {
                    <span class="text-light">SecureDigital Card Registers</span>
                }
                else
                {
                    <span class="text-light">MultiMediaCard Registers</span>
                }
            </p>
        </div>
        <div>
            <a href="/admin/mmc-sd" class="btn btn-secondary">
                <i class="bi bi-arrow-left-circle"></i> Back to List
            </a>
        </div>
    </div>

    @if(_model == null)
    {
    <!-- Not Found Alert -->
        <div class="alert alert-danger bg-dark border-danger text-light shadow-sm" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-3 me-3"></i>
                <div>
                    <h5 class="alert-heading mb-1 text-danger">Register Not Found</h5>
                    <p class="mb-0">The requested MMC/SD register could not be found in the database.</p>
                </div>
            </div>
        </div>
    }
    else
    {
        @if(_model.SCR != null)
        {
    <!-- SecureDigital Card Registers -->

    <!-- CID Card -->

        @if(_model.CID != null)
        {
            <div class="card bg-dark shadow-sm border-secondary mb-4">
                <div class="card-header bg-info text-dark">
                    <h5 class="mb-0">
                        <i class="bi bi-credit-card"></i> CID - Card Identification
                    </h5>
                </div>
                <div class="card-body">
                    <div class="bg-black p-4 rounded border border-secondary"
                         style="font-family: 'Courier New', monospace; font-size: 0.9rem; overflow-x: auto;">
                        <SpectreMarkup Content="@Decoders.PrettifyCID(_model.CID)" />
                    </div>
                </div>
            </div>
        }

    <!-- CSD Card -->

        @if(_model.CSD != null)
        {
            <div class="card bg-dark shadow-sm border-secondary mb-4">
                <div class="card-header bg-success text-dark">
                    <h5 class="mb-0">
                        <i class="bi bi-file-earmark-code"></i> CSD - Card-Specific Data
                    </h5>
                </div>
                <div class="card-body">
                    <div class="bg-black p-4 rounded border border-secondary"
                         style="font-family: 'Courier New', monospace; font-size: 0.9rem; overflow-x: auto;">
                        <SpectreMarkup Content="@Decoders.PrettifyCSD(_model.CSD)" />
                    </div>
                </div>
            </div>
        }

    <!-- OCR Card -->

        @if(_model.OCR != null)
        {
            <div class="card bg-dark shadow-sm border-secondary mb-4">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">
                        <i class="bi bi-battery-charging"></i> OCR - Operation Conditions Register
                    </h5>
                </div>
                <div class="card-body">
                    <div class="bg-black p-4 rounded border border-secondary"
                         style="font-family: 'Courier New', monospace; font-size: 0.9rem; overflow-x: auto;">
                        <SpectreMarkup Content="@Decoders.PrettifyOCR(_model.OCR)" />
                    </div>
                </div>
            </div>
        }

    <!-- SCR Card -->
        <div class="card bg-dark shadow-sm border-secondary mb-4">
            <div class="card-header bg-primary text-light">
                <h5 class="mb-0">
                    <i class="bi bi-gear-wide-connected"></i> SCR - SD Configuration Register
                </h5>
            </div>
            <div class="card-body">
                <div class="bg-black p-4 rounded border border-secondary"
                     style="font-family: 'Courier New', monospace; font-size: 0.9rem; overflow-x: auto;">
                    <SpectreMarkup Content="@Decoders.PrettifySCR(_model.SCR)" />
                </div>
            </div>
        </div>

    <!-- Info Card -->
        <div class="card bg-dark shadow-sm border-secondary">
            <div class="card-header bg-secondary text-light">
                <h6 class="mb-0">
                    <i class="bi bi-info-circle"></i> About SecureDigital Registers
                </h6>
            </div>
            <div class="card-body">
                <p class="text-light mb-2"><strong>SecureDigital Card Register Information</strong></p>
                <p class="text-secondary small mb-0">
                    This SecureDigital (SD) card contains CID (Card Identification), CSD (Card-Specific Data),
                    OCR (Operation Conditions Register), and SCR (SD Configuration Register) data. These registers
                    provide detailed information about the card's capabilities, specifications, and operating
                    conditions.
                </p>
            </div>
        </div>
        }
        else
        {
    <!-- MultiMediaCard Registers -->

    <!-- CID Card -->

        @if(_model.CID != null)
        {
            <div class="card bg-dark shadow-sm border-secondary mb-4">
                <div class="card-header bg-info text-dark">
                    <h5 class="mb-0">
                        <i class="bi bi-credit-card"></i> CID - Card Identification
                    </h5>
                </div>
                <div class="card-body">
                    <div class="bg-black p-4 rounded border border-secondary"
                         style="font-family: 'Courier New', monospace; font-size: 0.9rem; overflow-x: auto;">
                        <SpectreMarkup Content="@Aaru.Decoders.MMC.Decoders.PrettifyCID(_model.CID)" />
                    </div>
                </div>
            </div>
        }

    <!-- CSD Card -->

        @if(_model.CSD != null)
        {
            <div class="card bg-dark shadow-sm border-secondary mb-4">
                <div class="card-header bg-success text-dark">
                    <h5 class="mb-0">
                        <i class="bi bi-file-earmark-code"></i> CSD - Card-Specific Data
                    </h5>
                </div>
                <div class="card-body">
                    <div class="bg-black p-4 rounded border border-secondary"
                         style="font-family: 'Courier New', monospace; font-size: 0.9rem; overflow-x: auto;">
                        <SpectreMarkup Content="@Aaru.Decoders.MMC.Decoders.PrettifyCSD(_model.CSD)" />
                    </div>
                </div>
            </div>
        }

    <!-- OCR Card -->

        @if(_model.OCR != null)
        {
            <div class="card bg-dark shadow-sm border-secondary mb-4">
                <div class="card-header bg-warning text-dark">
                    <h5 class="mb-0">
                        <i class="bi bi-battery-charging"></i> OCR - Operation Conditions Register
                    </h5>
                </div>
                <div class="card-body">
                    <div class="bg-black p-4 rounded border border-secondary"
                         style="font-family: 'Courier New', monospace; font-size: 0.9rem; overflow-x: auto;">
                        <SpectreMarkup Content="@Aaru.Decoders.MMC.Decoders.PrettifyOCR(_model.OCR)" />
                    </div>
                </div>
            </div>
        }

    <!-- Extended CSD Card -->

        @if(_model.ExtendedCSD != null)
        {
            <div class="card bg-dark shadow-sm border-secondary mb-4">
                <div class="card-header bg-primary text-light">
                    <h5 class="mb-0">
                        <i class="bi bi-file-earmark-plus"></i> Extended CSD - Extended Card-Specific Data
                    </h5>
                </div>
                <div class="card-body">
                    <div class="bg-black p-4 rounded border border-secondary"
                         style="font-family: 'Courier New', monospace; font-size: 0.9rem; overflow-x: auto;">
                        <SpectreMarkup Content="@Aaru.Decoders.MMC.Decoders.PrettifyExtendedCSD(_model.ExtendedCSD)" />
                    </div>
                </div>
            </div>
        }

    <!-- Info Card -->
        <div class="card bg-dark shadow-sm border-secondary">
            <div class="card-header bg-secondary text-light">
                <h6 class="mb-0">
                    <i class="bi bi-info-circle"></i> About MultiMediaCard Registers
                </h6>
            </div>
            <div class="card-body">
                <p class="text-light mb-2"><strong>MultiMediaCard Register Information</strong></p>
                <p class="text-secondary small mb-0">
                    This MultiMediaCard (MMC) contains CID (Card Identification), CSD (Card-Specific Data),
                    OCR (Operation Conditions Register), and Extended CSD registers. These registers provide
                    detailed information about the card's capabilities, specifications, operating conditions,
                    and extended features specific to MMC cards.
                </p>
            </div>
        </div>
        }
    }
</div>

