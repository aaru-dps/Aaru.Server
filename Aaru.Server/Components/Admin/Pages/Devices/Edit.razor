@page "/admin/devices/edit/{Id:int}"
@using Aaru.CommonTypes.Enums
@attribute [Authorize]
@layout AdminLayout
@rendermode InteractiveServer

@inject Microsoft.EntityFrameworkCore.IDbContextFactory<DbContext> DbContextFactory

<PageTitle>Edit Device Report</PageTitle>

@if(!isLoaded)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
        <div class="text-center">
            <div class="spinner-border text-info" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <h3 class="mt-3 text-light">Loading device report...</h3>
        </div>
    </div>
}
else if(device == null)
{
    <div class="container-fluid px-4 py-4">
        <div class="alert alert-danger bg-dark border-danger text-light" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Error:</strong> Device report not found.
        </div>
        <a href="/admin/devices" class="btn btn-secondary">
            <i class="bi bi-arrow-left-circle"></i> Back to List
        </a>
    </div>
}
else
{
    <div class="container-fluid px-4 py-4">
        <!-- Header Section -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h2 mb-1 text-light">
                    <i class="bi bi-pencil-square text-info"></i> Edit Device Report
                </h1>
                <p class="text-secondary mb-0">
                    <span class="badge bg-info text-dark me-2" style="min-width: 60px; display: inline-block;">ID: @Id</span>
                    <span class="text-light">@device.Manufacturer @device.Model</span>
                </p>
            </div>
            <div>
                <button type="button" class="btn btn-secondary" @onclick="GoBack">
                    <i class="bi bi-x-circle"></i> Cancel
                </button>
            </div>
        </div>

        <!-- Edit Form Card -->
        <div class="card bg-dark shadow-sm border-secondary">
            <div class="card-header bg-info text-dark">
                <h5 class="mb-0">
                    <i class="bi bi-file-earmark-text"></i> Device Information
                </h5>
            </div>
            <div class="card-body">
                <EditForm Model="device" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />

                    <div class="row g-4">
                        <!-- Left Column -->
                        <div class="col-md-6">
                            <!-- Manufacturer -->
                            <div class="mb-3">
                                <label class="form-label text-light">
                                    <i class="bi bi-building"></i> Manufacturer
                                    <span class="text-danger">*</span>
                                </label>
                                <InputText class="form-control bg-dark text-light border-secondary"
                                          @bind-Value="device.Manufacturer"
                                          placeholder="Enter manufacturer name..." />
                                <ValidationMessage For="@(() => device.Manufacturer)" class="text-danger small mt-1" />
                            </div>

                            <!-- Model -->
                            <div class="mb-3">
                                <label class="form-label text-light">
                                    <i class="bi bi-device-hdd"></i> Model
                                    <span class="text-danger">*</span>
                                </label>
                                <InputText class="form-control bg-dark text-light border-secondary"
                                          @bind-Value="device.Model"
                                          placeholder="Enter model name..." />
                                <ValidationMessage For="@(() => device.Model)" class="text-danger small mt-1" />
                            </div>

                            <!-- Revision -->
                            <div class="mb-3">
                                <label class="form-label text-light">
                                    <i class="bi bi-code-square"></i> Revision
                                    <span class="text-danger">*</span>
                                </label>
                                <InputText class="form-control bg-dark text-light border-secondary"
                                          @bind-Value="device.Revision"
                                          placeholder="Enter revision..." />
                                <ValidationMessage For="@(() => device.Revision)" class="text-danger small mt-1" />
                            </div>

                            <!-- Device Type -->
                            <div class="mb-3">
                                <label class="form-label text-light">
                                    <i class="bi bi-tag"></i> Device Type
                                    <span class="text-danger">*</span>
                                </label>
                                <InputSelect class="form-select bg-dark text-light border-secondary" @bind-Value="device.Type">
                                    @foreach(object? type in Enum.GetValues(typeof(DeviceType)))
                                    {
                                        <option value="@type">@type</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="@(() => device.Type)" class="text-danger small mt-1" />
                            </div>
                        </div>

                        <!-- Right Column -->
                        <div class="col-md-6">
                            <!-- Optimal Multiple Sectors Read -->
                            <div class="mb-3">
                                <label class="form-label text-light">
                                    <i class="bi bi-speedometer2"></i> Optimal Multiple Sectors Read
                                </label>
                                <InputNumber class="form-control bg-dark text-light border-secondary"
                                            @bind-Value="device.OptimalMultipleSectorsRead"
                                            placeholder="0" />
                                <small class="text-secondary">Number of sectors to read at once for optimal performance</small>
                                <ValidationMessage For="@(() => device.OptimalMultipleSectorsRead)" class="text-danger small mt-1" />
                            </div>

                            <!-- Compact Flash -->
                            <div class="mb-4 p-3 bg-black rounded border border-secondary">
                                <div class="form-check">
                                    <InputCheckbox class="form-check-input"
                                                  id="compactFlashCheck"
                                                  @bind-Value="device.CompactFlash" />
                                    <label class="form-check-label text-light" for="compactFlashCheck">
                                        <i class="bi bi-sd-card"></i> Compact Flash Device
                                    </label>
                                </div>
                                <small class="text-secondary d-block mt-1">Check if this is a Compact Flash storage device</small>
                            </div>

                            <!-- GD-ROM Swap Disc -->
                            <div class="mb-3 p-3 bg-black rounded border border-secondary">
                                <div class="form-check">
                                    <InputCheckbox class="form-check-input"
                                                  id="gdromCheck"
                                                  @bind-Value="device.CanReadGdRomUsingSwapDisc" />
                                    <label class="form-check-label text-light" for="gdromCheck">
                                        <i class="bi bi-disc"></i> Can Read GD-ROM Using Swap Disc
                                    </label>
                                </div>
                                <small class="text-secondary d-block mt-1">Check if device can read GD-ROM discs using the swap disc technique</small>
                            </div>
                        </div>
                    </div>

                    <!-- Validation Summary -->
                    <div class="row">
                        <div class="col-12">
                            <ValidationSummary class="alert alert-danger bg-dark border-danger text-light" />
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <hr class="border-secondary mb-4" />
                            <div class="d-flex justify-content-between align-items-center">
                                <button type="button" class="btn btn-secondary" @onclick="GoBack">
                                    <i class="bi bi-arrow-left-circle"></i> Cancel & Go Back
                                </button>
                                <button type="submit" class="btn btn-info btn-lg">
                                    <i class="bi bi-check-circle"></i> Save Changes
                                </button>
                            </div>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>

        <!-- Help Card -->
        <div class="card bg-dark shadow-sm border-secondary mt-4">
            <div class="card-header bg-secondary text-light">
                <h6 class="mb-0">
                    <i class="bi bi-info-circle"></i> Help
                </h6>
            </div>
            <div class="card-body">
                <p class="text-light mb-2"><strong>Required Fields</strong></p>
                <ul class="text-secondary small mb-0">
                    <li>Manufacturer, Model, Revision, and Device Type are required fields</li>
                    <li>Optimal sectors value helps optimize read performance (0 = not set)</li>
                    <li>Compact Flash option indicates if the device uses CF storage</li>
                    <li>GD-ROM swap disc capability is specific to certain optical drives</li>
                </ul>
            </div>
        </div>
    </div>
}
