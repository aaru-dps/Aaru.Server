@page "/admin/devices/find/{id:int}"
@attribute [Authorize]
@layout AdminLayout
@rendermode InteractiveServer

@inject Microsoft.EntityFrameworkCore.IDbContextFactory<DbContext> DbContextFactory

<PageTitle>Find Device Reports</PageTitle>

@if(!_initialized)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
        <div class="text-center">
            <div class="spinner-border text-info" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <h3 class="mt-3 text-light">Searching for similar devices...</h3>
        </div>
    </div>

    return;
}

<div class="container-fluid px-4 py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1 text-light">
                <i class="bi bi-search text-info"></i> Find Similar Device Reports
            </h1>
            <p class="text-secondary mb-0">Search results for device statistics ID: @Id</p>
        </div>
        <div>
            <a href="/admin/devices" class="btn btn-secondary">
                <i class="bi bi-arrow-left-circle"></i> Back to List
            </a>
        </div>
    </div>

    <!-- Search Criteria Card -->
    <div class="card bg-dark shadow-sm border-secondary mb-4">
        <div class="card-header bg-info text-dark">
            <h5 class="mb-0">
                <i class="bi bi-funnel"></i> Search Criteria
            </h5>
        </div>
        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-3 text-secondary">
                    <i class="bi bi-building"></i> Manufacturer
                </dt>
                <dd class="col-sm-9 text-light">
                    <strong>@_found.Manufacturer</strong>
                </dd>

                <dt class="col-sm-3 text-secondary">
                    <i class="bi bi-device-hdd"></i> Model
                </dt>
                <dd class="col-sm-9 text-light">
                    <strong>@_found.Model</strong>
                </dd>

                <dt class="col-sm-3 text-secondary">
                    <i class="bi bi-code-square"></i> Revision
                </dt>
                <dd class="col-sm-9 text-light">
                    <code class="text-info">@_found.Revision</code>
                </dd>

                <dt class="col-sm-3 text-secondary">
                    <i class="bi bi-diagram-3"></i> Bus
                </dt>
                <dd class="col-sm-9 text-light">
                    <span class="badge bg-secondary">@_found.Bus</span>
                </dd>
            </dl>
        </div>
    </div>

    <!-- Results Card -->
    <div class="card bg-dark shadow-sm border-secondary">
        <div class="card-header bg-secondary text-light">
            <h5 class="mb-0">
                <i class="bi bi-list-ul"></i> Similar Device Reports
                @if(_found.LikeDevices.Count > 0)
                {
                    <span class="badge bg-info text-dark float-end">@_found.LikeDevices.Count Found</span>
                }
            </h5>
        </div>
        <div class="card-body p-0">
            @if(_found.LikeDevices.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox text-secondary" style="font-size: 4rem;"></i>
                    <h4 class="text-secondary mt-3">No Similar Devices Found</h4>
                    <p class="text-secondary">No device reports with similar information have been found in the
                                              database.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover table-striped mb-0">
                        <thead class="table-secondary">
                        <tr>
                            <th style="width: 80px;">
                                <i class="bi bi-hash"></i> ID
                            </th>
                            <th>
                                <i class="bi bi-building"></i> Manufacturer
                            </th>
                            <th>
                                <i class="bi bi-device-hdd"></i> Model
                            </th>
                            <th style="width: 150px;">
                                <i class="bi bi-code-square"></i> Revision
                            </th>
                            <th style="width: 100px;" class="text-center">
                                <i class="bi bi-sd-card"></i> CF
                            </th>
                            <th style="width: 120px;">
                                <i class="bi bi-tag"></i> Type
                            </th>
                            <th style="width: 150px;" class="text-center">
                                <i class="bi bi-gear"></i> Actions
                            </th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach(Device item in _found.LikeDevices)
                        {
                            <tr>
                                <td class="align-middle">
                                    <span class="badge bg-info text-dark text-center"
                                          style="min-width: 60px; display: inline-block;">@item.Id</span>
                                </td>
                                <td class="align-middle">
                                    <strong class="text-light">@item.Manufacturer</strong>
                                </td>
                                <td class="align-middle">
                                    <strong class="text-light">@item.Model</strong>
                                </td>
                                <td class="align-middle">
                                    <code class="text-info">@item.Revision</code>
                                </td>
                                <td class="align-middle text-center">
                                    @if(item.CompactFlash)
                                    {
                                        <i class="bi bi-check-circle-fill text-success" title="Yes"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle-fill text-danger" title="No"></i>
                                    }
                                </td>
                                <td class="align-middle">
                                    <span class="badge bg-primary">@item.Type</span>
                                </td>
                                <td class="align-middle text-center">
                                    <a href="/admin/devices/@item.Id"
                                       class="btn btn-outline-info btn-sm me-1"
                                       title="View Details">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <button type="button"
                                            class="btn btn-outline-success btn-sm"
                                            @onclick="() => LinkReports(item.Id, _found.Id)"
                                            title="Link to Statistics">
                                        <i class="bi bi-link-45deg"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @if(_found.LikeDevices.Count > 0)
    {
        <div class="card bg-dark shadow-sm border-secondary mt-4">
            <div class="card-header bg-secondary text-light">
                <h6 class="mb-0">
                    <i class="bi bi-info-circle"></i> Help
                </h6>
            </div>
            <div class="card-body">
                <p class="text-light mb-2"><strong>About Linking</strong></p>
                <p class="text-secondary small mb-0">
                    Click the <i class="bi bi-link-45deg"></i> Link button to associate a device report with the device
                    statistics entry.
                    This helps maintain accurate device information across the database.
                </p>
            </div>
        </div>
    }
</div>
