@page "/admin/tested-media/{id:int}"
@attribute [Authorize]
@layout AdminLayout
@rendermode InteractiveServer

@inject Microsoft.EntityFrameworkCore.IDbContextFactory<DbContext> DbContextFactory

<PageTitle>Tested Media Details</PageTitle>

@if(!_initialized)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
        <div class="text-center">
            <div class="spinner-border text-info" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <h3 class="mt-3 text-light">Loading tested media details...</h3>
        </div>
    </div>

    return;
}

<div class="container-fluid px-4 py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1 text-light">
                <i class="bi bi-disc-fill text-info"></i> Tested Media Details
            </h1>
            <p class="text-secondary mb-0">
                <span class="badge bg-info text-dark me-2" style="min-width: 60px; display: inline-block;">ID: @Id</span>
                Complete tested media specifications and capabilities
            </p>
        </div>
        <div>
            <a href="/admin/tested-media" class="btn btn-secondary">
                <i class="bi bi-arrow-left-circle"></i> Back to List
            </a>
        </div>
    </div>

    @if(_model == null)
    {
        <!-- Not Found Alert -->
        <div class="alert alert-danger bg-dark border-danger text-light shadow-sm" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-3 me-3"></i>
                <div>
                    <h5 class="alert-heading mb-1 text-danger">Media Not Found</h5>
                    <p class="mb-0">The requested tested media could not be found in the database.</p>
                </div>
            </div>
        </div>
    }
    else
    {
        <!-- Key Information Summary Card -->
        <div class="card bg-dark shadow-sm border-secondary mb-4">
            <div class="card-header bg-info text-dark">
                <h5 class="mb-0">
                    <i class="bi bi-info-circle"></i> Media Summary
                </h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <dl class="row mb-0">
                            <dt class="col-sm-6 text-light">Manufacturer:</dt>
                            <dd class="col-sm-6"><strong class="text-info">@_model.Manufacturer</strong></dd>
                            <dt class="col-sm-6 text-light">Model:</dt>
                            <dd class="col-sm-6"><strong class="text-info">@_model.Model</strong></dd>
                            <dt class="col-sm-6 text-light">Media Type:</dt>
                            <dd class="col-sm-6"><span class="badge bg-primary">@_model.MediumTypeName</span></dd>
                            <dt class="col-sm-6 text-light">Media Recognized:</dt>
                            <dd class="col-sm-6">
                                @if(_model.MediaIsRecognized == true)
                                {
                                    <i class="bi bi-check-circle-fill text-success"></i> <span class="text-success">Yes</span>
                                }
                                else if(_model.MediaIsRecognized == false)
                                {
                                    <i class="bi bi-x-circle-fill text-danger"></i> <span class="text-danger">No</span>
                                }
                                else
                                {
                                    <span class="text-secondary">Unknown</span>
                                }
                            </dd>
                        </dl>
                    </div>
                    <div class="col-md-6">
                        <dl class="row mb-0">
                            <dt class="col-sm-6 text-light">Medium Type:</dt>
                            <dd class="col-sm-6">
                                @if(_model.MediumType != null)
                                {
                                    <span class="badge bg-secondary">@_model.MediumType</span>
                                }
                                else
                                {
                                    <span class="text-secondary">-</span>
                                }
                            </dd>
                            <dt class="col-sm-6 text-light">Density:</dt>
                            <dd class="col-sm-6">
                                @if(_model.Density != null)
                                {
                                    <span class="badge bg-secondary">@_model.Density</span>
                                }
                                else
                                {
                                    <span class="text-secondary">-</span>
                                }
                            </dd>
                            <dt class="col-sm-6 text-light">Solid State:</dt>
                            <dd class="col-sm-6">
                                @if(_model.SolidStateDevice == true)
                                {
                                    <i class="bi bi-check-circle-fill text-success"></i> <span class="text-success">Yes</span>
                                }
                                else if(_model.SolidStateDevice == false)
                                {
                                    <i class="bi bi-x-circle-fill text-secondary"></i> <span class="text-secondary">No</span>
                                }
                                else
                                {
                                    <span class="text-secondary">-</span>
                                }
                            </dd>
                        </dl>
                    </div>
                    <div class="col-md-6">
                        <dl class="row mb-0">
                            <dt class="col-sm-6 text-light">Blocks:</dt>
                            <dd class="col-sm-6">
                                @if(_model.Blocks != null)
                                {
                                    <span class="badge bg-success">@_model.Blocks.Value.ToString("N0")</span>
                                }
                                else
                                {
                                    <span class="text-secondary">-</span>
                                }
                            </dd>
                            <dt class="col-sm-6 text-light">Block Size:</dt>
                            <dd class="col-sm-6">
                                @if(_model.BlockSize != null)
                                {
                                    <span class="badge bg-warning text-dark">@_model.BlockSize</span>
                                }
                                else
                                {
                                    <span class="text-secondary">-</span>
                                }
                            </dd>
                            <dt class="col-sm-6 text-light">Long Block Size:</dt>
                            <dd class="col-sm-6">
                                @if(_model.LongBlockSize != null)
                                {
                                    <span class="badge bg-secondary">@_model.LongBlockSize</span>
                                }
                                else
                                {
                                    <span class="text-secondary">-</span>
                                }
                            </dd>
                        </dl>
                    </div>
                </div>
            </div>
        </div>

        <!-- Info Alert -->
        <div class="alert alert-info bg-dark border-info text-light shadow-sm mb-4" role="alert">
            <div class="d-flex align-items-start">
                <i class="bi bi-info-circle-fill text-info fs-4 me-3"></i>
                <div>
                    <h6 class="alert-heading mb-2 text-info">Comprehensive Test Results</h6>
                    <p class="mb-0 small">
                        This page displays complete tested media specifications with read capabilities, data samples,
                        and device-specific commands. Use the accordion sections below to explore detailed test results by category.
                        Data links open raw test data in a new tab.
                    </p>
                </div>
            </div>
        </div>

        <!-- Accordion for Detailed Features -->
        <div class="accordion accordion-flush" id="mediaAccordion">

            <!-- Device Identification Section -->
            <div class="accordion-item bg-dark border-secondary">
                <h2 class="accordion-header">
                    <button class="accordion-button bg-dark text-light border-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#deviceInfo">
                        <i class="bi bi-device-hdd text-info me-2"></i> Device Identification
                    </button>
                </h2>
                <div id="deviceInfo" class="accordion-collapse collapse show" data-bs-parent="#mediaAccordion">
                    <div class="accordion-body bg-dark">
                        <dl class="row mb-0">
                            @RenderDataLink(nameof(TestedMedia.IdentifyData))
                            @RenderDataLink(nameof(TestedMedia.ModeSense6Data))
                            @RenderDataLink(nameof(TestedMedia.ModeSense10Data))
                        </dl>
                    </div>
                </div>
            </div>

            <!-- Device Specifications Section -->
            <div class="accordion-item bg-dark border-secondary">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed bg-dark text-light border-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#deviceSpecs">
                        <i class="bi bi-cpu text-warning me-2"></i> Device Specifications
                    </button>
                </h2>
                <div id="deviceSpecs" class="accordion-collapse collapse" data-bs-parent="#mediaAccordion">
                    <div class="accordion-body bg-dark">
                        <dl class="row mb-0">
                            @RenderFeature(nameof(TestedMedia.LBASectors))
                            @RenderFeature(nameof(TestedMedia.LBA48Sectors))
                            @RenderFeature(nameof(TestedMedia.LogicalAlignment))
                            @RenderFeature(nameof(TestedMedia.NominalRotationRate))
                            @RenderFeature(nameof(TestedMedia.PhysicalBlockSize))
                            @RenderFeature(nameof(TestedMedia.UnformattedBPT))
                            @RenderFeature(nameof(TestedMedia.UnformattedBPS))
                        </dl>
                    </div>
                </div>
            </div>

            <!-- Basic Read Capabilities Section -->
            <div class="accordion-item bg-dark border-secondary">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed bg-dark text-light border-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#basicRead">
                        <i class="bi bi-book text-success me-2"></i> Basic Read Capabilities
                    </button>
                </h2>
                <div id="basicRead" class="accordion-collapse collapse" data-bs-parent="#mediaAccordion">
                    <div class="accordion-body bg-dark">
                        <dl class="row mb-0">
                            @RenderFeature(nameof(TestedMedia.SupportsReadCapacity))
                            @RenderFeature(nameof(TestedMedia.SupportsReadCapacity16))
                            @RenderFeature(nameof(TestedMedia.SupportsRead6))
                            @RenderFeature(nameof(TestedMedia.SupportsRead10))
                            @RenderFeature(nameof(TestedMedia.SupportsRead12))
                            @RenderFeature(nameof(TestedMedia.SupportsRead16))
                            @RenderFeature(nameof(TestedMedia.SupportsReadLong))
                            @RenderFeature(nameof(TestedMedia.SupportsReadLong16))
                            @RenderFeature(nameof(TestedMedia.SupportsSeek))
                            @RenderFeature(nameof(TestedMedia.SupportsSeekLba))
                            @RenderDataLink(nameof(TestedMedia.Read6Data))
                            @RenderDataLink(nameof(TestedMedia.Read10Data))
                            @RenderDataLink(nameof(TestedMedia.Read12Data))
                            @RenderDataLink(nameof(TestedMedia.Read16Data))
                            @RenderDataLink(nameof(TestedMedia.ReadLong10Data))
                            @RenderDataLink(nameof(TestedMedia.ReadLong16Data))
                        </dl>
                    </div>
                </div>
            </div>

            <!-- CD/DVD Specific Features Section -->
            <div class="accordion-item bg-dark border-secondary">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed bg-dark text-light border-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#cdDvdFeatures">
                        <i class="bi bi-disc text-primary me-2"></i> CD/DVD Specific Features
                    </button>
                </h2>
                <div id="cdDvdFeatures" class="accordion-collapse collapse" data-bs-parent="#mediaAccordion">
                    <div class="accordion-body bg-dark">
                        <dl class="row mb-0">
                            @RenderFeature(nameof(TestedMedia.CanReadAACS))
                            @RenderFeature(nameof(TestedMedia.CanReadADIP))
                            @RenderFeature(nameof(TestedMedia.CanReadATIP))
                            @RenderFeature(nameof(TestedMedia.CanReadBCA))
                            @RenderFeature(nameof(TestedMedia.CanReadC2Pointers))
                            @RenderFeature(nameof(TestedMedia.CanReadCMI))
                            @RenderFeature(nameof(TestedMedia.CanReadDCB))
                            @RenderFeature(nameof(TestedMedia.CanReadDDS))
                            @RenderFeature(nameof(TestedMedia.CanReadDMI))
                            @RenderFeature(nameof(TestedMedia.CanReadPFI))
                            @RenderFeature(nameof(TestedMedia.CanReadPRI))
                            @RenderDataLink(nameof(TestedMedia.AdipData))
                            @RenderDataLink(nameof(TestedMedia.AtipData))
                            @RenderDataLink(nameof(TestedMedia.DvdBcaData))
                            @RenderDataLink(nameof(TestedMedia.DvdAacsData))
                            @RenderDataLink(nameof(TestedMedia.DvdDdsData))
                            @RenderDataLink(nameof(TestedMedia.DvdSaiData))
                            @RenderDataLink(nameof(TestedMedia.DmiData))
                            @RenderDataLink(nameof(TestedMedia.PfiData))
                            @RenderDataLink(nameof(TestedMedia.PriData))
                            @RenderDataLink(nameof(TestedMedia.EmbossedPfiData))
                            @RenderDataLink(nameof(TestedMedia.DvdLayerData))
                            @RenderDataLink(nameof(TestedMedia.CmiData))
                            @RenderDataLink(nameof(TestedMedia.DcbData))
                        </dl>
                    </div>
                </div>
            </div>

            <!-- Blu-ray Features Section -->
            <div class="accordion-item bg-dark border-secondary">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed bg-dark text-light border-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#blurayFeatures">
                        <i class="bi bi-disc text-primary me-2"></i> Blu-ray Features
                    </button>
                </h2>
                <div id="blurayFeatures" class="accordion-collapse collapse" data-bs-parent="#mediaAccordion">
                    <div class="accordion-body bg-dark">
                        <dl class="row mb-0">
                            @RenderDataLink(nameof(TestedMedia.BluBcaData))
                            @RenderDataLink(nameof(TestedMedia.BluDdsData))
                            @RenderDataLink(nameof(TestedMedia.BluDiData))
                            @RenderDataLink(nameof(TestedMedia.BluPacData))
                            @RenderDataLink(nameof(TestedMedia.BluSaiData))
                        </dl>
                    </div>
                </div>
            </div>

            <!-- CD Audio & Subchannel Features Section -->
            <div class="accordion-item bg-dark border-secondary">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed bg-dark text-light border-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#audioFeatures">
                        <i class="bi bi-music-note text-success me-2"></i> CD Audio & Subchannel
                    </button>
                </h2>
                <div id="audioFeatures" class="accordion-collapse collapse" data-bs-parent="#mediaAccordion">
                    <div class="accordion-body bg-dark">
                        <dl class="row mb-0">
                            @RenderFeature(nameof(TestedMedia.SupportsReadCd))
                            @RenderFeature(nameof(TestedMedia.SupportsReadCdMsf))
                            @RenderFeature(nameof(TestedMedia.SupportsReadCdRaw))
                            @RenderFeature(nameof(TestedMedia.SupportsReadCdMsfRaw))
                            @RenderFeature(nameof(TestedMedia.CanReadCdScrambled))
                            @RenderFeature(nameof(TestedMedia.CanReadCorrectedSubchannel))
                            @RenderFeature(nameof(TestedMedia.CanReadCorrectedSubchannelWithC2))
                            @RenderFeature(nameof(TestedMedia.CanReadPQSubchannel))
                            @RenderFeature(nameof(TestedMedia.CanReadPQSubchannelWithC2))
                            @RenderFeature(nameof(TestedMedia.CanReadRWSubchannel))
                            @RenderFeature(nameof(TestedMedia.CanReadRWSubchannelWithC2))
                            @RenderDataLink(nameof(TestedMedia.ReadCdData))
                            @RenderDataLink(nameof(TestedMedia.ReadCdFullData))
                            @RenderDataLink(nameof(TestedMedia.ReadCdMsfData))
                            @RenderDataLink(nameof(TestedMedia.ReadCdMsfFullData))
                            @RenderDataLink(nameof(TestedMedia.ReadCdScrambledData))
                            @RenderDataLink(nameof(TestedMedia.C2PointersData))
                            @RenderDataLink(nameof(TestedMedia.CorrectedSubchannelData))
                            @RenderDataLink(nameof(TestedMedia.CorrectedSubchannelWithC2Data))
                            @RenderDataLink(nameof(TestedMedia.PQSubchannelData))
                            @RenderDataLink(nameof(TestedMedia.PQSubchannelWithC2Data))
                            @RenderDataLink(nameof(TestedMedia.RWSubchannelData))
                            @RenderDataLink(nameof(TestedMedia.RWSubchannelWithC2Data))
                        </dl>
                    </div>
                </div>
            </div>

            <!-- TOC & Lead-In/Out Section -->
            <div class="accordion-item bg-dark border-secondary">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed bg-dark text-light border-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#tocFeatures">
                        <i class="bi bi-list-columns text-warning me-2"></i> TOC & Lead-In/Out
                    </button>
                </h2>
                <div id="tocFeatures" class="accordion-collapse collapse" data-bs-parent="#mediaAccordion">
                    <div class="accordion-body bg-dark">
                        <dl class="row mb-0">
                            @RenderFeature(nameof(TestedMedia.CanReadFullTOC))
                            @RenderFeature(nameof(TestedMedia.CanReadPMA))
                            @RenderFeature(nameof(TestedMedia.CanReadTOC))
                            @RenderFeature(nameof(TestedMedia.CanReadLeadIn))
                            @RenderFeature(nameof(TestedMedia.CanReadLeadOut))
                            @RenderFeature(nameof(TestedMedia.CanReadingIntersessionLeadIn))
                            @RenderFeature(nameof(TestedMedia.CanReadingIntersessionLeadOut))
                            @RenderDataLink(nameof(TestedMedia.FullTocData))
                            @RenderDataLink(nameof(TestedMedia.PmaData))
                            @RenderDataLink(nameof(TestedMedia.TocData))
                            @RenderDataLink(nameof(TestedMedia.LeadInData))
                            @RenderDataLink(nameof(TestedMedia.LeadOutData))
                            @RenderFeature(nameof(TestedMedia.CanReadFirstTrackPreGap))
                            @RenderDataLink(nameof(TestedMedia.Track1PregapData))
                            @RenderDataLink(nameof(TestedMedia.IntersessionLeadInData))
                            @RenderDataLink(nameof(TestedMedia.IntersessionLeadOutData))
                        </dl>
                    </div>
                </div>
            </div>

            <!-- ATA Read Commands Section -->
            <div class="accordion-item bg-dark border-secondary">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed bg-dark text-light border-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#ataCommands">
                        <i class="bi bi-hdd text-info me-2"></i> ATA Read Commands
                    </button>
                </h2>
                <div id="ataCommands" class="accordion-collapse collapse" data-bs-parent="#mediaAccordion">
                    <div class="accordion-body bg-dark">
                        <dl class="row mb-0">
                            @RenderFeature(nameof(TestedMedia.SupportsReadDma))
                            @RenderFeature(nameof(TestedMedia.SupportsReadDmaLba))
                            @RenderFeature(nameof(TestedMedia.SupportsReadDmaLba48))
                            @RenderFeature(nameof(TestedMedia.SupportsReadDmaRetry))
                            @RenderFeature(nameof(TestedMedia.SupportsReadDmaRetryLba))
                            @RenderFeature(nameof(TestedMedia.SupportsReadLba))
                            @RenderFeature(nameof(TestedMedia.SupportsReadLba48))
                            @RenderFeature(nameof(TestedMedia.SupportsReadRetryLba))
                            @RenderFeature(nameof(TestedMedia.SupportsReadSectors))
                            @RenderFeature(nameof(TestedMedia.SupportsReadLongLba))
                            @RenderFeature(nameof(TestedMedia.SupportsReadLongRetry))
                            @RenderFeature(nameof(TestedMedia.SupportsReadLongRetryLba))
                            @RenderDataLink(nameof(TestedMedia.ReadDmaData))
                            @RenderDataLink(nameof(TestedMedia.ReadDmaLbaData))
                            @RenderDataLink(nameof(TestedMedia.ReadDmaLba48Data))
                            @RenderDataLink(nameof(TestedMedia.ReadDmaRetryData))
                            @RenderDataLink(nameof(TestedMedia.ReadDmaRetryLbaData))
                            @RenderDataLink(nameof(TestedMedia.ReadLbaData))
                            @RenderDataLink(nameof(TestedMedia.ReadLba48Data))
                            @RenderDataLink(nameof(TestedMedia.ReadRetryLbaData))
                            @RenderDataLink(nameof(TestedMedia.ReadSectorsData))
                            @RenderDataLink(nameof(TestedMedia.ReadSectorsRetryData))
                            @RenderDataLink(nameof(TestedMedia.ReadLongData))
                            @RenderDataLink(nameof(TestedMedia.ReadLongLbaData))
                            @RenderDataLink(nameof(TestedMedia.ReadLongRetryData))
                            @RenderDataLink(nameof(TestedMedia.ReadLongRetryLbaData))
                        </dl>
                    </div>
                </div>
            </div>

            <!-- Vendor-Specific Commands Section -->
            <div class="accordion-item bg-dark border-secondary">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed bg-dark text-light border-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#vendorCommands">
                        <i class="bi bi-tools text-secondary me-2"></i> Vendor-Specific Commands
                    </button>
                </h2>
                <div id="vendorCommands" class="accordion-collapse collapse" data-bs-parent="#mediaAccordion">
                    <div class="accordion-body bg-dark">
                        <dl class="row mb-0">
                            @RenderFeature(nameof(TestedMedia.CanReadF1_06))
                            @RenderFeature(nameof(TestedMedia.CanReadF1_06LeadOut))
                            @RenderFeature(nameof(TestedMedia.SupportsHLDTSTReadRawDVD))
                            @RenderFeature(nameof(TestedMedia.SupportsLiteOnReadRawDVD))
                            @RenderFeature(nameof(TestedMedia.SupportsNECReadCDDA))
                            @RenderFeature(nameof(TestedMedia.SupportsPioneerReadCDDA))
                            @RenderFeature(nameof(TestedMedia.SupportsPioneerReadCDDAMSF))
                            @RenderFeature(nameof(TestedMedia.SupportsPlextorReadCDDA))
                            @RenderFeature(nameof(TestedMedia.SupportsPlextorReadRawDVD))
                            @RenderDataLink(nameof(TestedMedia.ReadF1_06Data))
                            @RenderDataLink(nameof(TestedMedia.ReadF1_06LeadOutData))
                            @RenderDataLink(nameof(TestedMedia.NecReadCddaData))
                            @RenderDataLink(nameof(TestedMedia.PioneerReadCddaData))
                            @RenderDataLink(nameof(TestedMedia.PioneerReadCddaMsfData))
                            @RenderDataLink(nameof(TestedMedia.PlextorReadCddaData))
                            @RenderDataLink(nameof(TestedMedia.PlextorReadRawDVDData))
                            @RenderDataLink(nameof(TestedMedia.HLDTSTReadRawDVDData))
                            @RenderDataLink(nameof(TestedMedia.LiteOnReadRawDVDData))
                        </dl>
                    </div>
                </div>
            </div>

            <!-- HD DVD Features Section -->
            <div class="accordion-item bg-dark border-secondary">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed bg-dark text-light border-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#hdDvdFeatures">
                        <i class="bi bi-disc text-primary me-2"></i> HD DVD Features
                    </button>
                </h2>
                <div id="hdDvdFeatures" class="accordion-collapse collapse" data-bs-parent="#mediaAccordion">
                    <div class="accordion-body bg-dark">
                        <dl class="row mb-0">
                            @RenderFeature(nameof(TestedMedia.CanReadHDCMI))
                            @RenderDataLink(nameof(TestedMedia.HdCmiData))
                        </dl>
                    </div>
                </div>
            </div>

            <!-- Disc Information Section -->
            <div class="accordion-item bg-dark border-secondary">
                <h2 class="accordion-header">
                    <button class="accordion-button collapsed bg-dark text-light border-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#discInfo">
                        <i class="bi bi-info-square text-info me-2"></i> Disc Information
                    </button>
                </h2>
                <div id="discInfo" class="accordion-collapse collapse" data-bs-parent="#mediaAccordion">
                    <div class="accordion-body bg-dark">
                        <dl class="row mb-0">
                            @RenderFeature(nameof(TestedMedia.CanReadDiscInformation))
                            @RenderFeature(nameof(TestedMedia.CanReadLayerCapacity))
                            @RenderFeature(nameof(TestedMedia.CanReadMediaID))
                            @RenderFeature(nameof(TestedMedia.CanReadMediaSerial))
                            @RenderFeature(nameof(TestedMedia.CanReadPAC))
                            @RenderFeature(nameof(TestedMedia.CanReadRecordablePFI))
                            @RenderFeature(nameof(TestedMedia.CanReadSpareAreaInformation))
                        </dl>
                    </div>
                </div>
            </div>

        </div>
    }
</div>

@code {
    private RenderFragment RenderFeature(string propertyName)
    {
        return __builder =>
        {
            var property = typeof(TestedMedia).GetProperty(propertyName);
            if (property == null) return;

            var value = property.GetValue(_model);
            var displayName = DisplayNameHelper.GetDisplayName(typeof(TestedMedia), propertyName);

            <dt class="col-sm-9 text-light">
                @displayName
            </dt>
            <dd class="col-sm-3 text-end">
                @if (value is bool boolValue)
                {
                    if (boolValue)
                    {
                        <i class="bi bi-check-circle-fill text-success" title="Yes"></i>
                        <span class="text-success ms-1">Yes</span>
                    }
                    else
                    {
                        <i class="bi bi-x-circle-fill text-danger" title="No"></i>
                        <span class="text-danger ms-1">No</span>
                    }
                }
                else if (value != null)
                {
                    <span class="badge bg-primary">@value</span>
                }
                else
                {
                    <span class="text-secondary">-</span>
                }
            </dd>
        };
    }

    private RenderFragment RenderDataLink(string propertyName)
    {
        return __builder =>
        {
            var property = typeof(TestedMedia).GetProperty(propertyName);
            if (property == null) return;

            var value = property.GetValue(_model) as byte[];
            var displayName = DisplayNameHelper.GetDisplayName(typeof(TestedMedia), propertyName);

            <dt class="col-sm-9 text-light">
                @displayName
            </dt>
            <dd class="col-sm-3 text-end">
                @if (value != null && value.Length > 0)
                {
                    <a href="/admin/tested-media/data/@_model.Id/@propertyName"
                       class="btn btn-outline-info btn-sm"
                       target="_blank"
                       title="View raw data">
                        <i class="bi bi-file-binary"></i> @value.Length.ToString("N0") bytes
                    </a>
                }
                else
                {
                    <span class="text-secondary">-</span>
                }
            </dd>
        };
    }
}

