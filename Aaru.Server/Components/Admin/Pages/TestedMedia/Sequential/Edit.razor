@page "/admin/tested-media/sequential/edit/{Id:int}"
@attribute [Authorize]
@layout AdminLayout
@rendermode InteractiveServer

@inject Microsoft.EntityFrameworkCore.IDbContextFactory<DbContext> DbContextFactory

<PageTitle>Edit Sequential Media</PageTitle>

<div class="container-fluid px-4 py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1 text-light">
                <i class="bi bi-pencil-square text-info"></i> Edit Sequential Media
            </h1>
            <p class="text-secondary mb-0">
                <span class="badge bg-info text-dark me-2"
                      style="min-width: 60px; display: inline-block;">ID: @Id</span>
                Update tested sequential media information
            </p>
        </div>
        <div>
            <a href="/admin/tested-media/sequential" class="btn btn-secondary">
                <i class="bi bi-arrow-left-circle"></i> Back to List
            </a>
        </div>
    </div>

    @if(_notFound)
    {
    <!-- Not Found Alert -->
        <div class="alert alert-danger bg-dark border-danger text-light shadow-sm" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-3 me-3"></i>
                <div>
                    <h5 class="alert-heading mb-1 text-danger">Media Not Found</h5>
                    <p class="mb-0">The requested sequential media could not be found in the database.</p>
                </div>
            </div>
        </div>
    }
    else
    {
    <!-- Edit Form Card -->
        <div class="card bg-dark shadow-sm border-secondary">
            <div class="card-header bg-info text-dark">
                <h5 class="mb-0">
                    <i class="bi bi-file-earmark-text"></i> Sequential Media Information
                </h5>
            </div>
            <div class="card-body">
                <EditForm Model="_model" OnValidSubmit="HandleValidSubmitAsync">
                    <DataAnnotationsValidator />

                    <div class="row g-3">
                        <!-- Manufacturer -->
                        <div class="col-md-6">
                            <label class="form-label text-light">
                                <i class="bi bi-building"></i> Manufacturer
                            </label>
                            <InputText class="form-control bg-dark text-light border-secondary"
                                       @bind-Value="_model.Manufacturer"
                                       placeholder="Enter manufacturer name..." />
                            <ValidationMessage For="@(() => _model.Manufacturer)" class="text-danger small mt-1" />
                        </div>

                        <!-- Model -->
                        <div class="col-md-6">
                            <label class="form-label text-light">
                                <i class="bi bi-device-hdd"></i> Model
                            </label>
                            <InputText class="form-control bg-dark text-light border-secondary"
                                       @bind-Value="_model.Model"
                                       placeholder="Enter model name..." />
                            <ValidationMessage For="@(() => _model.Model)" class="text-danger small mt-1" />
                        </div>

                        <!-- Medium Type Name -->
                        <div class="col-md-12">
                            <label class="form-label text-light">
                                <i class="bi bi-cassette"></i> Medium Type Name
                            </label>
                            <InputText class="form-control bg-dark text-light border-secondary"
                                       @bind-Value="_model.MediumTypeName"
                                       placeholder="Enter medium type name..." />
                            <ValidationMessage For="@(() => _model.MediumTypeName)" class="text-danger small mt-1" />
                            <small class="text-secondary d-block mt-1">Type of sequential media (e.g., LTO-5, DLT-IV,
                                                                       etc.)</small>
                        </div>
                    </div>

                    <!-- Validation Summary -->
                    <div class="mt-3">
                        <ValidationSummary class="text-danger" />
                    </div>

                    <!-- Action Buttons -->
                    <div class="d-flex gap-2 mt-4">
                        <button type="submit" class="btn btn-info">
                            <i class="bi bi-save"></i> Save Changes
                        </button>
                        <a href="/admin/tested-media/sequential" class="btn btn-secondary">
                            <i class="bi bi-x-circle"></i> Cancel
                        </a>
                    </div>
                </EditForm>
            </div>
        </div>
    }

    <!-- Success Alert -->
    @if(_success)
    {
        <div class="alert alert-success bg-dark border-success text-light shadow-sm mt-3" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-check-circle-fill text-success fs-3 me-3"></i>
                <div>
                    <h5 class="alert-heading mb-1 text-success">Success!</h5>
                    <p class="mb-0">Sequential media saved successfully.</p>
                </div>
            </div>
        </div>
    }

    <!-- Error Alert -->
    @if(_error)
    {
        <div class="alert alert-danger bg-dark border-danger text-light shadow-sm mt-3" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-3 me-3"></i>
                <div>
                    <h5 class="alert-heading mb-1 text-danger">Error!</h5>
                    <p class="mb-0">An error occurred while saving the sequential media. Please try again.</p>
                </div>
            </div>
        </div>
    }
</div>

