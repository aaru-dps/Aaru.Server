@page "/admin/tested-media/data/{Id:int}/{data}"
@attribute [Authorize]
@layout AdminLayout
@rendermode InteractiveServer

@inject Microsoft.EntityFrameworkCore.IDbContextFactory<DbContext> DbContextFactory

<PageTitle>View Test Data</PageTitle>

@if(!_initialized)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
        <div class="text-center">
            <div class="spinner-border text-info" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <h3 class="mt-3 text-light">Loading test data...</h3>
        </div>
    </div>

    return;
}

@if(_notFound)
{
    <div class="container-fluid px-4 py-4">
        <div class="alert alert-danger bg-dark border-danger text-light shadow-sm" role="alert">
            <div class="d-flex align-items-center">
                <i class="bi bi-exclamation-triangle-fill text-danger fs-3 me-3"></i>
                <div>
                    <h5 class="alert-heading mb-1 text-danger">Data Not Found</h5>
                    <p class="mb-0">The requested test data could not be found in the database.</p>
                </div>
            </div>
        </div>
        <a href="/admin/tested-media/@Id" class="btn btn-secondary">
            <i class="bi bi-arrow-left-circle"></i> Back to Details
        </a>
    </div>

    return;
}

<div class="container-fluid px-4 py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1 text-light">
                <i class="bi bi-file-binary text-info"></i> Test Data Viewer
            </h1>
            <p class="text-secondary mb-0">
                <span class="badge bg-info text-dark me-2"
                      style="min-width: 60px; display: inline-block;">Media ID: @_model.TestedMediaId</span>
                <span class="badge bg-primary">@_model.DataName</span>
            </p>
        </div>
        <div>
            <a href="/admin/tested-media/@Id" class="btn btn-secondary">
                <i class="bi bi-arrow-left-circle"></i> Back to Details
            </a>
        </div>
    </div>

    <!-- Decoded Information Card -->
    @if(!string.IsNullOrWhiteSpace(_model.Decoded))
    {
        <div class="card bg-dark shadow-sm border-secondary mb-4">
            <div class="card-header bg-success text-dark">
                <h5 class="mb-0">
                    <i class="bi bi-file-earmark-text"></i> Decoded Information
                </h5>
            </div>
            <div class="card-body">
                <div class="bg-black p-4 rounded border border-secondary"
                     style="font-family: 'Courier New', monospace; font-size: 0.9rem; overflow-x: auto;">
                    <SpectreMarkup Content="@_model.Decoded" />
                </div>
            </div>
        </div>
    }

    <!-- Raw Hex Dump Card -->
    <div class="card bg-dark shadow-sm border-secondary">
        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0">
                <i class="bi bi-file-binary"></i> Raw Data - Hex Dump
            </h5>
        </div>
        <div class="card-body">
            <div class="bg-black p-4 rounded border border-secondary" style="overflow-x: auto;">
                <code style="white-space: pre; font-family: 'Courier New', monospace; font-size: 0.85rem; color: #00ff00; line-height: 1.6;">@(new MarkupString(_model.RawDataAsHex))</code>
            </div>
        </div>
    </div>
</div>

