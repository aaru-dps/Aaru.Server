@page "/admin/firewire/edit/{Id:int}"
@attribute [Authorize]
@layout AdminLayout
@rendermode InteractiveServer

@inject Microsoft.EntityFrameworkCore.IDbContextFactory<DbContext> DbContextFactory

<PageTitle>Edit FireWire Device</PageTitle>

@if(!_isLoaded)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
        <div class="text-center">
            <div class="spinner-border text-info" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <h3 class="mt-3 text-light">Loading FireWire device...</h3>
        </div>
    </div>
}
else
{
    <div class="container-fluid px-4 py-4">
        <!-- Header Section -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h2 mb-1 text-light">
                    <i class="bi bi-pencil-square text-info"></i> Edit FireWire Device
                </h1>
                <p class="text-secondary mb-0">
                    <span class="badge bg-info text-dark me-2"
                          style="min-width: 60px; display: inline-block;">ID: @Id</span>
                    <span class="text-light">@_fireWire.Manufacturer @_fireWire.Product</span>
                </p>
            </div>
            <div>
                <button type="button" class="btn btn-secondary" @onclick="GoBack">
                    <i class="bi bi-x-circle"></i> Cancel
                </button>
            </div>
        </div>

        <!-- Edit Form Card -->
        <div class="card bg-dark shadow-sm border-secondary">
            <div class="card-header bg-info text-dark">
                <h5 class="mb-0">
                    <i class="bi bi-lightning"></i> FireWire Device Information
                </h5>
            </div>
            <div class="card-body">
                <EditForm Model="_fireWire" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />

                    <div class="row g-4">
                        <!-- Left Column -->
                        <div class="col-md-6">
                            <!-- Vendor ID -->
                            <div class="mb-3">
                                <label class="form-label text-light">
                                    <i class="bi bi-hash"></i> Vendor ID
                                    <span class="text-danger">*</span>
                                </label>
                                <InputNumber class="form-control bg-dark text-light border-secondary"
                                             @bind-Value="_fireWire.VendorID"
                                             placeholder="Enter vendor ID..." />
                                <small class="text-secondary">Hexadecimal vendor identifier</small>
                                <ValidationMessage For="@(() => _fireWire.VendorID)" class="text-danger small mt-1" />
                            </div>

                            <!-- Product ID -->
                            <div class="mb-3">
                                <label class="form-label text-light">
                                    <i class="bi bi-hash"></i> Product ID
                                    <span class="text-danger">*</span>
                                </label>
                                <InputNumber class="form-control bg-dark text-light border-secondary"
                                             @bind-Value="_fireWire.ProductID"
                                             placeholder="Enter product ID..." />
                                <small class="text-secondary">Hexadecimal product identifier</small>
                                <ValidationMessage For="@(() => _fireWire.ProductID)" class="text-danger small mt-1" />
                            </div>
                        </div>

                        <!-- Right Column -->
                        <div class="col-md-6">
                            <!-- Manufacturer -->
                            <div class="mb-3">
                                <label class="form-label text-light">
                                    <i class="bi bi-building"></i> Manufacturer
                                    <span class="text-danger">*</span>
                                </label>
                                <InputText class="form-control bg-dark text-light border-secondary"
                                           @bind-Value="_fireWire.Manufacturer"
                                           placeholder="Enter manufacturer name..." />
                                <ValidationMessage For="@(() => _fireWire.Manufacturer)"
                                                   class="text-danger small mt-1" />
                            </div>

                            <!-- Product -->
                            <div class="mb-3">
                                <label class="form-label text-light">
                                    <i class="bi bi-tag"></i> Product
                                    <span class="text-danger">*</span>
                                </label>
                                <InputText class="form-control bg-dark text-light border-secondary"
                                           @bind-Value="_fireWire.Product"
                                           placeholder="Enter product name..." />
                                <ValidationMessage For="@(() => _fireWire.Product)" class="text-danger small mt-1" />
                            </div>
                        </div>

                        <!-- Removable Media Checkbox (Full Width) -->
                        <div class="col-12">
                            <div class="p-3 bg-black rounded border border-secondary">
                                <div class="form-check">
                                    <InputCheckbox class="form-check-input"
                                                   id="removableMediaCheck"
                                                   @bind-Value="_fireWire.RemovableMedia" />
                                    <label class="form-check-label text-light" for="removableMediaCheck">
                                        <i class="bi bi-eject"></i> Removable Media Device
                                    </label>
                                </div>
                                <small class="text-secondary d-block mt-1">Check if this device has removable storage
                                                                           media</small>
                            </div>
                        </div>
                    </div>

                    <!-- Validation Summary -->
                    <div class="row">
                        <div class="col-12">
                            <ValidationSummary class="alert alert-danger bg-dark border-danger text-light" />
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <hr class="border-secondary mb-4" />
                            <div class="d-flex justify-content-between align-items-center">
                                <button type="button" class="btn btn-secondary" @onclick="GoBack">
                                    <i class="bi bi-arrow-left-circle"></i> Cancel & Go Back
                                </button>
                                <button type="submit" class="btn btn-info btn-lg">
                                    <i class="bi bi-check-circle"></i> Save Changes
                                </button>
                            </div>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>

        <!-- Help Card -->
        <div class="card bg-dark shadow-sm border-secondary mt-4">
            <div class="card-header bg-secondary text-light">
                <h6 class="mb-0">
                    <i class="bi bi-info-circle"></i> Help
                </h6>
            </div>
            <div class="card-body">
                <p class="text-light mb-2"><strong>About FireWire Device Registers</strong></p>
                <ul class="text-secondary small mb-0">
                    <li>Vendor ID and Product ID are hexadecimal identifiers from the IEEE 1394 specification</li>
                    <li>These IDs uniquely identify FireWire devices during enumeration</li>
                    <li>Manufacturer and Product names help identify the device in a human-readable format</li>
                    <li>The removable media flag indicates if the device has removable storage</li>
                </ul>
            </div>
        </div>
    </div>
}
