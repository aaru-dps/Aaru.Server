@page "/admin/scsi/{id:int}"
@using Aaru.CommonTypes.Structs.Devices.SCSI
@using Aaru.Helpers
@attribute [Authorize]
@layout AdminLayout
@rendermode InteractiveServer

@inject Microsoft.EntityFrameworkCore.IDbContextFactory<DbContext> DbContextFactory

<PageTitle>SCSI INQUIRY Response</PageTitle>

@if(!_initialized)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
        <div class="text-center">
            <div class="spinner-border text-info" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <h3 class="mt-3 text-light">Loading SCSI INQUIRY response...</h3>
        </div>
    </div>

    return;
}

<div class="container-fluid px-4 py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1 text-light">
                <i class="bi bi-hdd-network text-info"></i> SCSI INQUIRY Response
            </h1>
            <p class="text-secondary mb-0">
                <span class="badge bg-info text-dark me-2"
                      style="min-width: 60px; display: inline-block;">ID: @Id</span>
                @if(_model?.Inquiry != null)
                {
                    <span class="text-light">
                        @StringHandlers.CToString(((Inquiry)_model.Inquiry).VendorIdentification)
                        @StringHandlers.CToString(((Inquiry)_model.Inquiry).ProductIdentification)
                    </span>

                    @if(((Inquiry)_model.Inquiry).ProductRevisionLevel != null)
                    {
                        <span class="text-secondary ms-2">
                            <i class="bi bi-code-square"></i> @StringHandlers.CToString(((Inquiry)_model.Inquiry).ProductRevisionLevel)
                        </span>
                    }
                }
            </p>
        </div>
        <div>
            <a href="/admin/scsi" class="btn btn-secondary">
                <i class="bi bi-arrow-left-circle"></i> Back to List
            </a>
        </div>
    </div>

    <!-- Compare Tool Card -->
    <div class="card bg-dark shadow-sm mb-4 border-secondary">
        <div class="card-header bg-secondary text-light">
            <h5 class="mb-0">
                <i class="bi bi-arrow-left-right"></i> Compare Tool
            </h5>
        </div>
        <div class="card-body">
            <div class="row align-items-end g-3">
                <div class="col-auto">
                    <label for="compareId" class="form-label text-light">
                        <i class="bi bi-hash"></i> Compare with SCSI Response ID
                    </label>
                    <input id="compareId"
                           class="form-control bg-dark text-light border-secondary"
                           type="number"
                           placeholder="Enter ID..."
                           @bind="_compareId" />
                </div>
                <div class="col-auto">
                    <button class="btn btn-info" @onclick="GoToCompare">
                        <i class="bi bi-arrow-left-right"></i> Compare Responses
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- SCSI INQUIRY Data Card -->
    <div class="card bg-dark shadow-sm border-secondary">
        <div class="card-header bg-info text-dark">
            <h5 class="mb-0">
                <i class="bi bi-file-earmark-code"></i> SCSI INQUIRY Response Data
            </h5>
        </div>
        <div class="card-body">
            <div class="bg-black p-4 rounded border border-secondary"
                 style="font-family: 'Courier New', monospace; font-size: 0.9rem; overflow-x: auto;">
                <SpectreMarkup Content="@Decoders.SCSI.Inquiry.Prettify(_model?.InquiryData)" />
            </div>
        </div>
    </div>
</div>

