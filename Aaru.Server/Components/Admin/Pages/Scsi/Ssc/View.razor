@page "/admin/scsi/ssc"
@attribute [Authorize]
@layout AdminLayout
@rendermode InteractiveServer

@inject Microsoft.EntityFrameworkCore.IDbContextFactory<DbContext> DbContextFactory

<PageTitle>SCSI SSC Features</PageTitle>

@if(!_initialized)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
        <div class="text-center">
            <div class="spinner-border text-info" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <h3 class="mt-3 text-light">Loading SCSI SSC features...</h3>
        </div>
    </div>

    return;
}

<div class="container-fluid px-4 py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1 text-light">
                <i class="bi bi-cassette text-info"></i> SCSI SSC Features
            </h1>
            <p class="text-secondary mb-0">Manage SCSI Sequential Access (tape drive) device features</p>
        </div>
    </div>

    <!-- Search and Filter Bar -->
    <div class="card bg-dark shadow-sm mb-4 border-secondary">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-secondary text-light border-secondary">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               class="form-control bg-dark text-light border-secondary"
                               placeholder="Search by block length or granularity..."
                               @bind="_searchTerm"
                               @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-md-6 text-end">
                    <span class="badge bg-info text-dark fs-6 py-2 px-3">
                        <i class="bi bi-database"></i> Total: @FilteredItems.Count() / @_items.Count
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Duplicates Warning -->
    @if(_duplicates.Count > 0)
    {
        <div class="alert alert-warning bg-dark border-warning text-light alert-dismissible fade show shadow-sm mb-4"
             role="alert">
            <div class="d-flex align-items-start">
                <i class="bi bi-exclamation-triangle-fill text-warning fs-4 me-3"></i>
                <div class="flex-grow-1">
                    <h5 class="alert-heading mb-2 text-warning">Duplicate SSC Entries Detected</h5>
                    <p class="mb-2 text-light">Found <strong class="text-warning">@_duplicates.Count</strong> duplicate
                                               SCSI SSC entries that can be consolidated:</p>
                    <ul class="mb-3 text-light">
                        @foreach(SscModel item in _duplicates)
                        {
                            <li>Min: @item.MinBlockLength, Max: @item.MaxBlockLength,
                                Granularity: @item.BlockSizeGranularity</li>
                        }
                    </ul>
                    <button type="button"
                            class="btn btn-warning text-dark btn-sm"
                            @onclick="ConsolidateDuplicatesAsync">
                        <i class="bi bi-diagram-3"></i> Consolidate Duplicates
                    </button>
                </div>
            </div>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Data Table -->
    <div class="card bg-dark shadow-sm border-secondary">
        <div class="card-header bg-info text-dark">
            <h5 class="mb-0">
                <i class="bi bi-list-ul"></i> SSC Feature Database
            </h5>
        </div>
        <div class="card-body p-0">
            @if(FilteredItems.Any())
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover table-striped mb-0">
                        <thead class="table-secondary">
                        <tr>
                            <th style="width: 80px;">
                                <i class="bi bi-hash"></i> ID
                            </th>
                            <th>
                                <i class="bi bi-rulers"></i> Min Block Length
                            </th>
                            <th>
                                <i class="bi bi-arrows-expand"></i> Max Block Length
                            </th>
                            <th>
                                <i class="bi bi-grid-3x3"></i> Block Size Granularity
                            </th>
                            <th style="width: 120px;" class="text-center">
                                <i class="bi bi-gear"></i> Actions
                            </th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach(Ssc item in FilteredItems)
                        {
                            <tr>
                                <td class="align-middle">
                                    <span class="badge bg-info text-dark text-center"
                                          style="min-width: 60px; display: inline-block;">@item.Id</span>
                                </td>
                                <td class="align-middle">
                                    <span class="badge bg-primary">@item.MinBlockLength bytes</span>
                                </td>
                                <td class="align-middle">
                                    <span class="badge bg-success">@item.MaxBlockLength bytes</span>
                                </td>
                                <td class="align-middle">
                                    @if(item.BlockSizeGranularity != null)
                                    {
                                        <span class="badge bg-secondary">@item.BlockSizeGranularity bytes</span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">-</span>
                                    }
                                </td>
                                <td class="align-middle text-center">
                                    <button type="button" class="btn btn-outline-danger btn-sm"
                                            @onclick="async () => await ShowDeleteModal(item.Id)"
                                            title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox text-secondary" style="font-size: 4rem;"></i>
                    <h4 class="text-secondary mt-3">No SCSI SSC features found</h4>
                    <p class="text-secondary">@(string.IsNullOrWhiteSpace(_searchTerm) ? "No data available" : "Try adjusting your search criteria")</p>
                </div>
            }
        </div>
    </div>
</div>

<BlazorBootstrap.Modal @ref="_consolidateModal"
                       Title="Consolidate Duplicates"
                       Size="ModalSize.Small"
                       IsVerticallyCentered="true">
    <BodyTemplate>
        <div class="text-warning bg-dark p-3 rounded border border-warning">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            Are you sure you want to delete the duplicate SCSI SSC entries?
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <button type="button" class="btn btn-secondary" @onclick="HideConsolidateModalAsync">
            <i class="bi bi-x-circle"></i> Cancel
        </button>
        <button type="button" class="btn btn-danger" @onclick="ConfirmConsolidateAsync">
            <i class="bi bi-trash"></i> Delete Duplicates
        </button>
    </FooterTemplate>
</BlazorBootstrap.Modal>

<BlazorBootstrap.Modal @ref="_deleteModal"
                       Title="Delete SCSI SSC"
                       Size="ModalSize.Small"
                       IsVerticallyCentered="true">
    <BodyTemplate>
        <div class="text-danger bg-dark p-3 rounded border border-danger">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            Are you sure you want to delete this SCSI SSC entry?
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <button type="button" class="btn btn-secondary" @onclick="HideDeleteModal">
            <i class="bi bi-x-circle"></i> Cancel
        </button>
        <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">
            <i class="bi bi-trash"></i> Delete
        </button>
    </FooterTemplate>
</BlazorBootstrap.Modal>

