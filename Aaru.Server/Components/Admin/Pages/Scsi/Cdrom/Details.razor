@page "/admin/scsi/cdrom/{id:int}"
@using Aaru.Decoders.SCSI
@attribute [Authorize]
@layout AdminLayout
@rendermode InteractiveServer

@inject Microsoft.EntityFrameworkCore.IDbContextFactory<DbContext> DbContextFactory

<PageTitle>SCSI CD-ROM Capabilities</PageTitle>

@if(!_initialized)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
        <div class="text-center">
            <div class="spinner-border text-info" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <h3 class="mt-3 text-light">Loading SCSI CD-ROM capabilities...</h3>
        </div>
    </div>

    return;
}

<div class="container-fluid px-4 py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1 text-light">
                <i class="bi bi-disc text-info"></i> SCSI CD-ROM Capabilities
            </h1>
            <p class="text-secondary mb-0">
                <span class="badge bg-info text-dark me-2"
                      style="min-width: 60px; display: inline-block;">ID: @Id</span>
                <span class="text-light">MODE SENSE Page 2Ah Data</span>
            </p>
        </div>
        <div>
            <a href="/admin/scsi/cdrom" class="btn btn-secondary">
                <i class="bi bi-arrow-left-circle"></i> Back to List
            </a>
        </div>
    </div>

    <!-- Capabilities Data Card -->
    <div class="card bg-dark shadow-sm border-secondary">
        <div class="card-header bg-info text-dark">
            <h5 class="mb-0">
                <i class="bi bi-file-earmark-code"></i> CD-ROM Capabilities Data
            </h5>
        </div>
        <div class="card-body">
            <div class="bg-black p-4 rounded border border-secondary"
                 style="font-family: 'Courier New', monospace; font-size: 0.9rem; overflow-x: auto;">
                <SpectreMarkup Content="@Modes.PrettifyModePage_2A(_model?.ModeSense2AData)" />
            </div>
        </div>
    </div>

    <!-- Information Card -->
    <div class="card bg-dark shadow-sm border-secondary mt-4">
        <div class="card-header bg-secondary text-light">
            <h6 class="mb-0">
                <i class="bi bi-info-circle"></i> About MODE SENSE Page 2Ah
            </h6>
        </div>
        <div class="card-body">
            <p class="text-light mb-2"><strong>SCSI CD-ROM Capabilities and Mechanical Status</strong></p>
            <p class="text-secondary small mb-0">
                MODE SENSE Page 2Ah (CD-ROM Capabilities and Mechanical Status Page) contains information about
                the CD-ROM drive's capabilities, including supported read/write modes, audio features, loading
                mechanism,
                and various technical parameters. This page is specific to SCSI CD-ROM and optical disc drives.
            </p>
        </div>
    </div>
</div>

