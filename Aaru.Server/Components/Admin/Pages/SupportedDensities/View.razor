@page "/admin/supported-densities"
@attribute [Authorize]
@layout AdminLayout
@rendermode InteractiveServer

@inject Microsoft.EntityFrameworkCore.IDbContextFactory<DbContext> DbContextFactory

<PageTitle>Supported Densities</PageTitle>

@if(!_initialized)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
        <div class="text-center">
            <div class="spinner-border text-info" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <h3 class="mt-3 text-light">Loading supported densities...</h3>
        </div>
    </div>

    return;
}

<div class="container-fluid px-4 py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1 text-light">
                <i class="bi bi-cassette text-info"></i> Supported Densities
            </h1>
            <p class="text-secondary mb-0">Manage tape drive density codes and specifications</p>
        </div>
    </div>

    <!-- Search and Filter Bar -->
    <div class="card bg-dark shadow-sm mb-4 border-secondary">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-secondary text-light border-secondary">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               class="form-control bg-dark text-light border-secondary"
                               placeholder="Search by organization, name, description, or codes..."
                               @bind="_searchTerm"
                               @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-md-6 text-end">
                    <span class="badge bg-info text-dark fs-6 py-2 px-3">
                        <i class="bi bi-database"></i> Total: @FilteredItems.Count() / @_items.Count
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Table -->
    <div class="card bg-dark shadow-sm border-secondary">
        <div class="card-header bg-info text-dark">
            <h5 class="mb-0">
                <i class="bi bi-list-ul"></i> Density Code Database
            </h5>
        </div>
        <div class="card-body p-0">
            @if(FilteredItems.Any())
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover table-striped mb-0">
                        <thead class="table-secondary">
                        <tr>
                            <th style="width: 80px;">
                                <i class="bi bi-hash"></i> ID
                            </th>
                            <th style="width: 120px;">
                                <i class="bi bi-building"></i> Organization
                            </th>
                            <th>
                                <i class="bi bi-tag"></i> Name
                            </th>
                            <th>
                                <i class="bi bi-file-text"></i> Description
                            </th>
                            <th style="width: 110px;">
                                <i class="bi bi-hdd-stack"></i> Capacity
                            </th>
                            <th style="width: 90px;" class="text-center">
                                <i class="bi bi-1-circle"></i> Primary
                            </th>
                            <th style="width: 100px;" class="text-center">
                                <i class="bi bi-2-circle"></i> Secondary
                            </th>
                            <th style="width: 100px;">
                                <i class="bi bi-rulers"></i> Bits/mm
                            </th>
                            <th style="width: 90px;">
                                <i class="bi bi-arrows-expand"></i> Width
                            </th>
                            <th style="width: 80px;">
                                <i class="bi bi-list-ol"></i> Tracks
                            </th>
                            <th style="width: 90px;" class="text-center" title="Default Density">
                                <i class="bi bi-star"></i> Default
                            </th>
                            <th style="width: 90px;" class="text-center" title="Writable">
                                <i class="bi bi-pencil"></i> Write
                            </th>
                            <th style="width: 90px;" class="text-center" title="Duplicate">
                                <i class="bi bi-files"></i> Dup
                            </th>
                            <th style="width: 120px;" class="text-center">
                                <i class="bi bi-gear"></i> Actions
                            </th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach(SupportedDensity item in FilteredItems)
                        {
                            <tr>
                                <td class="align-middle">
                                    <span class="badge bg-info text-dark text-center"
                                          style="min-width: 60px; display: inline-block;">@item.Id</span>
                                </td>
                                <td class="align-middle">
                                    <strong class="text-light">@item.Organization</strong>
                                </td>
                                <td class="align-middle">
                                    <strong class="text-light">@item.Name</strong>
                                </td>
                                <td class="align-middle">
                                    <small class="text-secondary">@item.Description</small>
                                </td>
                                <td class="align-middle">
                                    @if(item.Capacity != null)
                                    {
                                        <span class="badge bg-primary">@item.Capacity</span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">-</span>
                                    }
                                </td>
                                <td class="align-middle text-center">
                                    @if(item.PrimaryCode != null)
                                    {
                                        <span class="badge bg-success">0x@(item.PrimaryCode.ToString("X2"))</span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">-</span>
                                    }
                                </td>
                                <td class="align-middle text-center">
                                    @if(item.SecondaryCode != null)
                                    {
                                        <span class="badge bg-warning text-dark">0x@(item.SecondaryCode.ToString("X2"))</span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">-</span>
                                    }
                                </td>
                                <td class="align-middle">
                                    @if(item.BitsPerMm != null)
                                    {
                                        <code class="text-info">@item.BitsPerMm</code>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">-</span>
                                    }
                                </td>
                                <td class="align-middle">
                                    @if(item.Width != null)
                                    {
                                        <code class="text-info">@item.Width</code>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">-</span>
                                    }
                                </td>
                                <td class="align-middle">
                                    @if(item.Tracks != null)
                                    {
                                        <code class="text-info">@item.Tracks</code>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">-</span>
                                    }
                                </td>
                                <td class="align-middle text-center">
                                    @if(item.DefaultDensity)
                                    {
                                        <i class="bi bi-star-fill text-warning" title="Default density"></i>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">-</span>
                                    }
                                </td>
                                <td class="align-middle text-center">
                                    @if(item.Writable)
                                    {
                                        <i class="bi bi-check-circle-fill text-success" title="Writable"></i>
                                    }
                                    else if(!item.Writable)
                                    {
                                        <i class="bi bi-x-circle-fill text-danger" title="Read-only"></i>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">-</span>
                                    }
                                </td>
                                <td class="align-middle text-center">
                                    @if(item.Duplicate)
                                    {
                                        <i class="bi bi-files text-warning" title="Duplicate"></i>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">-</span>
                                    }
                                </td>
                                <td class="align-middle text-center">
                                    <button type="button" class="btn btn-outline-danger btn-sm"
                                            @onclick="async () => await ShowDeleteModal(item.Id)"
                                            title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox text-secondary" style="font-size: 4rem;"></i>
                    <h4 class="text-secondary mt-3">No supported densities found</h4>
                    <p class="text-secondary">@(string.IsNullOrWhiteSpace(_searchTerm) ? "No data available" : "Try adjusting your search criteria")</p>
                </div>
            }
        </div>
    </div>
</div>

<BlazorBootstrap.Modal @ref="_deleteModal"
                       Title="Delete Supported Density"
                       Size="ModalSize.Small"
                       IsVerticallyCentered="true">
    <BodyTemplate>
        <div class="text-danger bg-dark p-3 rounded border border-danger">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            Are you sure you want to delete this supported density?
        </div>
    </BodyTemplate>
    <FooterTemplate>
        <button type="button" class="btn btn-secondary" @onclick="HideDeleteModal">
            <i class="bi bi-x-circle"></i> Cancel
        </button>
        <button type="button" class="btn btn-danger" @onclick="ConfirmDelete">
            <i class="bi bi-trash"></i> Delete
        </button>
    </FooterTemplate>
</BlazorBootstrap.Modal>

