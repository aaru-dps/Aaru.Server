@page "/admin/filesystems"
@attribute [Authorize]
@layout AdminLayout
@rendermode InteractiveServer

@inject Microsoft.EntityFrameworkCore.IDbContextFactory<DbContext> DbContextFactory

<PageTitle>Filesystems</PageTitle>

@if(!_initialized)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
        <div class="text-center">
            <div class="spinner-border text-info" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <h3 class="mt-3 text-light">Loading filesystems...</h3>
        </div>
    </div>

    return;
}

<div class="container-fluid px-4 py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1 text-light">
                <i class="bi bi-folder2-open text-info"></i> Filesystems
            </h1>
            <p class="text-secondary mb-0">Manage filesystem type database</p>
        </div>
    </div>

    <!-- Search and Filter Bar -->
    <div class="card bg-dark shadow-sm mb-4 border-secondary">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-secondary text-light border-secondary">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               class="form-control bg-dark text-light border-secondary"
                               placeholder="Search by filesystem name or count..."
                               @bind="_searchTerm"
                               @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-md-6 text-end">
                    <span class="badge bg-info text-dark fs-6 py-2 px-3">
                        <i class="bi bi-database"></i> Total: @FilteredItems.Count() / @_items.Count
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Data Table -->
    <div class="card bg-dark shadow-sm border-secondary">
        <div class="card-header bg-info text-dark">
            <h5 class="mb-0">
                <i class="bi bi-list-ul"></i> Filesystem Database
            </h5>
        </div>
        <div class="card-body p-0">
            @if(FilteredItems.Any())
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover table-striped mb-0">
                        <thead class="table-secondary">
                        <tr>
                            <th>
                                <i class="bi bi-folder2-open"></i> Filesystem Name
                            </th>
                            <th style="width: 120px;">
                                <i class="bi bi-collection"></i> Count
                            </th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach(Filesystem item in FilteredItems)
                        {
                            <tr>
                                <td class="align-middle">
                                    <strong class="text-light">@item.Name</strong>
                                </td>
                                <td class="align-middle">
                                    <span class="badge bg-primary text-center" style="min-width: 80px; display: inline-block;">@item.Count</span>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox text-secondary" style="font-size: 4rem;"></i>
                    <h4 class="text-secondary mt-3">No filesystems found</h4>
                    <p class="text-secondary">@(string.IsNullOrWhiteSpace(_searchTerm) ? "No data available" : "Try adjusting your search criteria")</p>
                </div>
            }
        </div>
    </div>
</div>

