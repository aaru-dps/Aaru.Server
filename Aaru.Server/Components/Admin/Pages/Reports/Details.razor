@page "/admin/reports/{id:int}"
@attribute [Authorize]
@layout AdminLayout
@rendermode InteractiveServer

@inject Microsoft.EntityFrameworkCore.IDbContextFactory<DbContext> DbContextFactory

<PageTitle>Uploaded Report Details</PageTitle>

@if(!_initialized)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
        <div class="text-center">
            <div class="spinner-border text-info" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <h3 class="mt-3 text-light">Loading uploaded report...</h3>
        </div>
    </div>

    return;
}

@if(_model?.Report == null)
{
    <div class="container-fluid px-4 py-4">
        <div class="alert alert-danger bg-dark border-danger text-light" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Error:</strong> Uploaded report not found.
        </div>
        <a href="/admin/reports" class="btn btn-secondary">
            <i class="bi bi-arrow-left-circle"></i> Back to List
        </a>
    </div>

    return;
}

<div class="container-fluid px-4 py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1 text-light">
                <i class="bi bi-file-earmark-arrow-up text-info"></i> Uploaded Report Details
            </h1>
            <p class="text-secondary mb-0">
                <span class="badge bg-info text-dark me-2"
                      style="min-width: 60px; display: inline-block;">ID: @_model.Report?.Id</span>
                <strong class="text-light">@_model.Report?.Manufacturer @_model.Report?.Model</strong>
                <span class="text-secondary ms-2">Rev: @_model.Report?.Revision</span>
            </p>
        </div>
        <div>
            <a href="/admin/reports/edit/@_model.Report?.Id" class="btn btn-warning me-2">
                <i class="bi bi-pencil"></i> Edit
            </a>
            <a href="/admin/reports" class="btn btn-secondary">
                <i class="bi bi-arrow-left-circle"></i> Back to List
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left Column - Report Information -->
        <div class="col-lg-6">
            <!-- Report Information Card -->
            <div class="card bg-dark shadow-sm border-secondary mb-4">
                <div class="card-header bg-info text-dark">
                    <h5 class="mb-0">
                        <i class="bi bi-info-circle"></i> Report Information
                    </h5>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-5 text-secondary">
                            <i class="bi bi-building"></i> Manufacturer
                        </dt>
                        <dd class="col-sm-7 text-light">
                            <strong>@_model.Report?.Manufacturer</strong>
                        </dd>

                        <dt class="col-sm-5 text-secondary">
                            <i class="bi bi-device-hdd"></i> Model
                        </dt>
                        <dd class="col-sm-7 text-light">
                            <strong>@_model.Report?.Model</strong>
                        </dd>

                        <dt class="col-sm-5 text-secondary">
                            <i class="bi bi-code-square"></i> Revision
                        </dt>
                        <dd class="col-sm-7 text-light">
                            <code class="text-info">@_model.Report?.Revision</code>
                        </dd>

                        <dt class="col-sm-5 text-secondary">
                            <i class="bi bi-tag"></i> Type
                        </dt>
                        <dd class="col-sm-7">
                            <span class="badge bg-primary">@_model.Report?.Type</span>
                        </dd>

                        <dt class="col-sm-5 text-secondary">
                            <i class="bi bi-sd-card"></i> Compact Flash
                        </dt>
                        <dd class="col-sm-7">
                            @if(_model.Report?.CompactFlash == true)
                            {
                                <i class="bi bi-check-circle-fill text-success"></i>
                                <span class="text-success">Yes</span>
                            }
                            else
                            {
                                <i class="bi bi-x-circle-fill text-danger"></i>
                                <span class="text-danger">No</span>
                            }
                        </dd>

                        <dt class="col-sm-5 text-secondary">
                            <i class="bi bi-calendar-plus"></i> Uploaded When
                        </dt>
                        <dd class="col-sm-7 text-light">
                            @_model.Report?.UploadedWhen.ToString("g")
                        </dd>
                    </dl>
                </div>
            </div>

            <!-- Related Reports Card -->
            <div class="card bg-dark shadow-sm border-secondary">
                <div class="card-header bg-secondary text-light">
                    <h6 class="mb-0">
                        <i class="bi bi-link-45deg"></i> Promote to Device Report
                    </h6>
                </div>
                <div class="card-body">
                    <button @onclick="Promote" class="btn btn-outline-info w-100">
                        <i class="bi bi-arrow-up-circle"></i> Promote This Report
                    </button>
                    <small class="text-secondary d-block mt-2">Convert this uploaded report to an official device report
                                                               in the database</small>
                </div>
            </div>
        </div>

        <!-- Right Column - Related Data Links -->
        <div class="col-lg-6">
            <!-- Capability Reports Card -->
            <div class="card bg-dark shadow-sm border-secondary mb-4">
                <div class="card-header bg-info text-dark">
                    <h5 class="mb-0">
                        <i class="bi bi-diagram-3"></i> Capability Reports
                    </h5>
                </div>
                <div class="card-body">
                    @if(_model.ReadCapabilitiesId != 0)
                    {
                        <div class="mb-2">
                            <a href="/admin/tested-media/@_model.ReadCapabilitiesId"
                               target="_blank"
                               class="btn btn-outline-info btn-sm w-100">
                                <i class="bi bi-eye"></i> Read Capabilities Report
                            </a>
                        </div>
                    }
                    @if(_model.Report?.ATA != null)
                    {
                        <div class="mb-2">
                            <a href="/admin/ata/@_model.Report.ATA.Id"
                               target="_blank"
                               class="btn btn-outline-info btn-sm w-100">
                                <i class="bi bi-eye"></i> ATA Report
                            </a>
                        </div>
                    }
                    @if(_model.Report?.ATAPI != null)
                    {
                        <div class="mb-2">
                            <a href="/admin/ata/@_model.Report.ATAPI.Id"
                               target="_blank"
                               class="btn btn-outline-info btn-sm w-100">
                                <i class="bi bi-eye"></i> ATAPI Report
                            </a>
                        </div>
                    }
                    @if(_model.Report?.SCSI != null)
                    {
                        <div class="mb-2">
                            <a href="/admin/scsi/@_model.Report.SCSI.Id"
                               target="_blank"
                               class="btn btn-outline-info btn-sm w-100">
                                <i class="bi bi-eye"></i> SCSI Report
                            </a>
                        </div>
                    }
                    @if(_model.Report?.MultiMediaCard != null)
                    {
                        <div class="mb-2">
                            <a href="/admin/mmc-sd/@_model.Report.MultiMediaCard.Id"
                               target="_blank"
                               class="btn btn-outline-info btn-sm w-100">
                                <i class="bi bi-eye"></i> MultiMediaCard Report
                            </a>
                        </div>
                    }
                    @if(_model.Report?.SecureDigital != null)
                    {
                        <div class="mb-2">
                            <a href="/admin/mmc-sd/@_model.Report.SecureDigital.Id"
                               target="_blank"
                               class="btn btn-outline-info btn-sm w-100">
                                <i class="bi bi-eye"></i> SecureDigital Report
                            </a>
                        </div>
                    }
                    @if(_model.Report?.USB != null)
                    {
                        <div class="mb-2">
                            <a href="/admin/usb/devices/@_model.Report.USB.Id"
                               target="_blank"
                               class="btn btn-outline-info btn-sm w-100">
                                <i class="bi bi-eye"></i> USB Report
                            </a>
                        </div>
                    }
                    @if(_model.Report?.GdRomSwapDiscCapabilitiesId != null)
                    {
                        <div class="mb-2">
                            <a href="/admin/gdrom/@_model.Report.GdRomSwapDiscCapabilitiesId"
                               target="_blank"
                               class="btn btn-outline-info btn-sm w-100">
                                <i class="bi bi-eye"></i> GD-ROM Swap-Trick Report
                            </a>
                        </div>
                    }
                    @if(_model.Report?.FireWire != null)
                    {
                        <div class="text-secondary small mt-2">
                            <i class="bi bi-exclamation-circle"></i> Contains FireWire data
                        </div>
                    }
                    @if(_model.Report?.PCMCIA != null)
                    {
                        <div class="text-secondary small">
                            <i class="bi bi-exclamation-circle"></i> Contains PCMCIA data
                        </div>
                    }
                    @if(_model.ReadCapabilitiesId == 0 && _model.Report?.ATA == null && _model.Report?.ATAPI == null && _model.Report?.SCSI == null && _model.Report?.MultiMediaCard == null && _model.Report?.SecureDigital == null && _model.Report?.USB == null && _model.Report?.GdRomSwapDiscCapabilitiesId == null)
                    {
                        <p class="text-secondary mb-0">No capability reports available</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Similar Reports Section -->
    @if(_model.SameAll.Count > 0 || _model.SameButManufacturer.Count > 0 || _model.ReportAll.Count > 0 || _model.ReportButManufacturer.Count > 0)
    {
        <div class="card bg-dark shadow-sm border-secondary mt-4">
            <div class="card-header bg-secondary text-light">
                <h6 class="mb-0">
                    <i class="bi bi-files"></i> Similar Reports
                </h6>
            </div>
            <div class="card-body">
                @if(_model.SameAll.Count > 0)
                {
                    <div class="mb-4">
                        <h6 class="text-light mb-3">
                            <i class="bi bi-match"></i> Same Manufacturer, Model & Revision
                        </h6>
                        <div class="table-responsive">
                            <table class="table table-dark table-hover table-striped mb-0">
                                <thead class="table-secondary">
                                <tr>
                                    <th style="width: 80px;"><i class="bi bi-hash"></i> ID</th>
                                    <th><i class="bi bi-gear"></i> Actions</th>
                                </tr>
                                </thead>
                                <tbody>
                                @foreach(int item in _model.SameAll)
                                {
                                    <tr>
                                        <td class="align-middle">
                                            <span class="badge bg-info text-dark">@item</span>
                                        </td>
                                        <td class="align-middle">
                                            <a href="/admin/reports/@item"
                                               class="btn btn-outline-info btn-sm me-1"
                                               target="_blank">
                                                <i class="bi bi-eye"></i> View
                                            </a>
                                            <button type="button"
                                                    @onclick="() => Merge(_model.Report?.Id, item)"
                                                    class="btn btn-outline-secondary btn-sm">
                                                <i class="bi bi-arrow-left-right"></i> Merge
                                            </button>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                @if(_model.SameButManufacturer.Count > 0)
                {
                    <div class="mb-4">
                        <h6 class="text-light mb-3">
                            <i class="bi bi-diagram-2"></i> Same Model & Revision (Different Manufacturer)
                        </h6>
                        <div class="table-responsive">
                            <table class="table table-dark table-hover table-striped mb-0">
                                <thead class="table-secondary">
                                <tr>
                                    <th style="width: 80px;"><i class="bi bi-hash"></i> ID</th>
                                    <th><i class="bi bi-gear"></i> Actions</th>
                                </tr>
                                </thead>
                                <tbody>
                                @foreach(int item in _model.SameButManufacturer)
                                {
                                    <tr>
                                        <td class="align-middle">
                                            <span class="badge bg-info text-dark">@item</span>
                                        </td>
                                        <td class="align-middle">
                                            <a href="/admin/reports/@item"
                                               class="btn btn-outline-info btn-sm me-1"
                                               target="_blank">
                                                <i class="bi bi-eye"></i> View
                                            </a>
                                            <button type="button"
                                                    @onclick="() => Merge(_model.Report?.Id, item)"
                                                    class="btn btn-outline-secondary btn-sm">
                                                <i class="bi bi-arrow-left-right"></i> Merge
                                            </button>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                @if(_model.ReportAll.Count > 0)
                {
                    <div class="mb-4">
                        <h6 class="text-light mb-3">
                            <i class="bi bi-circuit-board"></i> Device Reports (Same Device)
                        </h6>
                        <div class="table-responsive">
                            <table class="table table-dark table-hover table-striped mb-0">
                                <thead class="table-secondary">
                                <tr>
                                    <th style="width: 80px;"><i class="bi bi-hash"></i> ID</th>
                                    <th><i class="bi bi-gear"></i> Actions</th>
                                </tr>
                                </thead>
                                <tbody>
                                @foreach(int item in _model.ReportAll)
                                {
                                    <tr>
                                        <td class="align-middle">
                                            <span class="badge bg-info text-dark">@item</span>
                                        </td>
                                        <td class="align-middle">
                                            <a href="/admin/devices/@item"
                                               class="btn btn-outline-info btn-sm me-1"
                                               target="_blank">
                                                <i class="bi bi-eye"></i> View
                                            </a>
                                            <button type="button"
                                                    @onclick="() => MergeReports(item, _model.Report?.Id)"
                                                    class="btn btn-outline-secondary btn-sm">
                                                <i class="bi bi-arrow-left-right"></i> Merge
                                            </button>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
                @if(_model.ReportButManufacturer.Count > 0)
                {
                    <div class="mb-0">
                        <h6 class="text-light mb-3">
                            <i class="bi bi-circuit-board"></i> Device Reports (Similar Device)
                        </h6>
                        <div class="table-responsive">
                            <table class="table table-dark table-hover table-striped mb-0">
                                <thead class="table-secondary">
                                <tr>
                                    <th style="width: 80px;"><i class="bi bi-hash"></i> ID</th>
                                    <th><i class="bi bi-gear"></i> Actions</th>
                                </tr>
                                </thead>
                                <tbody>
                                @foreach(int item in _model.ReportButManufacturer)
                                {
                                    <tr>
                                        <td class="align-middle">
                                            <span class="badge bg-info text-dark">@item</span>
                                        </td>
                                        <td class="align-middle">
                                            <a href="/admin/devices/@item"
                                               class="btn btn-outline-info btn-sm me-1"
                                               target="_blank">
                                                <i class="bi bi-eye"></i> View
                                            </a>
                                            <button type="button"
                                                    @onclick="() => MergeReports(item, _model.Report?.Id)"
                                                    class="btn btn-outline-secondary btn-sm">
                                                <i class="bi bi-arrow-left-right"></i> Merge
                                            </button>
                                        </td>
                                    </tr>
                                }
                                </tbody>
                            </table>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Tested Media Section -->
    @if(_model.TestedMedias.Count > 0 || _model.TestedSequentialMedias.Count > 0)
    {
        <div class="card bg-dark shadow-sm border-secondary mt-4">
            <div class="card-header bg-secondary text-light">
                <h6 class="mb-0">
                    <i class="bi bi-database-check"></i> Associated Tested Media
                </h6>
            </div>
            <div class="card-body p-0">
                @if(_model.TestedMedias.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-dark table-hover table-striped mb-0">
                            <thead class="table-secondary">
                            <tr>
                                <th><i class="bi bi-building"></i> Manufacturer</th>
                                <th><i class="bi bi-device-hdd"></i> Model</th>
                                <th><i class="bi bi-disc"></i> Media Type</th>
                                <th style="width: 100px;" class="text-center"><i class="bi bi-gear"></i> Actions</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach(TestedMedia item in _model.TestedMedias)
                            {
                                <tr>
                                    <td class="align-middle">
                                        <strong class="text-light">@item.Manufacturer</strong>
                                    </td>
                                    <td class="align-middle">
                                        <strong class="text-light">@item.Model</strong>
                                    </td>
                                    <td class="align-middle">
                                        <span class="badge bg-primary">@item.MediumTypeName</span>
                                    </td>
                                    <td class="align-middle text-center">
                                        <a href="/admin/tested-media/@item.Id"
                                           class="btn btn-outline-info btn-sm"
                                           target="_blank">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
                @if(_model.TestedSequentialMedias.Count > 0)
                {
                    <div class="table-responsive">
                        <table class="table table-dark table-hover table-striped mb-0">
                            <thead class="table-secondary">
                            <tr>
                                <th><i class="bi bi-building"></i> Manufacturer</th>
                                <th><i class="bi bi-device-hdd"></i> Model</th>
                                <th><i class="bi bi-cassette-fill"></i> Media Type</th>
                                <th style="width: 100px;" class="text-center"><i class="bi bi-gear"></i> Actions</th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach(TestedSequentialMedia item in _model.TestedSequentialMedias)
                            {
                                <tr>
                                    <td class="align-middle">
                                        <strong class="text-light">@item.Manufacturer</strong>
                                    </td>
                                    <td class="align-middle">
                                        <strong class="text-light">@item.Model</strong>
                                    </td>
                                    <td class="align-middle">
                                        <span class="badge bg-warning text-dark">@item.MediumTypeName</span>
                                    </td>
                                    <td class="align-middle text-center">
                                        <a href="/admin/tested-media/sequential/edit/@item.Id"
                                           class="btn btn-outline-info btn-sm"
                                           target="_blank">
                                            <i class="bi bi-eye"></i> View
                                        </a>
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

