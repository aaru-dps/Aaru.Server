@page "/admin/device-stats/edit/{Id:int}"
@attribute [Authorize]
@layout AdminLayout
@rendermode InteractiveServer

@inject Microsoft.EntityFrameworkCore.IDbContextFactory<DbContext> DbContextFactory

<PageTitle>Edit Device Statistic</PageTitle>

@if(!isLoaded)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
        <div class="text-center">
            <div class="spinner-border text-info" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <h3 class="mt-3 text-light">Loading device statistic...</h3>
        </div>
    </div>
}
else if(deviceStat == null)
{
    <div class="container-fluid px-4 py-4">
        <div class="alert alert-danger bg-dark border-danger text-light" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Error:</strong> Device statistic not found.
        </div>
        <a href="/admin/device-stats" class="btn btn-secondary">
            <i class="bi bi-arrow-left-circle"></i> Back to List
        </a>
    </div>
}
else
{
    <div class="container-fluid px-4 py-4">
        <!-- Header Section -->
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="h2 mb-1 text-light">
                    <i class="bi bi-pencil-square text-info"></i> Edit Device Statistic
                </h1>
                <p class="text-secondary mb-0">
                    <span class="badge bg-info text-dark me-2"
                          style="min-width: 60px; display: inline-block;">ID: @Id</span>
                    <span class="text-light">@deviceStat.Manufacturer @deviceStat.Model</span>
                </p>
            </div>
            <div>
                <button type="button" class="btn btn-secondary" @onclick="GoBack">
                    <i class="bi bi-x-circle"></i> Cancel
                </button>
            </div>
        </div>

        <!-- Edit Form Card -->
        <div class="card bg-dark shadow-sm border-secondary">
            <div class="card-header bg-info text-dark">
                <h5 class="mb-0">
                    <i class="bi bi-file-earmark-text"></i> Device Statistics Information
                </h5>
            </div>
            <div class="card-body">
                <EditForm Model="deviceStat" OnValidSubmit="HandleValidSubmit">
                    <DataAnnotationsValidator />

                    <div class="row g-4">
                        <!-- Left Column -->
                        <div class="col-md-6">
                            <!-- Manufacturer -->
                            <div class="mb-3">
                                <label class="form-label text-light">
                                    <i class="bi bi-building"></i> Manufacturer
                                    <span class="text-danger">*</span>
                                </label>
                                <InputText class="form-control bg-dark text-light border-secondary"
                                           @bind-Value="deviceStat.Manufacturer"
                                           placeholder="Enter manufacturer name..." />
                                <ValidationMessage For="@(() => deviceStat.Manufacturer)"
                                                   class="text-danger small mt-1" />
                            </div>

                            <!-- Model -->
                            <div class="mb-3">
                                <label class="form-label text-light">
                                    <i class="bi bi-device-hdd"></i> Model
                                    <span class="text-danger">*</span>
                                </label>
                                <InputText class="form-control bg-dark text-light border-secondary"
                                           @bind-Value="deviceStat.Model"
                                           placeholder="Enter model name..." />
                                <ValidationMessage For="@(() => deviceStat.Model)" class="text-danger small mt-1" />
                            </div>
                        </div>

                        <!-- Right Column -->
                        <div class="col-md-6">
                            <!-- Revision -->
                            <div class="mb-3">
                                <label class="form-label text-light">
                                    <i class="bi bi-code-square"></i> Revision
                                    <span class="text-danger">*</span>
                                </label>
                                <InputText class="form-control bg-dark text-light border-secondary"
                                           @bind-Value="deviceStat.Revision"
                                           placeholder="Enter revision..." />
                                <ValidationMessage For="@(() => deviceStat.Revision)" class="text-danger small mt-1" />
                            </div>

                            <!-- Bus -->
                            <div class="mb-3">
                                <label class="form-label text-light">
                                    <i class="bi bi-diagram-3"></i> Bus
                                    <span class="text-danger">*</span>
                                </label>
                                <InputText class="form-control bg-dark text-light border-secondary"
                                           @bind-Value="deviceStat.Bus"
                                           placeholder="Enter bus type (e.g., USB, SCSI, ATA)..." />
                                <small class="text-secondary">The bus type used to connect this device</small>
                                <ValidationMessage For="@(() => deviceStat.Bus)" class="text-danger small mt-1" />
                            </div>
                        </div>
                    </div>

                    <!-- Validation Summary -->
                    <div class="row">
                        <div class="col-12">
                            <ValidationSummary class="alert alert-danger bg-dark border-danger text-light" />
                        </div>
                    </div>

                    <!-- Action Buttons -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <hr class="border-secondary mb-4" />
                            <div class="d-flex justify-content-between align-items-center">
                                <button type="button" class="btn btn-secondary" @onclick="GoBack">
                                    <i class="bi bi-arrow-left-circle"></i> Cancel & Go Back
                                </button>
                                <button type="submit" class="btn btn-info btn-lg">
                                    <i class="bi bi-check-circle"></i> Save Changes
                                </button>
                            </div>
                        </div>
                    </div>
                </EditForm>
            </div>
        </div>

        <!-- Help Card -->
        <div class="card bg-dark shadow-sm border-secondary mt-4">
            <div class="card-header bg-secondary text-light">
                <h6 class="mb-0">
                    <i class="bi bi-info-circle"></i> Help
                </h6>
            </div>
            <div class="card-body">
                <p class="text-light mb-2"><strong>About Device Statistics</strong></p>
                <p class="text-secondary small mb-0">
                    Device statistics track real-world device usage and help match user reports with known devices.
                    All fields are required to ensure accurate device identification across the database.
                </p>
            </div>
        </div>
    </div>
}
