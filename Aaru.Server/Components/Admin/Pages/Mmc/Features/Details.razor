@page "/admin/mmc/features/{id:int}"
@using System.Reflection
@attribute [Authorize]
@layout AdminLayout
@rendermode InteractiveServer

@inject Microsoft.EntityFrameworkCore.IDbContextFactory<DbContext> DbContextFactory

<PageTitle>MMC Feature Details</PageTitle>

@if(!_initialized)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
        <div class="text-center">
            <div class="spinner-border text-info" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <h3 class="mt-3 text-light">Loading MMC feature details...</h3>
        </div>
    </div>

    return;
}

<div class="container-fluid px-4 py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1 text-light">
                <i class="bi bi-gear-wide-connected text-info"></i> MMC Feature Details
            </h1>
            <p class="text-secondary mb-0">
                <span class="badge bg-info text-dark me-2"
                      style="min-width: 60px; display: inline-block;">ID: @Id</span>
                Complete MultiMedia Commands feature profile
            </p>
        </div>
        <div>
            <a href="/admin/mmc/features" class="btn btn-secondary">
                <i class="bi bi-arrow-left-circle"></i> Back to List
            </a>
        </div>
    </div>

    <!-- Key Features Summary Card -->
    <div class="card bg-dark shadow-sm border-secondary mb-4">
        <div class="card-header bg-info text-dark">
            <h5 class="mb-0">
                <i class="bi bi-star"></i> Key Capabilities Summary
            </h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <div class="p-3 bg-black rounded border border-secondary text-center">
                        <div class="mb-2">
                            @if(_model?.CanReadCD == true)
                            {
                                <i class="bi bi-check-circle-fill text-success" style="font-size: 2rem;"></i>
                            }
                            else
                            {
                                <i class="bi bi-x-circle-fill text-danger" style="font-size: 2rem;"></i>
                            }
                        </div>
                        <strong class="text-light">Read CD</strong>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-black rounded border border-secondary text-center">
                        <div class="mb-2">
                            @if(_model?.CanReadDVD == true)
                            {
                                <i class="bi bi-check-circle-fill text-success" style="font-size: 2rem;"></i>
                            }
                            else
                            {
                                <i class="bi bi-x-circle-fill text-danger" style="font-size: 2rem;"></i>
                            }
                        </div>
                        <strong class="text-light">Read DVD</strong>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-black rounded border border-secondary text-center">
                        <div class="mb-2">
                            @if(_model?.CanReadBD == true)
                            {
                                <i class="bi bi-check-circle-fill text-success" style="font-size: 2rem;"></i>
                            }
                            else
                            {
                                <i class="bi bi-x-circle-fill text-danger" style="font-size: 2rem;"></i>
                            }
                        </div>
                        <strong class="text-light">Read BD</strong>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-black rounded border border-secondary text-center">
                        <div class="mb-2">
                            @if(_model?.CanReadHDDVD == true)
                            {
                                <i class="bi bi-check-circle-fill text-success" style="font-size: 2rem;"></i>
                            }
                            else
                            {
                                <i class="bi bi-x-circle-fill text-danger" style="font-size: 2rem;"></i>
                            }
                        </div>
                        <strong class="text-light">Read HD DVD</strong>
                    </div>
                </div>
            </div>
            <div class="row g-3 mt-2">
                <div class="col-md-3">
                    <div class="p-3 bg-black rounded border border-secondary text-center">
                        <div class="mb-2">
                            @if(_model?.CanWriteCDTAO == true || _model?.CanWriteCDSAO == true)
                            {
                                <i class="bi bi-pencil-fill text-warning" style="font-size: 2rem;"></i>
                            }
                            else
                            {
                                <i class="bi bi-x-circle-fill text-danger" style="font-size: 2rem;"></i>
                            }
                        </div>
                        <strong class="text-light">Write CD</strong>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-black rounded border border-secondary text-center">
                        <div class="mb-2">
                            @if(_model?.CanWriteDVDR == true)
                            {
                                <i class="bi bi-pencil-fill text-warning" style="font-size: 2rem;"></i>
                            }
                            else
                            {
                                <i class="bi bi-x-circle-fill text-danger" style="font-size: 2rem;"></i>
                            }
                        </div>
                        <strong class="text-light">Write DVD</strong>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-black rounded border border-secondary text-center">
                        <div class="mb-2">
                            @if(_model?.CanWriteBD == true)
                            {
                                <i class="bi bi-pencil-fill text-warning" style="font-size: 2rem;"></i>
                            }
                            else
                            {
                                <i class="bi bi-x-circle-fill text-danger" style="font-size: 2rem;"></i>
                            }
                        </div>
                        <strong class="text-light">Write BD</strong>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="p-3 bg-black rounded border border-secondary text-center">
                        <div class="mb-2">
                            @if(_model?.CanWriteHDDVDR == true)
                            {
                                <i class="bi bi-pencil-fill text-warning" style="font-size: 2rem;"></i>
                            }
                            else
                            {
                                <i class="bi bi-x-circle-fill text-danger" style="font-size: 2rem;"></i>
                            }
                        </div>
                        <strong class="text-light">Write HD DVD</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Info Alert -->
    <div class="alert alert-info bg-dark border-info text-light shadow-sm mb-4" role="alert">
        <div class="d-flex align-items-start">
            <i class="bi bi-info-circle-fill text-info fs-4 me-3"></i>
            <div>
                <h6 class="alert-heading mb-2 text-info">Complete Feature Profile</h6>
                <p class="mb-0 small">
                    This page displays all 100+ MMC feature capabilities for this drive.
                    Use the accordion sections below to explore detailed capabilities by category.
                </p>
            </div>
        </div>
    </div>

    <!-- Accordion for Detailed Features -->
    <div class="accordion accordion-flush" id="featuresAccordion">

        <!-- Read Capabilities Section -->
        <div class="accordion-item bg-dark border-secondary">
            <h2 class="accordion-header">
                <button class="accordion-button bg-dark text-light border-secondary"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#readCapabilities">
                    <i class="bi bi-disc text-success me-2"></i> Read Capabilities
                </button>
            </h2>
            <div id="readCapabilities" class="accordion-collapse collapse show" data-bs-parent="#featuresAccordion">
                <div class="accordion-body bg-dark">
                    <dl class="row mb-0">
                        @RenderFeature(nameof(MmcFeatures.CanReadCD))
                        @RenderFeature(nameof(MmcFeatures.CanReadCDMRW))
                        @RenderFeature(nameof(MmcFeatures.CanReadDDCD))
                        @RenderFeature(nameof(MmcFeatures.CanReadDVD))
                        @RenderFeature(nameof(MmcFeatures.CanReadDVDPlusMRW))
                        @RenderFeature(nameof(MmcFeatures.CanReadDVDPlusR))
                        @RenderFeature(nameof(MmcFeatures.CanReadDVDPlusRDL))
                        @RenderFeature(nameof(MmcFeatures.CanReadDVDPlusRW))
                        @RenderFeature(nameof(MmcFeatures.CanReadDVDPlusRWDL))
                        @RenderFeature(nameof(MmcFeatures.CanReadBD))
                        @RenderFeature(nameof(MmcFeatures.CanReadBDR))
                        @RenderFeature(nameof(MmcFeatures.CanReadBDRE1))
                        @RenderFeature(nameof(MmcFeatures.CanReadBDRE2))
                        @RenderFeature(nameof(MmcFeatures.CanReadBDROM))
                        @RenderFeature(nameof(MmcFeatures.CanReadHDDVD))
                        @RenderFeature(nameof(MmcFeatures.CanReadHDDVDR))
                        @RenderFeature(nameof(MmcFeatures.CanReadHDDVDRAM))
                        @RenderFeature(nameof(MmcFeatures.CanReadAllDualR))
                        @RenderFeature(nameof(MmcFeatures.CanReadAllDualRW))
                        @RenderFeature(nameof(MmcFeatures.CanReadOldBDR))
                        @RenderFeature(nameof(MmcFeatures.CanReadOldBDRE))
                        @RenderFeature(nameof(MmcFeatures.CanReadOldBDROM))
                        @RenderFeature(nameof(MmcFeatures.MultiRead))
                        @RenderFeature(nameof(MmcFeatures.DVDMultiRead))
                    </dl>
                </div>
            </div>
        </div>

        <!-- Write Capabilities Section -->
        <div class="accordion-item bg-dark border-secondary">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed bg-dark text-light border-secondary"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#writeCapabilities">
                    <i class="bi bi-pencil text-warning me-2"></i> Write Capabilities
                </button>
            </h2>
            <div id="writeCapabilities" class="accordion-collapse collapse" data-bs-parent="#featuresAccordion">
                <div class="accordion-body bg-dark">
                    <dl class="row mb-0">
                        @RenderFeature(nameof(MmcFeatures.CanWriteCDMRW))
                        @RenderFeature(nameof(MmcFeatures.CanWriteCDRW))
                        @RenderFeature(nameof(MmcFeatures.CanWriteCDRWCAV))
                        @RenderFeature(nameof(MmcFeatures.CanWriteCDSAO))
                        @RenderFeature(nameof(MmcFeatures.CanWriteCDTAO))
                        @RenderFeature(nameof(MmcFeatures.CanWriteDDCDR))
                        @RenderFeature(nameof(MmcFeatures.CanWriteDDCDRW))
                        @RenderFeature(nameof(MmcFeatures.CanTestWriteDDCDR))
                        @RenderFeature(nameof(MmcFeatures.CanWriteDVDPlusMRW))
                        @RenderFeature(nameof(MmcFeatures.CanWriteDVDPlusR))
                        @RenderFeature(nameof(MmcFeatures.CanWriteDVDPlusRDL))
                        @RenderFeature(nameof(MmcFeatures.CanWriteDVDPlusRW))
                        @RenderFeature(nameof(MmcFeatures.CanWriteDVDPlusRWDL))
                        @RenderFeature(nameof(MmcFeatures.CanWriteDVDR))
                        @RenderFeature(nameof(MmcFeatures.CanWriteCSSManagedDVD))
                        @RenderFeature(nameof(MmcFeatures.CanTestWriteDVD))
                        @RenderFeature(nameof(MmcFeatures.CanWriteDVDRDL))
                        @RenderFeature(nameof(MmcFeatures.CanWriteDVDRW))
                        @RenderFeature(nameof(MmcFeatures.CanWriteBD))
                        @RenderFeature(nameof(MmcFeatures.CanWriteBDR))
                        @RenderFeature(nameof(MmcFeatures.CanWriteBDRE1))
                        @RenderFeature(nameof(MmcFeatures.CanWriteBDRE2))
                        @RenderFeature(nameof(MmcFeatures.CanWriteHDDVDR))
                        @RenderFeature(nameof(MmcFeatures.CanWriteHDDVDRAM))
                        @RenderFeature(nameof(MmcFeatures.CanWriteOldBDRE))
                        @RenderFeature(nameof(MmcFeatures.CanWritePackedSubchannelInTAO))
                        @RenderFeature(nameof(MmcFeatures.CanWriteRWSubchannelInSAO))
                        @RenderFeature(nameof(MmcFeatures.CanWriteRWSubchannelInTAO))
                        @RenderFeature(nameof(MmcFeatures.CanWriteRaw))
                        @RenderFeature(nameof(MmcFeatures.CanWriteRawMultiSession))
                        @RenderFeature(nameof(MmcFeatures.CanWriteRawSubchannelInTAO))
                        @RenderFeature(nameof(MmcFeatures.CanTestWriteInSAO))
                        @RenderFeature(nameof(MmcFeatures.CanTestWriteInTAO))
                        @RenderFeature(nameof(MmcFeatures.CanOverwriteSAOTrack))
                        @RenderFeature(nameof(MmcFeatures.CanOverwriteTAOTrack))
                        @RenderFeature(nameof(MmcFeatures.CanPseudoOverwriteBDR))
                    </dl>
                </div>
            </div>
        </div>

        <!-- Security & DRM Section -->
        <div class="accordion-item bg-dark border-secondary">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed bg-dark text-light border-secondary"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#securityFeatures">
                    <i class="bi bi-shield-lock text-warning me-2"></i> Security & DRM Features
                </button>
            </h2>
            <div id="securityFeatures" class="accordion-collapse collapse" data-bs-parent="#featuresAccordion">
                <div class="accordion-body bg-dark">
                    <dl class="row mb-0">
                        @RenderFeature(nameof(MmcFeatures.SupportsAACS))
                        @RenderFeature(nameof(MmcFeatures.AACSVersion))
                        @RenderFeature(nameof(MmcFeatures.SupportsCSS))
                        @RenderFeature(nameof(MmcFeatures.CSSVersion))
                        @RenderFeature(nameof(MmcFeatures.SupportsCPRM))
                        @RenderFeature(nameof(MmcFeatures.CPRMVersion))
                        @RenderFeature(nameof(MmcFeatures.SupportsSecurDisc))
                        @RenderFeature(nameof(MmcFeatures.SupportsOSSC))
                        @RenderFeature(nameof(MmcFeatures.SupportsVCPS))
                        @RenderFeature(nameof(MmcFeatures.SupportsBusEncryption))
                        @RenderFeature(nameof(MmcFeatures.SupportsDAP))
                        @RenderFeature(nameof(MmcFeatures.SupportsPWP))
                        @RenderFeature(nameof(MmcFeatures.SupportsSWPP))
                        @RenderFeature(nameof(MmcFeatures.SupportsWriteInhibitDCB))
                        @RenderFeature(nameof(MmcFeatures.SupportsWriteProtectPAC))
                        @RenderFeature(nameof(MmcFeatures.AGIDs))
                        @RenderFeature(nameof(MmcFeatures.BindingNonceBlocks))
                        @RenderFeature(nameof(MmcFeatures.CanGenerateBindingNonce))
                        @RenderFeature(nameof(MmcFeatures.CanReadBluBCA))
                        @RenderFeature(nameof(MmcFeatures.CanReadCPRM_MKB))
                        CanWriteBusEncryptedBlocks
                    </dl>
                </div>
            </div>
        </div>

        <!-- Format & Media Support Section -->
        <div class="accordion-item bg-dark border-secondary">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed bg-dark text-light border-secondary"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#formatSupport">
                    <i class="bi bi-file-earmark text-info me-2"></i> Format & Media Support
                </button>
            </h2>
            <div id="formatSupport" class="accordion-collapse collapse" data-bs-parent="#featuresAccordion">
                <div class="accordion-body bg-dark">
                    <dl class="row mb-0">
                        @RenderFeature(nameof(MmcFeatures.CanFormat))
                        @RenderFeature(nameof(MmcFeatures.CanFormatBDREWithoutSpare))
                        @RenderFeature(nameof(MmcFeatures.CanFormatCert))
                        @RenderFeature(nameof(MmcFeatures.CanFormatFRF))
                        @RenderFeature(nameof(MmcFeatures.CanFormatQCert))
                        @RenderFeature(nameof(MmcFeatures.CanFormatRRM))
                        @RenderFeature(nameof(MmcFeatures.CanExpandBDRESpareArea))
                        @RenderFeature(nameof(MmcFeatures.CanEraseSector))
                        @RenderFeature(nameof(MmcFeatures.SupportsHybridDiscs))
                        @RenderFeature(nameof(MmcFeatures.SupportsModePage1Ch))
                        @RenderFeature(nameof(MmcFeatures.BlocksPerReadableUnit))
                        @RenderFeature(nameof(MmcFeatures.LogicalBlockSize))
                    </dl>
                </div>
            </div>
        </div>

        <!-- Audio Features Section -->
        <div class="accordion-item bg-dark border-secondary">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed bg-dark text-light border-secondary"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#audioFeatures">
                    <i class="bi bi-music-note text-success me-2"></i> Audio Features
                </button>
            </h2>
            <div id="audioFeatures" class="accordion-collapse collapse" data-bs-parent="#featuresAccordion">
                <div class="accordion-body bg-dark">
                    <dl class="row mb-0">
                        @RenderFeature(nameof(MmcFeatures.CanPlayCDAudio))
                        @RenderFeature(nameof(MmcFeatures.CanAudioScan))
                        @RenderFeature(nameof(MmcFeatures.CanMuteSeparateChannels))
                        @RenderFeature(nameof(MmcFeatures.SupportsSeparateVolume))
                        @RenderFeature(nameof(MmcFeatures.VolumeLevels))
                        @RenderFeature(nameof(MmcFeatures.SupportsC2))
                    </dl>
                </div>
            </div>
        </div>

        <!-- Drive Mechanics Section -->
        <div class="accordion-item bg-dark border-secondary">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed bg-dark text-light border-secondary"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#driveMechanics">
                    <i class="bi bi-box text-secondary me-2"></i> Drive Mechanics & Buffer
                </button>
            </h2>
            <div id="driveMechanics" class="accordion-collapse collapse" data-bs-parent="#featuresAccordion">
                <div class="accordion-body bg-dark">
                    <dl class="row mb-0">
                        @RenderFeature(nameof(MmcFeatures.CanLoad))
                        @RenderFeature(nameof(MmcFeatures.CanEject))
                        @RenderFeature(nameof(MmcFeatures.LoadingMechanismType))
                        @RenderFeature(nameof(MmcFeatures.PreventJumper))
                        @RenderFeature(nameof(MmcFeatures.Locked))
                        @RenderFeature(nameof(MmcFeatures.BufferUnderrunFreeInDVD))
                        @RenderFeature(nameof(MmcFeatures.BufferUnderrunFreeInSAO))
                        @RenderFeature(nameof(MmcFeatures.BufferUnderrunFreeInTAO))
                        @RenderFeature(nameof(MmcFeatures.SupportsDeviceBusyEvent))
                        @RenderFeature(nameof(MmcFeatures.ChangerIsSideChangeCapable))
                        @RenderFeature(nameof(MmcFeatures.ChangerSlots))
                        @RenderFeature(nameof(MmcFeatures.ChangerSupportsDiscPresent))
                    </dl>
                </div>
            </div>
        </div>

        <!-- Advanced Features Section -->
        <div class="accordion-item bg-dark border-secondary">
            <h2 class="accordion-header">
                <button class="accordion-button collapsed bg-dark text-light border-secondary"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#advancedFeatures">
                    <i class="bi bi-tools text-primary me-2"></i> Advanced Features
                </button>
            </h2>
            <div id="advancedFeatures" class="accordion-collapse collapse" data-bs-parent="#featuresAccordion">
                <div class="accordion-body bg-dark">
                    <dl class="row mb-0">
                        @RenderFeature(nameof(MmcFeatures.EmbeddedChanger))
                        @RenderFeature(nameof(MmcFeatures.CanReadSpareAreaInformation))
                        @RenderFeature(nameof(MmcFeatures.CanReadDriveAACSCertificate))
                        @RenderFeature(nameof(MmcFeatures.PhysicalInterfaceStandardNumber))
                        @RenderFeature(nameof(MmcFeatures.CanReadLeadInCDText))
                        @RenderFeature(nameof(MmcFeatures.CanReportDriveSerial))
                        @RenderFeature(nameof(MmcFeatures.CanReportMediaSerial))
                        @RenderFeature(nameof(MmcFeatures.CanUpgradeFirmware))
                        @RenderFeature(nameof(MmcFeatures.DBML))
                        @RenderFeature(nameof(MmcFeatures.ErrorRecoveryPage))
                        @RenderFeature(nameof(MmcFeatures.FirmwareDate))
                    </dl>
                </div>
            </div>
        </div>

    </div>
</div>

@code {


    private RenderFragment RenderFeature(string propertyName)
    {
        return __builder =>
        {
            PropertyInfo? property = typeof(MmcFeatures).GetProperty(propertyName);

            if(property == null) return;

            object? value       = property.GetValue(_model);
            string displayName = DisplayNameHelper.GetDisplayName(typeof(MmcFeatures), propertyName);

            <dt class="col-sm-9 text-light">
                @displayName
            </dt>
            <dd class="col-sm-3 text-end">
                @if(value is bool boolValue)
                {
                    if(boolValue)
                    {
                        <i class="bi bi-check-circle-fill text-success" title="Yes"></i>
                        <span class="text-success ms-1">Yes</span>
                    }
                    else
                    {
                        <i class="bi bi-x-circle-fill text-danger" title="No"></i>
                        <span class="text-danger ms-1">No</span>
                    }
                }
                else if(value != null)
                {
                    <span class="badge bg-primary">@value</span>
                }
                else
                {
                    <span class="text-secondary">-</span>
                }
            </dd>
        };
    }


}

