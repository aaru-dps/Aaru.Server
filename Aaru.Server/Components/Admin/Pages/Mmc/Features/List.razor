@page "/admin/mmc/features"
@attribute [Authorize]
@layout AdminLayout
@rendermode InteractiveServer

@inject Microsoft.EntityFrameworkCore.IDbContextFactory<DbContext> DbContextFactory

<PageTitle>MMC Features</PageTitle>

@if(!_initialized)
{
    <div class="d-flex justify-content-center align-items-center" style="min-height: 60vh;">
        <div class="text-center">
            <div class="spinner-border text-info" role="status" style="width: 3rem; height: 3rem;">
                <span class="visually-hidden">Loading...</span>
            </div>
            <h3 class="mt-3 text-light">Loading MMC features...</h3>
        </div>
    </div>

    return;
}

<div class="container-fluid px-4 py-4">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-1 text-light">
                <i class="bi bi-gear-wide-connected text-info"></i> MMC Features
            </h1>
            <p class="text-secondary mb-0">Manage MMC (MultiMedia Commands) drive feature profiles</p>
        </div>
    </div>

    <!-- Search and Filter Bar -->
    <div class="card bg-dark shadow-sm mb-4 border-secondary">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-secondary text-light border-secondary">
                            <i class="bi bi-search"></i>
                        </span>
                        <input type="text"
                               class="form-control bg-dark text-light border-secondary"
                               placeholder="Search by ID..."
                               @bind="_searchTerm"
                               @bind:event="oninput" />
                    </div>
                </div>
                <div class="col-md-6 text-end">
                    <span class="badge bg-info text-dark fs-6 py-2 px-3">
                        <i class="bi bi-database"></i> Total: @FilteredItems.Count() / @_items.Count
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Info Alert -->
    <div class="alert alert-info bg-dark border-info text-light shadow-sm mb-4" role="alert">
        <div class="d-flex align-items-start">
            <i class="bi bi-info-circle-fill text-info fs-4 me-3"></i>
            <div>
                <h6 class="alert-heading mb-2 text-info">Comprehensive Feature Database</h6>
                <p class="mb-0 small">
                    This database contains detailed MMC feature profiles with 100+ capability flags per drive.
                    Click <strong>Details</strong> to view the complete feature set for each entry.
                </p>
            </div>
        </div>
    </div>

    <!-- Data Table -->
    <div class="card bg-dark shadow-sm border-secondary">
        <div class="card-header bg-info text-dark">
            <h5 class="mb-0">
                <i class="bi bi-list-ul"></i> MMC Feature Database
            </h5>
        </div>
        <div class="card-body p-0">
            @if(FilteredItems.Any())
            {
                <div class="table-responsive">
                    <table class="table table-dark table-hover table-striped mb-0">
                        <thead class="table-secondary">
                        <tr>
                            <th style="width: 80px;">
                                <i class="bi bi-hash"></i> ID
                            </th>
                            <th style="width: 80px;" class="text-center" title="Can Read CD">
                                <i class="bi bi-disc"></i> CD
                            </th>
                            <th style="width: 80px;" class="text-center" title="Can Read DVD">
                                <i class="bi bi-disc"></i> DVD
                            </th>
                            <th style="width: 80px;" class="text-center" title="Can Read BD (Blu-ray)">
                                <i class="bi bi-disc"></i> BD
                            </th>
                            <th style="width: 80px;" class="text-center" title="Can Read HD DVD">
                                <i class="bi bi-disc"></i> HD-DVD
                            </th>
                            <th style="width: 80px;" class="text-center" title="Can Read DDCD">
                                <i class="bi bi-disc"></i> DDCD
                            </th>
                            <th style="width: 80px;" class="text-center" title="Can Write CD">
                                <i class="bi bi-pencil"></i> W-CD
                            </th>
                            <th style="width: 80px;" class="text-center" title="Can Write DVD">
                                <i class="bi bi-pencil"></i> W-DVD
                            </th>
                            <th style="width: 80px;" class="text-center" title="Can Write BD">
                                <i class="bi bi-pencil"></i> W-BD
                            </th>
                            <th style="width: 80px;" class="text-center" title="Can Write HD DVD-R">
                                <i class="bi bi-pencil"></i> W-HDDVDR
                            </th>
                            <th style="width: 80px;" class="text-center" title="Can Write DDCD-R">
                                <i class="bi bi-pencil"></i> W-DDCDR
                            </th>
                            <th style="width: 80px;" class="text-center" title="Can Write CD-MRW">
                                <i class="bi bi-pencil"></i> W-MRW
                            </th>
                            <th style="width: 90px;" class="text-center" title="DVD Multi Read">
                                <i class="bi bi-collection"></i> DVD-MR
                            </th>
                            <th style="width: 90px;" class="text-center" title="Multi Read">
                                <i class="bi bi-collection"></i> Multi-R
                            </th>
                            <th style="width: 100px;" class="text-center" title="Supports AACS">
                                <i class="bi bi-shield-lock"></i> AACS
                            </th>
                            <th style="width: 100px;" class="text-center" title="CSS Version">
                                <i class="bi bi-shield-lock"></i> CSS
                            </th>
                            <th style="width: 100px;" class="text-center" title="CPRM Version">
                                <i class="bi bi-shield-lock"></i> CPRM
                            </th>
                            <th style="width: 100px;" class="text-center" title="Supports SecurDisc">
                                <i class="bi bi-shield-check"></i> SecurDisc
                            </th>
                            <th style="width: 100px;" class="text-center" title="Supports OSSC">
                                <i class="bi bi-shield-check"></i> OSSC
                            </th>
                            <th style="width: 100px;" class="text-center" title="Supports VCPS">
                                <i class="bi bi-shield-check"></i> VCPS
                            </th>
                            <th style="width: 150px;" class="text-center">
                                <i class="bi bi-gear"></i> Actions
                            </th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach(MmcFeatures item in FilteredItems)
                        {
                            <tr>
                                <td class="align-middle">
                                    <span class="badge bg-info text-dark text-center"
                                          style="min-width: 60px; display: inline-block;">@item.Id</span>
                                </td>
                                <td class="align-middle text-center">
                                    @if(item.CanReadCD)
                                    {
                                        <i class="bi bi-check-circle-fill text-success" title="Can read CD"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle-fill text-danger" title="Cannot read CD"></i>
                                    }
                                </td>
                                <td class="align-middle text-center">
                                    @if(item.CanReadDVD)
                                    {
                                        <i class="bi bi-check-circle-fill text-success" title="Can read DVD"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle-fill text-danger" title="Cannot read DVD"></i>
                                    }
                                </td>
                                <td class="align-middle text-center">
                                    @if(item.CanReadBD)
                                    {
                                        <i class="bi bi-check-circle-fill text-success" title="Can read Blu-ray"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle-fill text-danger" title="Cannot read Blu-ray"></i>
                                    }
                                </td>
                                <td class="align-middle text-center">
                                    @if(item.CanReadHDDVD)
                                    {
                                        <i class="bi bi-check-circle-fill text-success" title="Can read HD DVD"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle-fill text-danger" title="Cannot read HD DVD"></i>
                                    }
                                </td>
                                <td class="align-middle text-center">
                                    @if(item.CanReadDDCD)
                                    {
                                        <i class="bi bi-check-circle-fill text-success" title="Can read DDCD"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle-fill text-danger" title="Cannot read DDCD"></i>
                                    }
                                </td>
                                <td class="align-middle text-center">
                                    @if(item.CanWriteCDSAO || item.CanWriteCDTAO)
                                    {
                                        <i class="bi bi-check-circle-fill text-success" title="Can write CD"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle-fill text-danger" title="Cannot write CD"></i>
                                    }
                                </td>
                                <td class="align-middle text-center">
                                    @if(item.CanWriteDVDR)
                                    {
                                        <i class="bi bi-check-circle-fill text-success" title="Can write DVD"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle-fill text-danger" title="Cannot write DVD"></i>
                                    }
                                </td>
                                <td class="align-middle text-center">
                                    @if(item.CanWriteBD)
                                    {
                                        <i class="bi bi-check-circle-fill text-success" title="Can write Blu-ray"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle-fill text-danger" title="Cannot write Blu-ray"></i>
                                    }
                                </td>
                                <td class="align-middle text-center">
                                    @if(item.CanWriteHDDVDR)
                                    {
                                        <i class="bi bi-check-circle-fill text-success" title="Can write HD DVD-R"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle-fill text-danger" title="Cannot write HD DVD-R"></i>
                                    }
                                </td>
                                <td class="align-middle text-center">
                                    @if(item.CanWriteDDCDR)
                                    {
                                        <i class="bi bi-check-circle-fill text-success" title="Can write DDCD-R"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle-fill text-danger" title="Cannot write DDCD-R"></i>
                                    }
                                </td>
                                <td class="align-middle text-center">
                                    @if(item.CanWriteCDMRW)
                                    {
                                        <i class="bi bi-check-circle-fill text-success" title="Can write CD-MRW"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle-fill text-danger" title="Cannot write CD-MRW"></i>
                                    }
                                </td>
                                <td class="align-middle text-center">
                                    @if(item.DVDMultiRead)
                                    {
                                        <i class="bi bi-check-circle-fill text-success"
                                           title="DVD Multi Read supported"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle-fill text-danger"
                                           title="DVD Multi Read not supported"></i>
                                    }
                                </td>
                                <td class="align-middle text-center">
                                    @if(item.MultiRead)
                                    {
                                        <i class="bi bi-check-circle-fill text-success"
                                           title="Multi Read supported"></i>
                                    }
                                    else
                                    {
                                        <i class="bi bi-x-circle-fill text-danger" title="Multi Read not supported"></i>
                                    }
                                </td>
                                <td class="align-middle text-center">
                                    @if(item.SupportsAACS)
                                    {
                                        <i class="bi bi-shield-lock-fill text-warning" title="AACS supported"></i>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">-</span>
                                    }
                                </td>
                                <td class="align-middle text-center">
                                    @if(item.CSSVersion is > 0)
                                    {
                                        <span class="badge bg-warning text-dark">v@(item.CSSVersion)</span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">-</span>
                                    }
                                </td>
                                <td class="align-middle text-center">
                                    @if(item.CPRMVersion is > 0)
                                    {
                                        <span class="badge bg-warning text-dark">v@(item.CPRMVersion)</span>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">-</span>
                                    }
                                </td>
                                <td class="align-middle text-center">
                                    @if(item.SupportsSecurDisc)
                                    {
                                        <i class="bi bi-shield-check-fill text-info" title="SecurDisc supported"></i>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">-</span>
                                    }
                                </td>
                                <td class="align-middle text-center">
                                    @if(item.SupportsOSSC)
                                    {
                                        <i class="bi bi-shield-check-fill text-info" title="OSSC supported"></i>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">-</span>
                                    }
                                </td>
                                <td class="align-middle text-center">
                                    @if(item.SupportsVCPS)
                                    {
                                        <i class="bi bi-shield-check-fill text-info" title="VCPS supported"></i>
                                    }
                                    else
                                    {
                                        <span class="text-secondary">-</span>
                                    }
                                </td>
                                <td class="align-middle text-center">
                                    <a href="/admin/mmc/features/@item.Id"
                                       class="btn btn-outline-info btn-sm"
                                       target="_blank"
                                       title="View all features">
                                        <i class="bi bi-eye"></i> Details
                                    </a>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox text-secondary" style="font-size: 4rem;"></i>
                    <h4 class="text-secondary mt-3">No MMC features found</h4>
                    <p class="text-secondary">@(string.IsNullOrWhiteSpace(_searchTerm) ? "No data available" : "Try adjusting your search criteria")</p>
                </div>
            }
        </div>
    </div>
</div>

