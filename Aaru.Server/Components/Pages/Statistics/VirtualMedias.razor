@rendermode InteractiveServer

@inject Microsoft.EntityFrameworkCore.IDbContextFactory<DbContext> DbContextFactory

<!-- Header Section -->
<div class="stats-header">
    <h1 class="stats-title">Virtual Media Statistics</h1>
    <p class="stats-subtitle">Analysis of all virtual media types found in images</p>
</div>

<!-- Charts Section -->
<div class="stats-charts-container">
    <div class="chart-header">
        <h2 class="chart-section-title">Media Type Distribution</h2>
        <p class="chart-section-subtitle">Interactive visualization of virtual media types</p>
    </div>

    <div class="carousel-wrapper">
        <PieChart @ref="_virtualMediaChart" style="padding: 40px" TItem="long" />
    </div>
</div>

<!-- Table Section -->
<div class="stats-table-container">
    <div class="table-header-section">
        <h2 class="table-title">Complete Virtual Media List</h2>
        <p class="table-subtitle">Detailed breakdown of all detected virtual media types</p>
    </div>

    <Grid Data="@VirtualMedia" FixedHeader="true" PageSize="int.MaxValue" TItem="MediaItem" Responsive="true"
          AllowSorting="true" Class="stats-data-grid table table-hover table-dark" style="width: 100%;">
        <GridColumns>
            <GridColumn TItem="MediaItem" HeaderText="Media Type" PropertyName="@nameof(MediaItem.Type)">
                <div class="media-type-cell">@context.Type</div>
            </GridColumn>
            <GridColumn TItem="MediaItem" HeaderText="Subtype" PropertyName="@nameof(MediaItem.SubType)">
                <div class="media-subtype-cell">@context.SubType</div>
            </GridColumn>
            <GridColumn TItem="MediaItem" HeaderText="Occurrences" PropertyName="@nameof(MediaItem.Count)">
                <span class="count-badge">@context.Count</span>
            </GridColumn>
        </GridColumns>
    </Grid>
</div>
