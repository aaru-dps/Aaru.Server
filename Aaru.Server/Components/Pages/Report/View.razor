@page "/Report/{Id:int}"
@rendermode InteractiveServer

@inject Microsoft.EntityFrameworkCore.IDbContextFactory<DbContext> DbContextFactory

<PageTitle>@PageTitle</PageTitle>

@if(_notFound)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <h4 class="alert-heading">Report Not Found</h4>
        <p>The requested device report has not been found.</p>
    </div>

    return;
}
@if(!_initialized)
{
    <div class="alert alert-info alert-dismissible fade show" role="alert">
        <h4 class="alert-heading">Loading Report</h4>
        <p>Please wait while the report is being loaded...</p>
    </div>

    return;
}

<div class="page-header mb-4">
    <h1 class="page-title">@PageTitle</h1>
</div>

<div class="report-section">
    <h2 class="section-subtitle">@DeviceType</h2>
    <Accordion>
        @if(UsbItem is not null)
        {
            <AccordionItem Title="USB characteristics">
                <Content>
                    <table class="table table-sm table-dark table-bordered">
                        <tbody>
                        <tr>
                            <th class="col-4">Manufacturer</th>
                            <td>@UsbItem.Manufacturer</td>
                        </tr>
                        <tr>
                            <th class="col-4">Product</th>
                            <td>@UsbItem.Product</td>
                        </tr>
                        <tr>
                            <th class="col-4">Vendor ID</th>
                            <td>@UsbItem.VendorDescription</td>
                        </tr>
                        <tr>
                            <th class="col-4">Product ID</th>
                            <td>@UsbItem.ProductDescription</td>
                        </tr>
                        </tbody>
                    </table>
                </Content>
            </AccordionItem>
        }
        @if(FireWireItem is not null)
        {
            <AccordionItem Title="FireWire characteristics">
                <Content>
                    <table class="table table-sm table-dark table-bordered">
                        <tbody>
                        <tr>
                            <th class="col-4">Manufacturer</th>
                            <td>@FireWireItem.Manufacturer</td>
                        </tr>
                        <tr>
                            <th class="col-4">Product</th>
                            <td>@FireWireItem.Product</td>
                        </tr>
                        <tr>
                            <th class="col-4">Vendor ID</th>
                            <td>@FireWireItem.VendorDescription</td>
                        </tr>
                        <tr>
                            <th class="col-4">Product ID</th>
                            <td>@FireWireItem.ProductDescription</td>
                        </tr>
                        </tbody>
                    </table>
                </Content>
            </AccordionItem>
        }
        @if(PcmciaItem != null)
        {
            <AccordionItem Title="PCMCIA characteristics">
                <Content>
                    <table class="table table-sm table-dark table-bordered">
                        <tbody>
                        <tr>
                            <th class="col-4">Manufacturer</th>
                            <td>@PcmciaItem.Manufacturer</td>
                        </tr>
                        <tr>
                            <th class="col-4">Product</th>
                            <td>@PcmciaItem.Product</td>
                        </tr>
                        <tr>
                            <th class="col-4">Manufacturer code</th>
                            <td>@PcmciaItem.VendorDescription</td>
                        </tr>
                        <tr>
                            <th class="col-4">Card code</th>
                            <td>@PcmciaItem.ProductDescription</td>
                        </tr>
                        <tr>
                            <th class="col-4">Compliance</th>
                            <td>@PcmciaItem.Compliance</td>
                        </tr>
                        @if(PcmciaTuples != null)
                        {
                            foreach(KeyValuePair<string, string> kvp in PcmciaTuples)
                            {
                                <tr>
                                    <th class="col-4">@kvp.Key</th>
                                    <td>@kvp.Value</td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                </Content>
            </AccordionItem>
        }
        @if(DeviceIdentification != null)
        {
            <AccordionItem Title="Device identification">
                <Content>
                    <table class="table table-sm table-dark table-bordered">
                        <tbody>
                        @foreach(KeyValuePair<string, string> kvp in DeviceIdentification)
                        {
                            <tr>
                                <th class="col-4">@kvp.Key</th>
                                <td>@kvp.Value</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </Content>
            </AccordionItem>
        }
        @if(SupportedAtaVersions != null)
        {
            <AccordionItem Title="Supported ATA versions">
                <Content>
                    <div class="list-group list-group-flush">
                        @foreach(string version in SupportedAtaVersions)
                        {
                            <div class="list-group-item">@version</div>
                        }
                    </div>
                    @if(MaximumAtaRevision is not null)
                    {
                        <div class="mt-3">
                            <small class="text-muted">Maximum ATA revision supported:</small>
                            <strong>@MaximumAtaRevision</strong>
                        </div>
                    }
                </Content>
            </AccordionItem>
        }
        @if(AtaTransport != null)
        {
            <AccordionItem Title="@AtaTransport">
                <Content>
                    @if(AtaTransportVersions is not null)
                    {
                        <div class="list-group list-group-flush">
                            @foreach(string version in AtaTransportVersions)
                            {
                                <div class="list-group-item">@version</div>
                            }
                        </div>
                    }
                </Content>
            </AccordionItem>
        }
        @if(GeneralConfiguration != null)
        {
            <AccordionItem Title="General configuration">
                <Content>
                    <div class="list-group list-group-flush">
                        @foreach(string cfg in GeneralConfiguration)
                        {
                            <div class="list-group-item">@cfg</div>
                        }
                    </div>
                </Content>
            </AccordionItem>
        }
        @if(SpecificConfiguration != null)
        {
            <AccordionItem Title="Specific configuration">
                <Content>
                    <div class="list-group list-group-flush">
                        @foreach(string cfg in SpecificConfiguration)
                        {
                            <div class="list-group-item">@cfg</div>
                        }
                    </div>
                </Content>
            </AccordionItem>
        }
        @if(DeviceCapabilities != null)
        {
            <AccordionItem Title="Device capabilities">
                <Content>
                    <div class="list-group list-group-flush">
                        @foreach(string cap in DeviceCapabilities)
                        {
                            <div class="list-group-item">@cap</div>
                        }
                    </div>
                </Content>
            </AccordionItem>
        }
        @if(PioTransferModes != null)
        {
            <AccordionItem Title="Programmed I/O (PIO) transfer modes">
                <Content>
                    <div class="list-group list-group-flush">
                        @foreach(string cap in PioTransferModes)
                        {
                            <div class="list-group-item">@cap</div>
                        }
                    </div>
                </Content>
            </AccordionItem>
        }
        @if(DmaTransferModes != null)
        {
            <AccordionItem Title="Single-word DMA (DMA) transfer modes">
                <Content>
                    <div class="list-group list-group-flush">
                        @foreach(string cap in DmaTransferModes)
                        {
                            <div class="list-group-item @(cap.Contains("active") ? "active" : "")">@cap</div>
                        }
                    </div>
                </Content>
            </AccordionItem>
        }
        @if(MDmaTransferModes != null)
        {
            <AccordionItem Title="Multi-word DMA (MDMA) transfer modes">
                <Content>
                    <div class="list-group list-group-flush">
                        @foreach(string cap in MDmaTransferModes)
                        {
                            <div class="list-group-item @(cap.Contains("active") ? "active" : "")">@cap</div>
                        }
                    </div>
                </Content>
            </AccordionItem>
        }
        @if(UltraDmaTransferModes != null)
        {
            <AccordionItem Title="Ultra DMA transfer modes">
                <Content>
                    <div class="list-group list-group-flush">
                        @foreach(string cap in UltraDmaTransferModes)
                        {
                            <div class="list-group-item @(cap.Contains("active") ? "active" : "")">@cap</div>
                        }
                    </div>
                </Content>
            </AccordionItem>
        }
        @if(CommandSetAndFeatures != null)
        {
            <AccordionItem Title="Command set and features">
                <Content>
                    <div class="list-group list-group-flush">
                        @foreach(string feature in CommandSetAndFeatures)
                        {
                            <div class="list-group-item">@feature</div>
                        }
                    </div>
                </Content>
            </AccordionItem>
        }
        @if(Security != null)
        {
            <AccordionItem Title="Security">
                <Content>
                    <div class="list-group list-group-flush">
                        @foreach(string feature in Security)
                        {
                            <div class="list-group-item">@feature</div>
                        }
                    </div>
                </Content>
            </AccordionItem>
        }
        @if(Streaming != null)
        {
            <AccordionItem Title="Streaming">
                <Content>
                    <div class="list-group list-group-flush">
                        @foreach(string feature in Streaming)
                        {
                            <div class="list-group-item">@feature</div>
                        }
                    </div>
                </Content>
            </AccordionItem>
        }
        @if(SmartCommandTransport != null)
        {
            <AccordionItem Title="S.M.A.R.T. Command Transport (SCT)">
                <Content>
                    <div class="list-group list-group-flush">
                        @foreach(string feature in SmartCommandTransport)
                        {
                            <div class="list-group-item">@feature</div>
                        }
                    </div>
                </Content>
            </AccordionItem>
        }
        @if(NvCache != null)
        {
            <AccordionItem Title="Non-Volatile Cache">
                <Content>
                    <div class="list-group list-group-flush">
                        @foreach(string feature in NvCache)
                        {
                            <div class="list-group-item">@feature</div>
                        }
                    </div>
                </Content>
            </AccordionItem>
        }
        @if(Cid != null)
        {
            <AccordionItem Title="Card Identification Register">
                <Content>
                    <SpectreMarkup Content="@Cid" />
                </Content>
            </AccordionItem>
        }
        @if(Csd != null)
        {
            <AccordionItem Title="Card Specific Data Register">
                <Content>
                    <SpectreMarkup Content="@Csd" />
                </Content>
            </AccordionItem>
        }
        @if(ExtendedCsd != null)
        {
            <AccordionItem Title="Extended Device Specific Data Register">
                <Content>
                    <SpectreMarkup Content="@ExtendedCsd" />
                </Content>
            </AccordionItem>
        }
        @if(Scr != null)
        {
            <AccordionItem Title="Card configuration register">
                <Content>
                    <SpectreMarkup Content="@Scr" />
                </Content>
            </AccordionItem>
        }
        @if(Ocr != null)
        {
            <AccordionItem Title="Operation Conditions Register">
                <Content>
                    <SpectreMarkup Content="@Ocr" />
                </Content>
            </AccordionItem>
        }

        @if(ReadCapabilitiesDictionary is not null && ReadCapabilitiesList is not null)
        {
            <AccordionItem Title="Read capabilities">
                <Content>
                    <table class="table table-sm table-dark table-bordered mb-3">
                        <tbody>
                        @foreach(KeyValuePair<string, string> kvp in ReadCapabilitiesDictionary)
                        {
                            <tr>
                                <th class="col-4">@kvp.Key</th>
                                <td>@kvp.Value</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    <div class="list-group list-group-flush">
                        @foreach(string cap in ReadCapabilitiesList)
                        {
                            <div class="list-group-item">@cap</div>
                        }
                    </div>
                </Content>
            </AccordionItem>
        }
        @if(DeviceInquiry is not null)
        {
            <AccordionItem Title="Device inquiry">
                <Content>
                    <table class="table table-sm table-dark table-bordered">
                        <tbody>
                        @foreach(KeyValuePair<string, string> kvp in DeviceInquiry)
                        {
                            <tr>
                                <th class="col-4">@kvp.Key</th>
                                <td>@kvp.Value</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                    @if(InquiryCapabilities is not null)
                    {
                        <div class="list-group list-group-flush mt-3">
                            @foreach(string cap in InquiryCapabilities)
                            {
                                <div class="list-group-item">@cap</div>
                            }
                        </div>
                    }
                </Content>
            </AccordionItem>
        }
        @if(ModeSenseCapabilities is not null || ModeSensePages is not null)
        {
            <AccordionItem Title="MODE SENSE pages">
                <Content>
                    @if(ModeSenseCapabilities is not null)
                    {
                        <div class="list-group list-group-flush mb-3">
                            @foreach(string cap in ModeSenseCapabilities)
                            {
                                <div class="list-group-item">@cap</div>
                            }
                        </div>
                    }
                    @if(BlockDescriptors is not null)
                    {
                        <Accordion>
                            <AccordionItem Title="Block descriptors">
                                <Content>
                                    <div class="list-group list-group-flush">
                                        @foreach(string descriptor in BlockDescriptors)
                                        {
                                            <div class="list-group-item">@descriptor</div>
                                        }
                                    </div>
                                </Content>
                            </AccordionItem>
                        </Accordion>
                    }
                    @if(ModeSensePages is not null)
                    {
                        foreach(KeyValuePair<string, List<string>> kvp in ModeSensePages)
                        {
                            <Accordion>
                                <AccordionItem Title=@kvp.Key>
                                    <Content>
                                        @if(kvp.Value.Count > 0)
                                        {
                                            <div class="list-group list-group-flush">
                                                @foreach(string cap in kvp.Value)
                                                {
                                                    <div class="list-group-item">@cap</div>
                                                }
                                            </div>
                                        }
                                    </Content>
                                </AccordionItem>
                            </Accordion>
                        }
                    }
                </Content>
            </AccordionItem>
        }
        @if(EvpdPages?.Count > 0)
        {
            <AccordionItem Title="Extended Vital Product Data pages">
                <Content>
                    @foreach(KeyValuePair<string, List<string>> kvp in EvpdPages)
                    {
                        <Accordion>
                            <AccordionItem Title=@kvp.Key>
                                <Content>
                                    @if(kvp.Value.Count > 0)
                                    {
                                        <div class="list-group list-group-flush">
                                            @foreach(string cap in kvp.Value)
                                            {
                                                <div class="list-group-item">@cap</div>
                                            }
                                        </div>
                                    }
                                </Content>
                            </AccordionItem>
                        </Accordion>
                    }
                </Content>
            </AccordionItem>
        }
        @if(MmcModeList?.Count > 0)
        {
            <AccordionItem Title="CD-ROM capabilities">
                <Content>
                    <div class="list-group list-group-flush">
                        @foreach(string cap in MmcModeList)
                        {
                            <div class="list-group-item">@cap</div>
                        }
                    </div>
                </Content>
            </AccordionItem>
        }
        @if(MmcFeaturesList?.Count > 0)
        {
            <AccordionItem Title="MMC features">
                <Content>
                    <div class="list-group list-group-flush">
                        @foreach(string feature in MmcFeaturesList)
                        {
                            <div class="list-group-item">@feature</div>
                        }
                    </div>
                </Content>
            </AccordionItem>
        }
        @if(ScsiSscVisible)
        {
            <AccordionItem Title="SCSI Streaming device capabilities:">
                <Content>
                    <table class="table table-sm table-dark table-bordered mb-3">
                        <tbody>
                        <tr>
                            <th class="col-4">Block size granularity</th>
                            <td>@ScsiSscGranularity</td>
                        </tr>
                        <tr>
                            <th class="col-4">Maximum block length</th>
                            <td>@ScsiSscMaxBlock bytes</td>
                        </tr>
                        <tr>
                            <th class="col-4">Minimum block length</th>
                            <td>@ScsiSscMinBlock bytes</td>
                        </tr>
                        </tbody>
                    </table>
                    @if(ScsiSscDensities?.Count > 0)
                    {
                        foreach(SupportedDensity density in ScsiSscDensities)
                        {
                            <Accordion>
                                <AccordionItem>
                                    <TitleTemplate>
                                        Information for supported density with primary
                                        code @($"{density.PrimaryCode:X2}h") and secondary
                                        code @($"{density.SecondaryCode:X2}h")
                                    </TitleTemplate>
                                    <Content>
                                        <table class="table table-sm table-dark table-bordered">
                                            <tbody>
                                            <tr>
                                                <th class="col-4">Drive can write this density</th>
                                                <td>@density.Writable</td>
                                            </tr>
                                            <tr>
                                                <th class="col-4">Duplicate density</th>
                                                <td>@density.Duplicate</td>
                                            </tr>
                                            <tr>
                                                <th class="col-4">Default density</th>
                                                <td>@density.DefaultDensity</td>
                                            </tr>
                                            <tr>
                                                <th class="col-4">Name</th>
                                                <td>@density.Name</td>
                                            </tr>
                                            <tr>
                                                <th class="col-4">Organization</th>
                                                <td>@density.Organization</td>
                                            </tr>
                                            <tr>
                                                <th class="col-4">Description</th>
                                                <td>@density.Description</td>
                                            </tr>
                                            <tr>
                                                <th class="col-4">Maximum capacity</th>
                                                <td>@density.Capacity megabytes</td>
                                            </tr>
                                            <tr>
                                                <td colspan="2">Density has @density.BitsPerMm bits per
                                                                mm, with @density.Tracks tracks in a @density.Width mm
                                                                width tape
                                                </td>
                                            </tr>
                                            </tbody>
                                        </table>
                                    </Content>
                                </AccordionItem>
                            </Accordion>
                        }
                    }
                    @if(ScsiSscMedias?.Count > 0)
                    {
                        foreach(SscSupportedMedia media in ScsiSscMedias)
                        {
                            <Accordion>
                                <AccordionItem>
                                    <TitleTemplate>
                                        Information for supported media with type
                                        code @($"{media.MediumType:X2}h")
                                    </TitleTemplate>
                                    <Content>
                                        <table class="table table-sm table-dark table-bordered">
                                            <tbody>
                                            <tr>
                                                <td colspan="2">Media is @media.Length m long in a @media.Width mm width
                                                                tape
                                                </td>
                                            </tr>
                                            <tr>
                                                <th class="col-4">Name</th>
                                                <td>@media.Name</td>
                                            </tr>
                                            <tr>
                                                <th class="col-4">Organization</th>
                                                <td>@media.Organization</td>
                                            </tr>
                                            <tr>
                                                <th class="col-4">Description</th>
                                                <td>@media.Description</td>
                                            </tr>
                                            </tbody>
                                        </table>
                                    </Content>
                                </AccordionItem>
                            </Accordion>
                        }
                    }
                </Content>
            </AccordionItem>
        }
    </Accordion>
</div>

@if(MediaInformation?.Count > 0)
{
    <div class="report-section mt-5">
        <h2 class="section-subtitle">Tested media information</h2>

        <Accordion>
            @foreach((string Header, Dictionary<string, string> Table, List<string> List) mediaInfo in MediaInformation)
            {
                <AccordionItem>
                    <TitleTemplate>
                        @mediaInfo.Header
                    </TitleTemplate>
                    <Content>
                        <table class="table table-sm table-dark table-bordered mb-3">
                            <tbody>
                            @foreach(KeyValuePair<string, string> kvp in mediaInfo.Table)
                            {
                                <tr>
                                    <th class="col-4">@kvp.Key</th>
                                    <td>@kvp.Value</td>
                                </tr>
                            }
                            </tbody>
                        </table>
                        <div class="list-group list-group-flush">
                            @foreach(string cap in mediaInfo.List)
                            {
                                <div class="list-group-item">@cap</div>
                            }
                        </div>
                    </Content>
                </AccordionItem>
            }
        </Accordion>
    </div>
}

<style>
    /* ============================= */
    /* Report View Page Styling */
    /* ============================= */

    .page-header
    {
        padding: 2rem 0 1rem 0;
        border-bottom: 2px solid #e18fdc;
        margin-bottom: 2rem;
    }

    .page-title
    {
        color: #e18fdc;
        font-size: 2.5rem;
        font-weight: 600;
        margin: 0;
    }

    .report-section
    {
        background-color: #1a1a1a;
        border-left: 4px solid #e18fdc;
        padding: 1.5rem;
        margin-bottom: 2rem;
        border-radius: 0.5rem;
    }

    .section-subtitle
    {
        color: #e18fdc;
        font-size: 1.5rem;
        font-weight: 600;
        margin-bottom: 1.5rem;
        margin-top: 0;
    }

    /* Table styling improvements */
    .table
    {
        margin-bottom: 0;
        font-size: 0.95rem;
    }

    .table th
    {
        background-color: #212529;
        color: #e18fdc;
        font-weight: 600;
        border-color: #373b3e;
    }

    .table td
    {
        border-color: #373b3e;
        color: #e0e0e0;
    }

    .table-bordered
    {
        border-color: #373b3e;
    }

    .table-dark
    {
        background-color: transparent;
    }

    /* List group styling */
    .list-group-item
    {
        background-color: #212529;
        color: #e0e0e0;
        border-color: #373b3e;
        padding: 0.75rem 1rem;
    }

    .list-group-item:hover
    {
        background-color: #2a2a2a;
    }

    .list-group-item.active
    {
        background-color: #e18fdc;
        border-color: #e18fdc;
        color: #000;
    }

    .list-group-flush .list-group-item
    {
        border-right: 0;
        border-left: 0;
    }

    .list-group-flush > .list-group-item:first-child
    {
        border-top: 0;
    }

    /* Accordion styling */
    :deep(.accordion)
    {
        margin-bottom: 1.5rem;
    }

    :deep(.accordion-button)
    {
        background-color: #212529;
        color: #e0e0e0;
        font-weight: 500;
        border-color: #373b3e;
        padding: 1rem;
    }

    :deep(.accordion-button:not(.collapsed))
    {
        background-color: #1a1a1a;
        color: #e18fdc;
    }

    :deep(.accordion-button:hover)
    {
        background-color: #2a2a2a;
        color: #e18fdc;
    }

    :deep(.accordion-body)
    {
        background-color: transparent;
        padding: 1.5rem;
        border-color: #373b3e;
    }

    /* Alert styling */
    .alert
    {
        background-color: #1a1a1a;
        border: 1px solid #373b3e;
        color: #e0e0e0;
    }

    .alert-heading
    {
        color: #e18fdc;
        font-weight: 600;
    }

    .alert-info
    {
        border-color: #4a7d9f;
    }

    .alert-danger
    {
        border-color: #9f4a4a;
    }
</style>