@implements IDisposable

@inject NavigationManager   NavigationManager
@inject IWebHostEnvironment HostEnvironment
@inject IConfiguration      Configuration

<div class="navmenu-container">
    <!-- Header Section -->
    <div class="navbar navbar-dark ps-3 top-row">
        <a class="navbar-brand" href="">
            <i class="bi bi-database-fill-nav"></i>Aaru Server
        </a>
    </div>

    <!-- Navigation Menu -->
    <div class="nav-scrollable">
        <nav class="flex-column">
            <!-- Main Navigation Items -->
            <div class="nav-section mb-3">
                <!-- Home -->
                <div class="nav-item px-3">
                    <NavLink class="nav-link d-flex align-items-center" href="" Match="NavLinkMatch.All">
                        <i class="bi bi-house-door-fill-nav"></i>
                        <span>Home</span>
                    </NavLink>
                </div>

                <!-- Statistics -->
                <div class="nav-item px-3">
                    <NavLink class="nav-link d-flex align-items-center" href="Stats">
                        <i class="bi bi-graph-up-nav"></i>
                        <span>Statistics</span>
                    </NavLink>
                </div>
            </div>

            <!-- Dynamic Sidebar Navigation -->
            <div class="nav-section sidebar-nav mb-3">
                @if(!string.IsNullOrEmpty(_sidebarMarkup))
                {
                    <div class="sidebar-header px-3 py-2 text-secondary small">
                        <i class="bi bi-list-nested-nav"></i>Documentation
                    </div>
                    <div class="sidebar-content">
                        @((MarkupString)_sidebarMarkup)
                    </div>
                }
            </div>

            <!-- Protected Navigation Section -->
            <div class="nav-section mb-3">
                <!-- Auth Required -->
                <div class="nav-item px-3">
                    <NavLink class="nav-link d-flex align-items-center" href="auth">
                        <i class="bi bi-lock-nav"></i>
                        <span>Auth Required</span>
                    </NavLink>
                </div>
            </div>

            <!-- User Authorization Section -->
            <AuthorizeView>
                <Authorized>
                    <hr class="nav-divider my-2" />

                    <div class="nav-section mb-3">
                        <!-- Admin Dashboard -->
                        <div class="nav-item px-3">
                            <NavLink class="nav-link d-flex align-items-center" href="admin">
                                <i class="bi bi-shield-lock-nav"></i>
                                <span>Admin</span>
                            </NavLink>
                        </div>

                        <!-- Account Settings -->
                        <div class="nav-item px-3">
                            <NavLink class="nav-link d-flex align-items-center" href="Account/Manage">
                                <i class="bi bi-person-circle-nav"></i>
                                <span>@context.User.Identity?.Name</span>
                            </NavLink>
                        </div>

                        <!-- Logout -->
                        <div class="nav-item px-3">
                            <form action="Account/Logout" method="post" style="margin: 0;">
                                <AntiforgeryToken />
                                <input name="ReturnUrl" type="hidden" value="@_currentUrl" />
                                <button class="nav-link d-flex align-items-center w-100" type="submit">
                                    <i class="bi bi-arrow-bar-left-nav"></i>
                                    <span>Logout</span>
                                </button>
                            </form>
                        </div>
                    </div>
                </Authorized>
                <NotAuthorized>
                    <hr class="nav-divider my-2" />

                    <div class="nav-section mb-3">
                        <!-- Login -->
                        <div class="nav-item px-3">
                            <NavLink class="nav-link d-flex align-items-center" href="Account/Login">
                                <i class="bi bi-person-badge-nav"></i>
                                <span>Login</span>
                            </NavLink>
                        </div>
                    </div>
                </NotAuthorized>
            </AuthorizeView>
        </nav>
    </div>
</div>

