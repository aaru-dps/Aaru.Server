@page "/Account/ForgotPasswordConfirmation"

<PageTitle>Reset Password Confirmation - Aaru Server</PageTitle>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Aaru Server - Reset Password Confirmation</title>
    <link href="_framework/blazor.web.css" rel="stylesheet" />
    <link href="app.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
</head>
<body class="bg-dark">
<div class="min-vh-100 d-flex align-items-center justify-content-center px-4">
    <div style="width: 100%; max-width: 500px;">
        <!-- Status Section -->
        <div class="text-center mb-5">
            <div class="mb-3">
                <i class="bi bi-envelope-open-heart text-info" style="font-size: 5rem;"></i>
            </div>
            <h1 class="h3 text-light mb-2">Email Sent</h1>
            <p class="text-secondary">Password reset link has been sent</p>
        </div>

        <!-- Confirmation Card -->
        <div class="card bg-dark shadow-lg border-info" style="border-width: 2px;">
            <div class="card-header bg-info text-dark">
                <h5 class="mb-0">
                    <i class="bi bi-check-circle"></i> Password Reset Initiated
                </h5>
            </div>
            <div class="card-body p-4">
                <!-- Main Message -->
                <div class="alert alert-info bg-dark border-info text-light mb-4">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    <strong>Check Your Email</strong>
                    <p class="mb-0 mt-2">Please check your email inbox for a password reset link. Follow the
                                         instructions in the email to create a new password.</p>
                </div>

                <!-- Instructions Section -->
                <div class="bg-black p-3 rounded border border-secondary mb-4">
                    <h6 class="text-light mb-3">
                        <i class="bi bi-list-ul"></i> What to Do Next
                    </h6>
                    <ol class="text-secondary small mb-0">
                        <li class="mb-2">
                            Check your email inbox and spam folder
                        </li>
                        <li class="mb-2">
                            Open the email from Aaru Server
                        </li>
                        <li class="mb-2">
                            Click the "Reset Password" link in the email
                        </li>
                        <li>
                            Create a new secure password
                        </li>
                    </ol>
                </div>

                <!-- Important Notice -->
                <div class="bg-dark border border-warning p-3 rounded mb-4">
                    <h6 class="text-warning mb-2">
                        <i class="bi bi-exclamation-triangle"></i> Important
                    </h6>
                    <ul class="text-secondary small mb-0">
                        <li class="mb-1">
                            <i class="bi bi-clock"></i> Reset link expires in 24 hours
                        </li>
                        <li class="mb-1">
                            <i class="bi bi-eye"></i> Never share this link with anyone
                        </li>
                        <li>
                            <i class="bi bi-trash"></i> Delete the email after resetting your password
                        </li>
                    </ul>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex flex-column gap-2">
                    <a href="/Account/Login" class="btn btn-info btn-lg w-100">
                        <i class="bi bi-arrow-left-circle"></i> Back to Login
                    </a>
                    <a href="/" class="btn btn-outline-info btn-lg w-100">
                        <i class="bi bi-house"></i> Go to Home Page
                    </a>
                </div>
            </div>
        </div>

        <!-- Didn't Receive Email Section -->
        <div class="card bg-dark shadow-sm border-secondary mt-4">
            <div class="card-header bg-secondary text-light">
                <h6 class="mb-0">
                    <i class="bi bi-question-circle"></i> Didn't Receive Email?
                </h6>
            </div>
            <div class="card-body p-3">
                <p class="text-secondary small mb-3">If you didn't receive the reset email, try the following:</p>
                <div class="d-flex flex-column gap-2">
                    <button type="button"
                            class="btn btn-outline-warning btn-sm w-100"
                            onclick="window.location.href='/Account/ForgotPassword'">
                        <i class="bi bi-arrow-repeat"></i> Try Again
                    </button>
                    <a href="/Account/ResendEmailConfirmation" class="btn btn-outline-secondary btn-sm w-100">
                        <i class="bi bi-envelope"></i> Resend Email Confirmation
                    </a>
                </div>
            </div>
        </div>

        <!-- Support Section -->
        <div class="text-center mt-5 text-secondary small">
            <p class="mb-2">
                <i class="bi bi-headset"></i> Need Assistance?
            </p>
            <p class="mb-0">
                Contact your system administrator for help with password recovery
            </p>
        </div>

        <!-- Footer -->
        <div class="text-center mt-4 text-secondary small">
            <p class="mb-1">
                <i class="bi bi-shield-lock"></i> Secure Password Recovery
            </p>
            <p class="mb-0">
                © 2011-2026 Natalia Portillo • Aaru Data Preservation Suite
            </p>
        </div>
    </div>
</div>
</body>
</html>

