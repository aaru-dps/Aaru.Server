@page "/Account/RegisterConfirmation"

<PageTitle>Verify Email - Aaru Server</PageTitle>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Aaru Server - Verify Email</title>
    <link href="_framework/blazor.web.css" rel="stylesheet" />
    <link href="app.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
</head>
<body class="bg-dark">
<div class="min-vh-100 d-flex align-items-center justify-content-center px-4">
    <div style="width: 100%; max-width: 500px;">
        <!-- Status Section -->
        <div class="text-center mb-5">
            <div class="mb-3">
                <i class="bi bi-envelope-check text-success" style="font-size: 5rem;"></i>
            </div>
            <h1 class="h3 text-light mb-2">Verify Your Email</h1>
            <p class="text-secondary">Confirmation link has been sent</p>
        </div>

        <!-- Confirmation Card -->
        <div class="card bg-dark shadow-lg border-success" style="border-width: 2px;">
            <div class="card-header bg-success text-dark">
                <h5 class="mb-0">
                    <i class="bi bi-check-circle"></i> Account Created
                </h5>
            </div>
            <div class="card-body p-4">
                <!-- Main Message -->
                <div class="alert alert-success bg-dark border-success text-light mb-4">
                    <i class="bi bi-info-circle-fill me-2"></i>
                    <strong>Check Your Email</strong>
                    <p class="mb-0 mt-2">A confirmation link has been sent to your email address. Please click the link
                                         to verify your email and complete your registration.</p>
                </div>

                <!-- Instructions Section -->
                <div class="bg-black p-3 rounded border border-secondary mb-4">
                    <h6 class="text-light mb-3">
                        <i class="bi bi-list-ul"></i> What to Do Next
                    </h6>
                    <ol class="text-secondary small mb-0">
                        <li class="mb-2">
                            Check your email inbox and spam folder
                        </li>
                        <li class="mb-2">
                            Open the email from Aaru Server
                        </li>
                        <li class="mb-2">
                            Click the "Confirm Email" link in the email
                        </li>
                        <li>
                            You'll be redirected to complete your account setup
                        </li>
                    </ol>
                </div>

                <!-- Important Notice -->
                <div class="bg-dark border border-info p-3 rounded mb-4">
                    <h6 class="text-info mb-2">
                        <i class="bi bi-info-circle"></i> Important
                    </h6>
                    <ul class="text-secondary small mb-0">
                        <li class="mb-1">
                            <i class="bi bi-clock"></i> Verification link expires in 24 hours
                        </li>
                        <li>
                            <i class="bi bi-envelope"></i> Check both inbox and spam folder
                        </li>
                    </ul>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex flex-column gap-2">
                    <a href="/" class="btn btn-success btn-lg w-100">
                        <i class="bi bi-house"></i> Go to Home Page
                    </a>
                    <a href="/Account/ResendEmailConfirmation" class="btn btn-outline-warning btn-lg w-100">
                        <i class="bi bi-arrow-repeat"></i> Resend Confirmation Email
                    </a>
                </div>
            </div>
        </div>

        <!-- Support Section -->
        <div class="card bg-dark shadow-sm border-secondary mt-4">
            <div class="card-header bg-secondary text-light">
                <h6 class="mb-0">
                    <i class="bi bi-question-circle"></i> Didn't Receive Email?
                </h6>
            </div>
            <div class="card-body p-3">
                <p class="text-secondary small mb-2">If you didn't receive the confirmation email:</p>
                <ul class="text-secondary small mb-0">
                    <li class="mb-1">
                        <i class="bi bi-envelope"></i> Check your spam or junk folder
                    </li>
                    <li class="mb-1">
                        <i class="bi bi-arrow-repeat"></i> Request another confirmation email
                    </li>
                    <li>
                        <i class="bi bi-headset"></i> Contact support if problem persists
                    </li>
                </ul>
            </div>
        </div>

        <!-- Footer -->
        <div class="text-center mt-5 text-secondary small">
            <p class="mb-1">
                <i class="bi bi-shield-check"></i> Email Verification Protects Your Account
            </p>
            <p class="mb-0">
                © 2011-2026 Natalia Portillo • Aaru Data Preservation Suite
            </p>
        </div>
    </div>
</div>
</body>
</html>

@code {
    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }
}

