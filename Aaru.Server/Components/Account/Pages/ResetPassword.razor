@page "/Account/ResetPassword"
@using System.ComponentModel.DataAnnotations
@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities

@inject UserManager<IdentityUser> UserManager
@inject IdentityRedirectManager   RedirectManager

<PageTitle>Reset Password - Aaru Server</PageTitle>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Aaru Server - Reset Password</title>
    <link href="_framework/blazor.web.css" rel="stylesheet" />
    <link href="app.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
</head>
<body class="bg-dark">
<div class="min-vh-100 d-flex align-items-center justify-content-center px-4">
    <div style="width: 100%; max-width: 450px;">
        <!-- Logo/Branding Section -->
        <div class="text-center mb-5">
            <h1 class="h3 text-light mb-1">
                <i class="bi bi-key text-warning" style="font-size: 3rem;"></i>
            </h1>
            <h2 class="h4 text-light mb-2">Reset Your Password</h2>
            <p class="text-secondary">Create a new secure password</p>
        </div>

        <!-- Reset Password Card -->
        <div class="card bg-dark shadow-lg border-warning" style="border-width: 2px;">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">
                    <i class="bi bi-lock"></i> New Password
                </h5>
            </div>
            <div class="card-body p-4">
                <!-- Instructions -->
                <div class="alert alert-warning bg-dark border-warning text-light mb-4">
                    <i class="bi bi-info-circle me-2"></i>
                    <strong>Create New Password</strong>
                    <p class="mb-0 mt-2">Enter your email and create a new secure password to regain access to your
                                         account.</p>
                </div>

                <EditForm FormName="reset-password" method="post" Model="Input" OnValidSubmitAsync="OnValidSubmitAsync">
                    <DataAnnotationsValidator />

                    <!-- Email Field -->
                    <div class="mb-3">
                        <label class="form-label text-light">
                            <i class="bi bi-envelope"></i> Email Address
                            <span class="text-danger">*</span>
                        </label>
                        <InputText aria-required="true"
                                   autocomplete="username"
                                   @bind-Value="Input.Email"
                                   class="form-control bg-dark text-light border-secondary"
                                   placeholder="name@example.com" />
                        <ValidationMessage For="() => Input.Email" class="text-danger small mt-1" />
                    </div>

                    <!-- Password Field -->
                    <div class="mb-3">
                        <label class="form-label text-light">
                            <i class="bi bi-lock"></i> New Password
                            <span class="text-danger">*</span>
                        </label>
                        <InputText aria-required="true"
                                   autocomplete="new-password"
                                   @bind-Value="Input.Password"
                                   class="form-control bg-dark text-light border-secondary"
                                   placeholder="Enter a secure password"
                                   type="password" />
                        <ValidationMessage For="() => Input.Password" class="text-danger small mt-1" />
                        <small class="text-secondary">Minimum 6 characters</small>
                    </div>

                    <!-- Confirm Password Field -->
                    <div class="mb-4">
                        <label class="form-label text-light">
                            <i class="bi bi-lock-check"></i> Confirm Password
                            <span class="text-danger">*</span>
                        </label>
                        <InputText aria-required="true"
                                   autocomplete="new-password"
                                   @bind-Value="Input.ConfirmPassword"
                                   class="form-control bg-dark text-light border-secondary"
                                   placeholder="Re-enter your password"
                                   type="password" />
                        <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger small mt-1" />
                    </div>

                    <!-- Validation Summary -->
                    <div class="mb-3">
                        <ValidationSummary class="alert alert-danger bg-dark border-danger text-light" />
                    </div>

                    <!-- Reset Button -->
                    <button class="btn btn-warning btn-lg w-100 mb-3" type="submit">
                        <i class="bi bi-check-circle"></i> Reset Password
                    </button>
                </EditForm>

                <!-- Separator -->
                <hr class="border-secondary my-4" />

                <!-- Help Links -->
                <div class="text-center">
                    <p class="text-secondary mb-2">
                        <a href="/Account/Login" class="link-info">
                            <i class="bi bi-arrow-left-circle"></i> Back to Login
                        </a>
                    </p>
                    <p class="text-secondary mb-0">
                        <a href="/Account/Register" class="link-info">
                            <i class="bi bi-person-plus"></i> Create New Account
                        </a>
                    </p>
                </div>
            </div>
        </div>

        <!-- Password Requirements Card -->
        <div class="card bg-dark shadow-sm border-secondary mt-4">
            <div class="card-header bg-secondary text-light">
                <h6 class="mb-0">
                    <i class="bi bi-info-circle"></i> Password Requirements
                </h6>
            </div>
            <div class="card-body p-3">
                <ul class="text-secondary small mb-0">
                    <li class="mb-1">
                        <i class="bi bi-check"></i> At least 6 characters long
                    </li>
                    <li class="mb-1">
                        <i class="bi bi-shield-lock"></i> Use a mix of characters for security
                    </li>
                    <li>
                        <i class="bi bi-key"></i> Passwords must match
                    </li>
                </ul>
            </div>
        </div>

        <!-- Footer -->
        <div class="text-center mt-5 text-secondary small">
            <p class="mb-1">
                <i class="bi bi-shield-lock"></i> Secure Password Reset
            </p>
            <p class="mb-0">
                © 2011-2026 Natalia Portillo • Aaru Data Preservation Suite
            </p>
        </div>
    </div>
</div>
</body>
</html>

@code {
    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    protected override void OnInitialized()
    {
        if(Code is null)
        {
            RedirectManager.RedirectTo("Account/InvalidPasswordReset");
        }
    }

    public async Task OnValidSubmitAsync()
    {
        IdentityUser? user = await UserManager.FindByEmailAsync(Input.Email);

        if(user is null)
        {
            // Don't reveal if the user exists
            RedirectManager.RedirectTo("Account/ResetPasswordConfirmation");
        }

        string?        code   = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
        IdentityResult result = await UserManager.ResetPasswordAsync(user, code, Input.Password);

        if(result.Succeeded)
        {
            RedirectManager.RedirectTo("Account/ResetPasswordConfirmation");
        }

        foreach(IdentityError error in result.Errors)
        {
            // ... log error ...
        }
    }

    private sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";

        [Required]
        [StringLength(100, ErrorMessage = "The {0} must be at least {2} and at max {1} characters long.", MinimumLength = 6)]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [DataType(DataType.Password)]
        [Compare("Password", ErrorMessage = "The password and confirmation password do not match.")]
        public string ConfirmPassword { get; set; } = "";
    }

}

