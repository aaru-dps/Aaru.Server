@page "/Account/Manage/ChangePassword"
@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity

@inject UserManager<IdentityUser>   UserManager
@inject SignInManager<IdentityUser> SignInManager
@inject IdentityUserAccessor        UserAccessor
@inject IdentityRedirectManager     RedirectManager
@inject ILogger<ChangePassword>     Logger

<PageTitle>Change Password - Aaru Server</PageTitle>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Aaru Server - Change Password</title>
    <link href="_framework/blazor.web.css" rel="stylesheet" />
    <link href="app.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
</head>
<body class="bg-dark">
<div class="min-vh-100 d-flex align-items-center justify-content-center px-4">
    <div style="width: 100%; max-width: 500px;">
        <!-- Header -->
        <div class="text-center mb-5">
            <h1 class="h2 mb-1 text-light">
                <i class="bi bi-lock text-warning"></i> Change Password
            </h1>
            <p class="text-secondary mb-0">Update your account password</p>
        </div>

        <!-- Status Message -->
        @if(!string.IsNullOrEmpty(_message))
        {
            <div class="alert alert-success bg-dark border-success text-light mb-4">
                <i class="bi bi-check-circle-fill me-2"></i>
                <strong>Success</strong>
                <p class="mb-0 mt-1">@_message</p>
            </div>
        }

        <!-- Password Change Card -->
        <div class="card bg-dark shadow-lg border-warning mb-4" style="border-width: 2px;">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">
                    <i class="bi bi-key"></i> New Password
                </h5>
            </div>
            <div class="card-body p-4">
                <!-- Security Warning -->
                <div class="alert alert-info bg-dark border-info text-light mb-4">
                    <i class="bi bi-shield-check me-2"></i>
                    <strong>Password Security</strong>
                    <p class="mb-0 mt-1">Use a unique, strong password that you don't use elsewhere.</p>
                </div>

                <EditForm FormName="change-password" method="post" Model="Input" OnValidSubmit="OnValidSubmitAsync">
                    <DataAnnotationsValidator />

                    <!-- Old Password Field -->
                    <div class="mb-3">
                        <label class="form-label text-light">
                            <i class="bi bi-lock-fill"></i> Current Password
                            <span class="text-danger">*</span>
                        </label>
                        <InputText aria-required="true"
                                   autocomplete="current-password"
                                   @bind-Value="Input.OldPassword"
                                   class="form-control bg-dark text-light border-secondary"
                                   placeholder="Enter your current password"
                                   type="password" />
                        <ValidationMessage For="() => Input.OldPassword" class="text-danger small mt-1" />
                    </div>

                    <!-- New Password Field -->
                    <div class="mb-3">
                        <label class="form-label text-light">
                            <i class="bi bi-lock"></i> New Password
                            <span class="text-danger">*</span>
                        </label>
                        <InputText aria-required="true"
                                   autocomplete="new-password"
                                   @bind-Value="Input.NewPassword"
                                   class="form-control bg-dark text-light border-secondary"
                                   placeholder="Enter your new password"
                                   type="password" />
                        <ValidationMessage For="() => Input.NewPassword" class="text-danger small mt-1" />
                        <small class="text-secondary">Minimum 6 characters</small>
                    </div>

                    <!-- Confirm Password Field -->
                    <div class="mb-4">
                        <label class="form-label text-light">
                            <i class="bi bi-lock-check"></i> Confirm Password
                            <span class="text-danger">*</span>
                        </label>
                        <InputText aria-required="true"
                                   autocomplete="new-password"
                                   @bind-Value="Input.ConfirmPassword"
                                   class="form-control bg-dark text-light border-secondary"
                                   placeholder="Re-enter your new password"
                                   type="password" />
                        <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger small mt-1" />
                    </div>

                    <!-- Validation Summary -->
                    <div class="mb-3">
                        <ValidationSummary class="alert alert-danger bg-dark border-danger text-light" />
                    </div>

                    <!-- Submit Button -->
                    <button class="btn btn-warning btn-lg w-100" type="submit">
                        <i class="bi bi-check-circle"></i> Change Password
                    </button>
                </EditForm>
            </div>
        </div>

        <!-- Password Tips -->
        <div class="card bg-dark shadow-sm border-secondary">
            <div class="card-header bg-secondary text-light">
                <h6 class="mb-0">
                    <i class="bi bi-lightbulb"></i> Strong Password Tips
                </h6>
            </div>
            <div class="card-body p-3">
                <ul class="text-secondary small mb-0">
                    <li class="mb-1">
                        <i class="bi bi-check"></i> Mix uppercase, lowercase, numbers, and symbols
                    </li>
                    <li class="mb-1">
                        <i class="bi bi-check"></i> At least 8 characters long
                    </li>
                    <li class="mb-1">
                        <i class="bi bi-check"></i> Avoid common words or patterns
                    </li>
                    <li>
                        <i class="bi bi-check"></i> Use a unique password for this account
                    </li>
                </ul>
            </div>
        </div>

        <!-- Back Link -->
        <div class="text-center mt-4">
            <a href="/Account/Manage" class="btn btn-secondary btn-sm">
                <i class="bi bi-arrow-left-circle"></i> Back to Settings
            </a>
        </div>

        <!-- Footer -->
        <div class="text-center mt-5 text-secondary small">
            <p class="mb-1">
                <i class="bi bi-shield-lock"></i> Your Password is Secure
            </p>
            <p class="mb-0">
                © 2011-2026 Natalia Portillo • Aaru Data Preservation Suite
            </p>
        </div>
    </div>
</div>
</body>
</html>

@code {
    private string?      _message;
    private IdentityUser _user = default!;
    private bool         _hasPassword;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = new();

    protected override async Task OnInitializedAsync()
    {
        _user        = await UserAccessor.GetRequiredUserAsync(HttpContext);
        _hasPassword = await UserManager.HasPasswordAsync(_user);

        if(!_hasPassword)
        {
            RedirectManager.RedirectTo("Account/Manage/SetPassword");
        }
    }

    private async Task OnValidSubmitAsync()
    {
        IdentityResult changePasswordResult = await UserManager.ChangePasswordAsync(_user, Input.OldPassword, Input.NewPassword);

        if(!changePasswordResult.Succeeded)
        {
            _message = $"Error: {string.Join(",", changePasswordResult.Errors.Select(static error => error.Description))}";

            return;
        }

        await SignInManager.RefreshSignInAsync(_user);

        RedirectManager.RedirectToCurrentPageWithStatus("Your password has been changed", HttpContext);
    }

    private sealed class InputModel
    {
        [Required]
        [DataType(DataType.Password)]
        [Display(Name = "Current password")]
        public string OldPassword { get; set; } = "";

        [Required]
        [StringLength(100, ErrorMessage = "The {0} must be at least {2} and at max {1} characters long.", MinimumLength = 6)]
        [DataType(DataType.Password)]
        [Display(Name = "New password")]
        public string NewPassword { get; set; } = "";

        [DataType(DataType.Password)]
        [Display(Name = "Confirm new password")]
        [Compare("NewPassword", ErrorMessage = "The new password and confirmation password do not match.")]
        public string ConfirmPassword { get; set; } = "";
    }

}

