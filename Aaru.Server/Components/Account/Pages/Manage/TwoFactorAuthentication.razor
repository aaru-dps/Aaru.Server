@page "/Account/Manage/TwoFactorAuthentication"
@using Microsoft.AspNetCore.Http.Features
@using Microsoft.AspNetCore.Identity

@inject UserManager<IdentityUser>   UserManager
@inject SignInManager<IdentityUser> SignInManager
@inject IdentityUserAccessor        UserAccessor
@inject IdentityRedirectManager     RedirectManager

<PageTitle>Two-Factor Authentication - Aaru Server</PageTitle>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Aaru Server - Two-Factor Authentication</title>
    <link href="_framework/blazor.web.css" rel="stylesheet" />
    <link href="app.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
</head>
<body class="bg-dark">
<div class="min-vh-100 d-flex align-items-center justify-content-center px-4">
    <div style="width: 100%; max-width: 550px;">
        <!-- Header -->
        <div class="text-center mb-5">
            <h1 class="h2 mb-1 text-light">
                <i class="bi bi-shield-check text-success"></i> Two-Factor Authentication
            </h1>
            <p class="text-secondary mb-0">Manage your 2FA settings</p>
        </div>

        @if(_canTrack)
        {
            @if(_is2FaEnabled)
            {
        <!-- 2FA Enabled State -->
        <!-- Recovery Codes Status -->

            @if(_recoveryCodesLeft == 0)
            {
                <div class="alert alert-danger bg-dark border-danger text-light mb-4">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>No Recovery Codes Left!</strong>
                    <p class="mb-0 mt-2">You must generate a new set of recovery codes before you can use them for
                                         login.</p>
                </div>
            }
            else if(_recoveryCodesLeft == 1)
            {
                <div class="alert alert-danger bg-dark border-danger text-light mb-4">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>Only 1 Recovery Code Left!</strong>
                    <p class="mb-0 mt-2">Generate a new set of recovery codes soon to avoid being locked out.</p>
                </div>
            }
            else if(_recoveryCodesLeft <= 3)
            {
                <div class="alert alert-warning bg-dark border-warning text-light mb-4">
                    <i class="bi bi-exclamation-circle me-2"></i>
                    <strong>@_recoveryCodesLeft Recovery Codes Remaining</strong>
                    <p class="mb-0 mt-2">Consider generating a new set of recovery codes while you still have some
                                         remaining.</p>
                </div>
            }
            else
            {
                <div class="alert alert-success bg-dark border-success text-light mb-4">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    <strong>2FA Enabled</strong>
                    <p class="mb-0 mt-2">You have @_recoveryCodesLeft recovery codes available.</p>
                </div>
            }

        <!-- 2FA Settings Card -->
            <div class="card bg-dark shadow-lg border-success mb-4" style="border-width: 2px;">
                <div class="card-header bg-success text-dark">
                    <h5 class="mb-0">
                        <i class="bi bi-gear"></i> 2FA Settings
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="row g-3">
                        <div class="col-12">
                            <h6 class="text-light mb-3">
                                <i class="bi bi-info-circle"></i> Active Protection
                            </h6>
                            <p class="text-secondary small mb-3">Your account is protected by two-factor authentication
                                                                 using an authenticator app.</p>
                        </div>

                        @if(_isMachineRemembered)
                        {
                            <div class="col-12">
                                <form @formname="forget-browser" method="post" @onsubmit="OnSubmitForgetBrowserAsync">
                                    <AntiforgeryToken />
                                    <button class="btn btn-outline-warning btn-sm w-100" type="submit">
                                        <i class="bi bi-arrow-counterclockwise"></i> Forget This Browser
                                    </button>
                                </form>
                            </div>
                        }

                        <div class="col-12">
                            <a class="btn btn-outline-info btn-sm w-100" href="Account/Manage/ResetAuthenticator">
                                <i class="bi bi-arrow-repeat"></i> Reset Authenticator App
                            </a>
                        </div>

                        <div class="col-12">
                            <a class="btn btn-outline-secondary btn-sm w-100"
                               href="Account/Manage/GenerateRecoveryCodes">
                                <i class="bi bi-key"></i> Generate New Recovery Codes
                            </a>
                        </div>

                        <div class="col-12">
                            <a class="btn btn-outline-danger btn-sm w-100" href="Account/Manage/Disable2fa">
                                <i class="bi bi-shield-slash"></i> Disable 2FA
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            }
            else
            {
        <!-- 2FA Disabled State -->
            <div class="alert alert-info bg-dark border-info text-light mb-4">
                <i class="bi bi-info-circle me-2"></i>
                <strong>2FA Not Enabled</strong>
                <p class="mb-0 mt-2">Enable two-factor authentication for enhanced account security.</p>
            </div>

            <div class="card bg-dark shadow-lg border-info mb-4" style="border-width: 2px;">
                <div class="card-header bg-info text-dark">
                    <h5 class="mb-0">
                        <i class="bi bi-shield-lock"></i> Enable 2FA
                    </h5>
                </div>
                <div class="card-body p-4">
                    <p class="text-secondary small mb-4">Protect your account with two-factor authentication using an
                                                         authenticator app like Microsoft Authenticator, Google
                                                         Authenticator, or Authy.</p>
                    <a class="btn btn-info btn-lg w-100" href="Account/Manage/EnableAuthenticator">
                        <i class="bi bi-shield-check"></i> Enable Authenticator
                    </a>
                </div>
            </div>
            }

        <!-- Recovery Codes Info -->
            <div class="card bg-dark shadow-sm border-secondary">
                <div class="card-header bg-secondary text-light">
                    <h6 class="mb-0">
                        <i class="bi bi-key"></i> Recovery Codes
                    </h6>
                </div>
                <div class="card-body p-3">
                    <ul class="text-secondary small mb-0">
                        <li class="mb-1">
                            <i class="bi bi-info-circle"></i> Keep recovery codes in a safe place
                        </li>
                        <li class="mb-1">
                            <i class="bi bi-check"></i> Each code can only be used once
                        </li>
                        <li>
                            <i class="bi bi-warning"></i> Use recovery codes if you lose access to your authenticator
                        </li>
                    </ul>
                </div>
            </div>
        }
        else
        {
            <div class="alert alert-warning bg-dark border-warning text-light">
                <i class="bi bi-exclamation-triangle me-2"></i>
                <strong>Tracking Not Available</strong>
                <p class="mb-0 mt-2">Two-factor authentication requires browser tracking to be enabled.</p>
            </div>
        }

        <!-- Back Link -->
        <div class="text-center mt-4">
            <a href="/Account/Manage" class="btn btn-secondary btn-sm">
                <i class="bi bi-arrow-left-circle"></i> Back to Settings
            </a>
        </div>

        <!-- Footer -->
        <div class="text-center mt-5 text-secondary small">
            <p class="mb-1">
                <i class="bi bi-shield-check"></i> 2FA Enhances Security
            </p>
            <p class="mb-0">
                © 2011-2026 Natalia Portillo • Aaru Data Preservation Suite
            </p>
        </div>
    </div>
</div>
</body>
</html>

@code {
    private bool _canTrack;
    private bool _is2FaEnabled;
    private int  _recoveryCodesLeft;
    private bool _isMachineRemembered;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        ITrackingConsentFeature? trackingConsentFeature = HttpContext.Features.Get<ITrackingConsentFeature>();
        _canTrack = trackingConsentFeature?.CanTrack ?? true;

        IdentityUser user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        _is2FaEnabled        = await UserManager.GetTwoFactorEnabledAsync(user);
        _isMachineRemembered = await SignInManager.IsTwoFactorClientRememberedAsync(user);
        _recoveryCodesLeft   = await UserManager.CountRecoveryCodesAsync(user);
    }

    private async Task OnSubmitForgetBrowserAsync()
    {
        await SignInManager.ForgetTwoFactorClientAsync();
        RedirectManager.RedirectToCurrentPageWithStatus("The current browser has been forgotten. When you login again from this browser you will be prompted for your 2fa code.", HttpContext);
    }

}

