@page "/Account/Manage/ResetAuthenticator"
@using Microsoft.AspNetCore.Identity

@inject UserManager<IdentityUser>   UserManager
@inject SignInManager<IdentityUser> SignInManager
@inject IdentityUserAccessor        UserAccessor
@inject IdentityRedirectManager     RedirectManager
@inject ILogger<ResetAuthenticator> Logger

<PageTitle>Reset Authenticator - Aaru Server</PageTitle>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Aaru Server - Reset Authenticator</title>
    <link href="_framework/blazor.web.css" rel="stylesheet" />
    <link href="app.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
</head>
<body class="bg-dark">
<div class="min-vh-100 d-flex align-items-center justify-content-center px-4">
    <div style="width: 100%; max-width: 500px;">
        <!-- Header -->
        <div class="text-center mb-5">
            <h1 class="h2 mb-1 text-light">
                <i class="bi bi-arrow-repeat text-danger"></i> Reset Authenticator
            </h1>
            <p class="text-secondary mb-0">Generate new authenticator keys</p>
        </div>

        <!-- Critical Warning -->
        <div class="alert alert-danger bg-dark border-danger text-light mb-4">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>Critical Action!</strong>
            <p class="mb-0 mt-2">Resetting your authenticator will disable 2FA until you complete the setup with a new
                                 authenticator app.</p>
        </div>

        <!-- Important Information -->
        <div class="card bg-dark shadow-lg border-danger mb-4" style="border-width: 2px;">
            <div class="card-header bg-danger text-light">
                <h5 class="mb-0">
                    <i class="bi bi-info-circle"></i> What Will Happen
                </h5>
            </div>
            <div class="card-body p-4">
                <ul class="text-secondary small mb-4">
                    <li class="mb-2">
                        <i class="bi bi-x"></i> 2FA will be disabled immediately
                    </li>
                    <li class="mb-2">
                        <i class="bi bi-key"></i> New authenticator key will be generated
                    </li>
                    <li class="mb-2">
                        <i class="bi bi-phone"></i> Old authenticator app will stop working
                    </li>
                    <li class="mb-2">
                        <i class="bi bi-warning"></i> You must set up a new authenticator app to restore 2FA
                    </li>
                </ul>

                <div class="bg-black p-3 rounded border border-secondary">
                    <p class="text-secondary small mb-0">
                        <i class="bi bi-exclamation-lg"></i> <strong>Warning:</strong> If you do not complete
                                                                                       authenticator setup, you may lose
                                                                                       access to your account.
                    </p>
                </div>
            </div>
        </div>

        <!-- Confirmation -->
        <div class="card bg-dark shadow-sm border-secondary mb-4">
            <div class="card-body p-4">
                <p class="text-secondary small mb-4">Are you absolutely sure you want to reset your authenticator? This
                                                     cannot be undone.</p>

                <form @formname="reset-authenticator" method="post" @onsubmit="OnSubmitAsync">
                    <AntiforgeryToken />
                    <button class="btn btn-danger btn-lg w-100" type="submit">
                        <i class="bi bi-arrow-repeat"></i> Yes, Reset Authenticator
                    </button>
                </form>
            </div>
        </div>

        <!-- Back Link -->
        <div class="text-center">
            <a href="/Account/Manage/TwoFactorAuthentication" class="btn btn-secondary btn-sm">
                <i class="bi bi-arrow-left-circle"></i> Cancel & Go Back
            </a>
        </div>

        <!-- Footer -->
        <div class="text-center mt-5 text-secondary small">
            <p class="mb-1">
                <i class="bi bi-shield-check"></i> Account Security is Critical
            </p>
            <p class="mb-0">
                © 2011-2026 Natalia Portillo • Aaru Data Preservation Suite
            </p>
        </div>
    </div>
</div>
</body>
</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private async Task OnSubmitAsync()
    {
        IdentityUser user = await UserAccessor.GetRequiredUserAsync(HttpContext);
        await UserManager.SetTwoFactorEnabledAsync(user, false);
        await UserManager.ResetAuthenticatorKeyAsync(user);

        RedirectManager.RedirectToWithStatus("Account/Manage/EnableAuthenticator", "Your authenticator app key has been reset, you will need to configure your authenticator app using the new key.", HttpContext);
    }

}

