@page "/Account/ConfirmEmailChange"
@using System.Text
@using Microsoft.AspNetCore.Identity
@using Microsoft.AspNetCore.WebUtilities

@inject UserManager<IdentityUser>   UserManager
@inject SignInManager<IdentityUser> SignInManager
@inject IdentityRedirectManager     RedirectManager

<PageTitle>Confirm Email Change - Aaru Server</PageTitle>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Aaru Server - Confirm Email Change</title>
    <link href="_framework/blazor.web.css" rel="stylesheet" />
    <link href="app.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
</head>
<body class="bg-dark">
<div class="min-vh-100 d-flex align-items-center justify-content-center px-4">
    <div style="width: 100%; max-width: 500px;">
        <!-- Status Section -->
        @if(message?.Contains("Thank you") ?? false)
        {
        <!-- Success State -->
            <div class="text-center mb-5">
                <div class="mb-3">
                    <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
                </div>
                <h1 class="h3 text-light mb-2">Email Changed</h1>
                <p class="text-secondary">Successfully updated your email address</p>
            </div>

            <div class="card bg-dark shadow-lg border-success" style="border-width: 2px;">
                <div class="card-header bg-success text-dark">
                    <h5 class="mb-0">
                        <i class="bi bi-check-circle"></i> Change Complete
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-success bg-dark border-success text-light mb-4">
                        <i class="bi bi-check-circle-fill me-2"></i>
                        <strong>Success!</strong>
                        <p class="mb-0 mt-2">@message</p>
                    </div>

                    <div class="bg-black p-3 rounded border border-secondary mb-4">
                        <h6 class="text-light mb-3">
                            <i class="bi bi-info-circle"></i> What Changed?
                        </h6>
                        <ul class="text-secondary small mb-0">
                            <li class="mb-2">
                                <i class="bi bi-check"></i> Your email address has been updated
                            </li>
                            <li class="mb-2">
                                <i class="bi bi-check"></i> Your username has been updated
                            </li>
                            <li>
                                <i class="bi bi-arrow-right-circle"></i> You are now signed in
                            </li>
                        </ul>
                    </div>

                    <a href="/admin" class="btn btn-success btn-lg w-100">
                        <i class="bi bi-speedometer2"></i> Go to Dashboard
                    </a>
                </div>
            </div>
        }
        else
        {
        <!-- Error State -->
            <div class="text-center mb-5">
                <div class="mb-3">
                    <i class="bi bi-x-circle-fill text-danger" style="font-size: 5rem;"></i>
                </div>
                <h1 class="h3 text-light mb-2">Change Failed</h1>
                <p class="text-secondary">Unable to change email address</p>
            </div>

            <div class="card bg-dark shadow-lg border-danger" style="border-width: 2px;">
                <div class="card-header bg-danger text-light">
                    <h5 class="mb-0">
                        <i class="bi bi-exclamation-circle"></i> Verification Error
                    </h5>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-danger bg-dark border-danger text-light mb-4">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        <strong>Error</strong>
                        <p class="mb-0 mt-2">@(message ?? "An unexpected error occurred while changing your email.")</p>
                    </div>

                    <div class="bg-black p-3 rounded border border-secondary mb-4">
                        <h6 class="text-light mb-3">
                            <i class="bi bi-lightbulb"></i> Troubleshooting Tips
                        </h6>
                        <ul class="text-secondary small mb-0">
                            <li class="mb-2">
                                <i class="bi bi-link-45deg"></i> Confirmation link may have expired
                            </li>
                            <li class="mb-2">
                                <i class="bi bi-envelope"></i> Try changing your email again
                            </li>
                            <li>
                                <i class="bi bi-headset"></i> Contact support if problem persists
                            </li>
                        </ul>
                    </div>

                    <div class="d-flex flex-column gap-2">
                        <a href="/Account/Manage" class="btn btn-warning btn-lg w-100">
                            <i class="bi bi-gear"></i> Return to Account Settings
                        </a>
                        <a href="/admin" class="btn btn-outline-info btn-lg w-100">
                            <i class="bi bi-arrow-left-circle"></i> Go to Dashboard
                        </a>
                    </div>
                </div>
            </div>
        }

        <!-- Footer -->
        <div class="text-center mt-5 text-secondary small">
            <p class="mb-1">
                <i class="bi bi-shield-check"></i> Email Changes are Secure
            </p>
            <p class="mb-0">
                © 2011-2026 Natalia Portillo • Aaru Data Preservation Suite
            </p>
        </div>
    </div>
</div>
</body>
</html>

@code {
    private string? message;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromQuery]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery]
    private string? Email { get; set; }

    [SupplyParameterFromQuery]
    private string? Code { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if(UserId is null || Email is null || Code is null)
        {
            RedirectManager.RedirectToWithStatus("Account/Login", "Error: Invalid email change confirmation link.", HttpContext);
        }

        IdentityUser? user = await UserManager.FindByIdAsync(UserId);

        if(user is null)
        {
            message = "Unable to find user with Id '{userId}'";

            return;
        }

        string         code   = Encoding.UTF8.GetString(WebEncoders.Base64UrlDecode(Code));
        IdentityResult result = await UserManager.ChangeEmailAsync(user, Email, code);

        if(!result.Succeeded)
        {
            message = "Error changing email.";

            return;
        }

        // In our UI email and user name are one and the same, so when we update the email
        // we need to update the user name.
        IdentityResult setUserNameResult = await UserManager.SetUserNameAsync(user, Email);

        if(!setUserNameResult.Succeeded)
        {
            message = "Error changing user name.";

            return;
        }

        await SignInManager.RefreshSignInAsync(user);
        message = "Thank you for confirming your email change.";
    }

}

