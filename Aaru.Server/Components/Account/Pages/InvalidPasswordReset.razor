@page "/Account/InvalidPasswordReset"

<PageTitle>Invalid Password Reset - Aaru Server</PageTitle>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Aaru Server - Invalid Password Reset</title>
    <link href="_framework/blazor.web.css" rel="stylesheet" />
    <link href="app.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
</head>
<body class="bg-dark">
<div class="min-vh-100 d-flex align-items-center justify-content-center px-4">
    <div style="width: 100%; max-width: 500px;">
        <!-- Error Icon Section -->
        <div class="text-center mb-5">
            <div class="mb-3">
                <i class="bi bi-link-45deg-broken text-danger" style="font-size: 5rem;"></i>
            </div>
            <h1 class="h3 text-light mb-2">Invalid Reset Link</h1>
            <p class="text-secondary">Password reset link is no longer valid</p>
        </div>

        <!-- Error Card -->
        <div class="card bg-dark shadow-lg border-danger" style="border-width: 2px;">
            <div class="card-header bg-danger text-light">
                <h5 class="mb-0">
                    <i class="bi bi-exclamation-circle"></i> Link Expired or Invalid
                </h5>
            </div>
            <div class="card-body p-4">
                <!-- Error Message -->
                <div class="alert alert-danger bg-dark border-danger text-light mb-4">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>Reset Link Invalid</strong>
                    <p class="mb-0 mt-2">The password reset link is invalid, expired, or has already been used. Password
                                         reset links expire after 24 hours for security purposes.</p>
                </div>

                <!-- Reasons Section -->
                <div class="bg-black p-3 rounded border border-secondary mb-4">
                    <h6 class="text-light mb-3">
                        <i class="bi bi-lightbulb"></i> Why Did This Happen?
                    </h6>
                    <ul class="text-secondary small mb-0">
                        <li class="mb-2">
                            <i class="bi bi-clock"></i> The link expired (24 hour validity)
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check-circle"></i> Password was already reset using this link
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-link-45deg"></i> The link was modified or corrupted
                        </li>
                        <li>
                            <i class="bi bi-exclamation-lg"></i> Multiple reset attempts were made
                        </li>
                    </ul>
                </div>

                <!-- What to Do Section -->
                <div class="bg-dark border border-info p-3 rounded mb-4">
                    <h6 class="text-info mb-2">
                        <i class="bi bi-info-circle"></i> What You Can Do
                    </h6>
                    <p class="text-secondary small mb-0">Request a new password reset link. Each link is valid for 24
                                                         hours and can only be used once.</p>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex flex-column gap-2">
                    <a href="/Account/ForgotPassword" class="btn btn-warning btn-lg w-100">
                        <i class="bi bi-arrow-repeat"></i> Request New Reset Link
                    </a>
                    <a href="/Account/Login" class="btn btn-outline-info btn-lg w-100">
                        <i class="bi bi-arrow-left-circle"></i> Back to Login
                    </a>
                </div>
            </div>
        </div>

        <!-- Security Tips Section -->
        <div class="card bg-dark shadow-sm border-secondary mt-4">
            <div class="card-header bg-secondary text-light">
                <h6 class="mb-0">
                    <i class="bi bi-shield-check"></i> Security Reminder
                </h6>
            </div>
            <div class="card-body p-3">
                <ul class="text-secondary small mb-0">
                    <li class="mb-2">
                        <i class="bi bi-clock-history"></i> Reset links expire after 24 hours
                    </li>
                    <li class="mb-2">
                        <i class="bi bi-shield-lock"></i> Never click suspicious reset links
                    </li>
                    <li>
                        <i class="bi bi-key"></i> Create strong passwords for better security
                    </li>
                </ul>
            </div>
        </div>

        <!-- Support Section -->
        <div class="text-center mt-5 text-secondary small">
            <p class="mb-2">
                <i class="bi bi-headset"></i> Need Help?
            </p>
            <p class="mb-0">
                Contact your system administrator if you continue to have trouble
            </p>
        </div>

        <!-- Footer -->
        <div class="text-center mt-4 text-secondary small">
            <p class="mb-1">
                <i class="bi bi-shield-lock"></i> Secure Password Reset System
            </p>
            <p class="mb-0">
                © 2011-2026 Natalia Portillo • Aaru Data Preservation Suite
            </p>
        </div>
    </div>
</div>
</body>
</html>

