@page "/Account/ResetPasswordConfirmation"

<PageTitle>Password Reset Complete - Aaru Server</PageTitle>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Aaru Server - Password Reset Complete</title>
    <link href="_framework/blazor.web.css" rel="stylesheet" />
    <link href="app.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
</head>
<body class="bg-dark">
<div class="min-vh-100 d-flex align-items-center justify-content-center px-4">
    <div style="width: 100%; max-width: 500px;">
        <!-- Success Icon Section -->
        <div class="text-center mb-5">
            <div class="mb-3">
                <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
            </div>
            <h1 class="h3 text-light mb-2">Password Reset Complete</h1>
            <p class="text-secondary">Your password has been successfully reset</p>
        </div>

        <!-- Success Card -->
        <div class="card bg-dark shadow-lg border-success" style="border-width: 2px;">
            <div class="card-header bg-success text-dark">
                <h5 class="mb-0">
                    <i class="bi bi-check-circle"></i> Reset Successful
                </h5>
            </div>
            <div class="card-body p-4">
                <!-- Success Message -->
                <div class="alert alert-success bg-dark border-success text-light mb-4">
                    <i class="bi bi-check-circle-fill me-2"></i>
                    <strong>Password Updated</strong>
                    <p class="mb-0 mt-2">Your password has been successfully reset. You can now sign in with your new
                                         password.</p>
                </div>

                <!-- Next Steps Section -->
                <div class="bg-black p-3 rounded border border-secondary mb-4">
                    <h6 class="text-light mb-3">
                        <i class="bi bi-list-ul"></i> What's Next
                    </h6>
                    <ol class="text-secondary small mb-0">
                        <li class="mb-2">
                            Sign in with your new password
                        </li>
                        <li class="mb-2">
                            Consider enabling two-factor authentication
                        </li>
                        <li>
                            Review your account security settings
                        </li>
                    </ol>
                </div>

                <!-- Security Reminder -->
                <div class="bg-dark border border-info p-3 rounded mb-4">
                    <h6 class="text-info mb-2">
                        <i class="bi bi-shield-check"></i> Security Reminder
                    </h6>
                    <ul class="text-secondary small mb-0">
                        <li class="mb-1">
                            <i class="bi bi-key"></i> Never share your password with anyone
                        </li>
                        <li>
                            <i class="bi bi-lock"></i> Use a unique password for this account
                        </li>
                    </ul>
                </div>

                <!-- Action Button -->
                <a href="/Account/Login" class="btn btn-success btn-lg w-100">
                    <i class="bi bi-arrow-right-circle"></i> Sign In to Your Account
                </a>
            </div>
        </div>

        <!-- Additional Security Section -->
        <div class="card bg-dark shadow-sm border-secondary mt-4">
            <div class="card-header bg-secondary text-light">
                <h6 class="mb-0">
                    <i class="bi bi-shield-lock"></i> Enhance Your Security
                </h6>
            </div>
            <div class="card-body p-3">
                <p class="text-secondary small mb-2">Protect your account further by enabling:</p>
                <ul class="text-secondary small mb-0">
                    <li class="mb-1">
                        <i class="bi bi-phone"></i> Two-Factor Authentication
                    </li>
                    <li class="mb-1">
                        <i class="bi bi-shield-check"></i> Account recovery options
                    </li>
                    <li>
                        <i class="bi bi-clock-history"></i> Login activity monitoring
                    </li>
                </ul>
            </div>
        </div>

        <!-- Footer -->
        <div class="text-center mt-5 text-secondary small">
            <p class="mb-1">
                <i class="bi bi-shield-lock"></i> Account Security is Important
            </p>
            <p class="mb-0">
                © 2011-2026 Natalia Portillo • Aaru Data Preservation Suite
            </p>
        </div>
    </div>
</div>
</body>
</html>

