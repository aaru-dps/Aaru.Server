@page "/Account/Lockout"

<PageTitle>Account Locked - Aaru Server</PageTitle>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Aaru Server - Account Locked</title>
    <link href="_framework/blazor.web.css" rel="stylesheet" />
    <link href="app.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" rel="stylesheet" />
</head>
<body class="bg-dark">
<div class="min-vh-100 d-flex align-items-center justify-content-center px-4">
    <div style="width: 100%; max-width: 500px;">
        <!-- Error Icon Section -->
        <div class="text-center mb-5">
            <div class="mb-3">
                <i class="bi bi-lock-fill text-danger" style="font-size: 5rem;"></i>
            </div>
            <h1 class="h3 text-light mb-2">Account Locked</h1>
            <p class="text-secondary">Your account has been temporarily locked</p>
        </div>

        <!-- Lockout Card -->
        <div class="card bg-dark shadow-lg border-danger" style="border-width: 2px;">
            <div class="card-header bg-danger text-light">
                <h5 class="mb-0">
                    <i class="bi bi-exclamation-triangle-circle"></i> Security Lockout
                </h5>
            </div>
            <div class="card-body p-4">
                <!-- Main Message -->
                <div class="alert alert-danger bg-dark border-danger text-light mb-4">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    <strong>Account Temporarily Locked</strong>
                    <p class="mb-0 mt-2">Your account has been locked due to multiple failed login attempts. This is a
                                         security measure to protect your account.</p>
                </div>

                <!-- Reason Section -->
                <div class="bg-black p-3 rounded border border-secondary mb-4">
                    <h6 class="text-light mb-3">
                        <i class="bi bi-info-circle"></i> Why Did This Happen?
                    </h6>
                    <p class="text-secondary small mb-0">
                        Your account was locked after several failed login attempts. This protects your account from
                        unauthorized access and is a standard security practice.
                    </p>
                </div>

                <!-- What to Do Section -->
                <div class="bg-dark border border-warning p-3 rounded mb-4">
                    <h6 class="text-warning mb-2">
                        <i class="bi bi-clock"></i> What to Do
                    </h6>
                    <p class="text-secondary small mb-0">
                        Your account will be automatically unlocked after a brief period of time. Please try again later
                        or contact your system administrator for immediate assistance.
                    </p>
                </div>

                <!-- Tips Section -->
                <div class="bg-dark border border-info p-3 rounded mb-4">
                    <h6 class="text-info mb-3">
                        <i class="bi bi-lightbulb"></i> Tips to Remember
                    </h6>
                    <ul class="text-secondary small mb-0">
                        <li class="mb-2">
                            <i class="bi bi-key"></i> Make sure you're entering your password correctly
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-caps-lock"></i> Check if Caps Lock is turned on
                        </li>
                        <li>
                            <i class="bi bi-question-circle"></i> Use password reset if you forgot your password
                        </li>
                    </ul>
                </div>

                <!-- Action Buttons -->
                <div class="d-flex flex-column gap-2">
                    <a href="/Account/Login" class="btn btn-info btn-lg w-100">
                        <i class="bi bi-arrow-counterclockwise"></i> Try Login Again
                    </a>
                    <a href="/Account/ForgotPassword" class="btn btn-outline-warning btn-lg w-100">
                        <i class="bi bi-question-circle"></i> Reset Password
                    </a>
                </div>
            </div>
        </div>

        <!-- Support Section -->
        <div class="card bg-dark shadow-sm border-secondary mt-4">
            <div class="card-header bg-secondary text-light">
                <h6 class="mb-0">
                    <i class="bi bi-headset"></i> Still Having Issues?
                </h6>
            </div>
            <div class="card-body p-3">
                <p class="text-secondary small mb-2">If your account remains locked after waiting, please contact your
                                                     system administrator:</p>
                <ul class="text-secondary small mb-0">
                    <li class="mb-1">
                        <i class="bi bi-envelope"></i> Send an email to your IT support team
                    </li>
                    <li class="mb-1">
                        <i class="bi bi-telephone"></i> Call your help desk
                    </li>
                    <li>
                        <i class="bi bi-chat-left-text"></i> Use your organization's support chat
                    </li>
                </ul>
            </div>
        </div>

        <!-- Security Information -->
        <div class="text-center mt-5 text-secondary small">
            <p class="mb-1">
                <i class="bi bi-shield-check"></i> Account Lockout is a Security Feature
            </p>
            <p class="mb-0">
                © 2011-2026 Natalia Portillo • Aaru Data Preservation Suite
            </p>
        </div>
    </div>
</div>
</body>
</html>

